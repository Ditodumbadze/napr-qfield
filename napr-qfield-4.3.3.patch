+
+                    RowLayout {
+                      id: statusRow
+                      anchors.fill: parent
+                      anchors.margins: 8
+                      spacing: 8
+
+                      IconImage {
+                        source: QfTheme.getThemeVectorIcon(model.statusOk ? "ic_check_white_24dp" : "ic_close_white_24dp")
+                        sourceSize: Qt.size(18, 18)
+                        color: model.statusOk ? QfTheme.goodColor : QfTheme.errorColor
+                      }
+
+                      Label {
+                        Layout.fillWidth: true
+                        text: model.statusText
+                        font: QfTheme.strongFont
+                        color: model.statusOk ? QfTheme.mainTextColor : QfTheme.errorColor
+                        wrapMode: Text.WordWrap
+                      }
+                    }
+                  }
+
+                  // free text
+                  TextField {
+                    id: valueField
+                    Layout.fillWidth: true
+                    visible: defaultCard.options.length === 0
+                    text: defaultCard.currentValue
+                    placeholderText: text === "" ? qsTr("არ არის მითითებული") : ""
+                    font: QfTheme.defaultFont
+                    color: QfTheme.mainTextColor
+                    placeholderTextColor: QfTheme.secondaryTextColor
+                    inputMethodHints: Qt.ImhNoPredictiveText
+                    onEditingFinished: {
+                      if (text.trim() !== defaultCard.currentValue)
+                        defaultsModel.setValue(defaultCard.row, text);
+                    }
+                  }
+                }
+              }
+            }
+
+            Label {
+              anchors.centerIn: parent
