+                width: segContent.implicitWidth + 24
+                height: 32
+                radius: 16
+                color: active ? root.accentColor : "transparent"
+
+                Row {
+                  id: segContent
+                  anchors.centerIn: parent
+                  spacing: 6
+
+                  IconImage {
+                    anchors.verticalCenter: parent.verticalCenter
+                    source: QfTheme.getThemeVectorIcon(modelData.icon)
+                    sourceSize: Qt.size(18, 18)
+                    color: active ? "white" : QfTheme.mainTextColor
+                  }
+
+                  Label {
+                    anchors.verticalCenter: parent.verticalCenter
+                    text: modelData.label
+                    font: QfTheme.tipFont
+                    color: active ? "white" : QfTheme.mainTextColor
+                  }
+                }
