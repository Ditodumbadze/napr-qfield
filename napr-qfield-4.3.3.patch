+            color: settingsBtnArea.pressed ? Qt.rgba( 0, 0, 0, 0.28 ) : Qt.rgba( 0, 0, 0, 0.15 )
+            Layout.alignment: Qt.AlignVCenter
+            Label {
+              anchors.centerIn: parent
