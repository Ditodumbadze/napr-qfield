+    border.width: 2
+    border.color: checkState > 0 ? QfTheme.mainColor : QfTheme.secondaryTextColor
+
+    IconImage {
+      anchors.centerIn: parent
+      visible: parent.checkState === 2
+      source: QfTheme.getThemeVectorIcon("ic_check_white_24dp")
+      sourceSize: Qt.size(18, 18)
+      color: "white"
+    }
+    Rectangle {
+      anchors.centerIn: parent
+      visible: parent.checkState === 1
+      width: 10
+      height: 2.5
+      radius: 1
+      color: "white"
+    }
+  }
+
+  // Dim the map slightly and close when tapping outside the panel
+  Rectangle {
+    anchors.fill: parent
+    color: "#33000000"
+    MouseArea {
+      anchors.fill: parent
+      onClicked: root.isOpen = false
+    }
+  }
+
+  Rectangle {
+    id: panel
+    width: root.panelWidth
+    height: parent.height
+    anchors.right: parent.right
+    color: QfTheme.mainBackgroundColor
+
+    MouseArea {
+      anchors.fill: parent
+      onClicked: {}
+    }
+
+    ColumnLayout {
+      anchors.fill: parent
+      anchors.topMargin: mainWindow.sceneTopMargin
+      anchors.bottomMargin: mainWindow.sceneBottomMargin
+      spacing: 0
+
+      // ---- Header ----
+      RowLayout {
+        Layout.fillWidth: true
+        Layout.preferredHeight: 56
+        Layout.leftMargin: 16
+        Layout.rightMargin: 6
+        spacing: 8
+
+        IconImage {
+          source: QfTheme.getThemeVectorIcon("ic_napr_villages_white_24dp")
+          sourceSize: Qt.size(24, 24)
+          color: QfTheme.mainColor
+        }
+
+        Label {
+          text: qsTr("სოფლები")
+          font: QfTheme.strongTitleFont
+          color: QfTheme.mainTextColor
+          elide: Text.ElideRight
+          Layout.fillWidth: true
+        }
+
+        QfToolButton {
+          width: 40
+          height: 40
+          round: true
+          bgcolor: "transparent"
+          iconSource: QfTheme.getThemeVectorIcon("ic_close_white_24dp")
+          iconColor: QfTheme.mainTextColor
+          onClicked: root.isOpen = false
+        }
+      }
+
+      // ---- Search ----
+      Rectangle {
+        Layout.fillWidth: true
+        Layout.leftMargin: 12
+        Layout.rightMargin: 12
+        Layout.preferredHeight: 44
+        radius: 22
+        color: QfTheme.groupBoxBackgroundColor
+
+        RowLayout {
+          anchors.fill: parent
+          anchors.leftMargin: 14
+          anchors.rightMargin: 4
+          spacing: 6
+
+          IconImage {
+            source: QfTheme.getThemeVectorIcon("ic_baseline_search_white")
+            sourceSize: Qt.size(20, 20)
+            color: QfTheme.secondaryTextColor
+          }
+
+          TextField {
+            id: searchField
+            Layout.fillWidth: true
+            placeholderText: qsTr("მუნიციპალიტეტი ან სოფელი")
