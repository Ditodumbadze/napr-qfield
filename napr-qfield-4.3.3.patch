+void VillageSelectorModel::loadSelection()
+{
+  QSettings settings;
+  const QStringList saved = settings.value( SETTINGS_KEY ).toStringList();
+  for ( const QString &c : saved )
+    mSelected.insert( c );
+}
+
+void VillageSelectorModel::saveSelection() const
+{
+  QSettings settings;
+  settings.setValue( SETTINGS_KEY, sortedSelection() );
+}
