+
+            delegate: Rectangle {
+              width: errorList.width
+              height: 46
+              color: delegateArea.pressed ? "#FFF3E0" : "white"
+
+              RowLayout {
+                anchors.fill: parent
+                anchors.leftMargin: 28
+                anchors.rightMargin: 10
+                spacing: 8
+
+                Label {
