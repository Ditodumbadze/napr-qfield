+            color: QfTheme.mainTextColor
+            placeholderTextColor: QfTheme.secondaryTextColor
+            background: Item {}
+            topPadding: 0
+            bottomPadding: 0
+            leftPadding: 0
+            verticalAlignment: TextInput.AlignVCenter
+            inputMethodHints: Qt.ImhNoPredictiveText
+            onTextChanged: searchTimer.restart()
+          }
+
+          QfToolButton {
+            visible: searchField.text !== ""
+            width: 36
+            height: 36
+            round: true
+            bgcolor: "transparent"
+            iconSource: QfTheme.getThemeVectorIcon("ic_clear_white_24dp")
+            iconColor: QfTheme.secondaryTextColor
+            onClicked: searchField.text = ""
+          }
+        }
+
+        Timer {
+          id: searchTimer
+          interval: 250
+          onTriggered: villageModel.searchText = searchField.text
+        }
+      }
+
+      // ---- Selection summary ----
+      RowLayout {
+        Layout.fillWidth: true
+        Layout.leftMargin: 16
+        Layout.rightMargin: 8
+        Layout.topMargin: 6
+        Layout.preferredHeight: 36
+        spacing: 8
+
+        Label {
+          Layout.fillWidth: true
+          text: villageModel.selectedCount > 0 ? qsTr("არჩეულია: %1").arg(villageModel.selectedCount) : qsTr("%1 მუნიციპალიტეტი · %2 სოფელი").arg(villageList.municipalityCount).arg(villageModel.villageCount)
+          font: villageModel.selectedCount > 0 ? QfTheme.strongTipFont : QfTheme.tipFont
+          color: villageModel.selectedCount > 0 ? QfTheme.mainColor : QfTheme.secondaryTextColor
+          elide: Text.ElideRight
+        }
+
+        QfButton {
+          visible: villageModel.selectedCount > 0
+          text: qsTr("გასუფთავება")
+          bgcolor: "transparent"
+          borderColor: "transparent"
+          color: QfTheme.secondaryTextColor
+          onClicked: villageModel.clearSelection()
+        }
+      }
+
+      Rectangle {
+        Layout.fillWidth: true
+        height: 1
+        color: QfTheme.controlBorderColor
+      }
+
+      // ---- Municipality / village list ----
+      ListView {
+        id: villageList
+        Layout.fillWidth: true
+        Layout.fillHeight: true
+        clip: true
+        model: villageModel
+        reuseItems: true
+        ScrollBar.vertical: QfScrollBar {}
+
+        readonly property int municipalityCount: 75
+
+        delegate: Rectangle {
+          id: rowItem
+          width: villageList.width
+          height: model.rowType === VillageSelectorModel.MunicipalityRow ? 54 : 46
+          color: rowArea.pressed ? root.tint(QfTheme.mainColor, 0.10) : model.rowType === VillageSelectorModel.MunicipalityRow && model.expanded ? QfTheme.groupBoxBackgroundColor : "transparent"
+
+          readonly property bool isHeader: model.rowType === VillageSelectorModel.MunicipalityRow
+
+          MouseArea {
+            id: rowArea
+            anchors.fill: parent
+            onClicked: {
+              if (rowItem.isHeader)
+                villageModel.toggleExpanded(index);
+              else
+                villageModel.toggleChecked(index);
+            }
+          }
+
+          RowLayout {
+            anchors.fill: parent
+            anchors.leftMargin: rowItem.isHeader ? 10 : 48
+            anchors.rightMargin: 12
+            spacing: 10
+
+            // Municipality: chevron
+            IconImage {
+              visible: rowItem.isHeader
+              source: QfTheme.getThemeVectorIcon("ic_chevron_right_white_24dp")
+              sourceSize: Qt.size(22, 22)
+              color: QfTheme.secondaryTextColor
+              rotation: model.expanded ? 90 : 0
