+            }
+
+            // Village: checkbox on the left
+            CheckMark {
+              visible: !rowItem.isHeader
+              checkState: model.checkState
+            }
+
+            Label {
+              Layout.fillWidth: true
+              text: model.name
+              font: rowItem.isHeader ? QfTheme.strongFont : QfTheme.defaultFont
+              color: QfTheme.mainTextColor
+              elide: Text.ElideRight
+            }
+
+            // Municipality: selected / total badge
