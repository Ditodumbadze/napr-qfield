+                height: 32
+                radius: 16
+                color: active ? root.accentColor : "transparent"
+
+                Row {
+                  id: segContent
+                  anchors.centerIn: parent
+                  spacing: 6
+
+                  IconImage {
+                    anchors.verticalCenter: parent.verticalCenter
