+
+static const QString SETTINGS_KEY = QStringLiteral( "georgiaqfield/villages/selected" );
+static const QString OFFLINE_ACTIVE_KEY = QStringLiteral( "georgiaqfield/offline/active" );
+static const QString OFFLINE_FILE_KEY = QStringLiteral( "georgiaqfield/offline/file" );
+static const QString OFFLINE_LAYERS_KEY = QStringLiteral( "georgiaqfield/offline/layers" );
+static const QString OFFLINE_DATE_KEY = QStringLiteral( "georgiaqfield/offline/date" );
+static const QString OFFLINE_VILLAGES_KEY = QStringLiteral( "georgiaqfield/offline/villages" );
+
+namespace
+{
+  bool usesZoneVariables( const QString &source )
+  {
+    return source.contains( QLatin1String( "@myzone" ), Qt::CaseInsensitive ) || source.contains( QLatin1String( "@orzone" ), Qt::CaseInsensitive );
+  }
+
+  //! Identifies a WFS layer independently of its filter.
+  QString wfsKey( const QString &source )
+  {
+    const QgsDataSourceUri uri( source );
+    return uri.param( QStringLiteral( "url" ) ) + QLatin1Char( '|' ) + uri.param( QStringLiteral( "typename" ) );
+  }
+
+  //! wfsKey → original source (with the @myzone / @orzone filter), filled while projects are read.
+  QHash<QString, QString> &originalSourcesByKey()
+  {
+    static QHash<QString, QString> sOriginals;
+    return sOriginals;
+  }
+
+  bool sPreprocessedOnRead = false;
+
+  /**
+   * LR_PARCELS is the only NAPR WFS layer that does not say whether to restrict
+   * requests to the view. In QField (QGIS 4 WFS provider) it then accumulates
+   * duplicate features after each search/zoom, while the layers on the same
+   * server that request by view extent do not. Requesting by view extent, like
+   * the other layers, avoids the duplicates and the slow full download. Layers
+   * that set the option explicitly are left alone.
+   */
+  void restrictToViewIfUnset( QgsDataSourceUri &uri )
+  {
+    if ( !uri.hasParam( QStringLiteral( "restrictToRequestBBOX" ) ) )
+      uri.setParam( QStringLiteral( "restrictToRequestBBOX" ), QStringLiteral( "1" ) );
+  }
+} // namespace
+
+VillageSelectorModel::VillageSelectorModel( QObject *parent )
+  : QAbstractListModel( parent )
+{
+  loadData();
+  loadSelection();
+  mRows = buildRows();
+
+  // A different project may reuse layer ids; forget the stored original sources.
+  connect( QgsProject::instance(), &QgsProject::cleared, this, [this] { mOriginalSources.clear(); } );
+
+  // Rewrite the @myzone / @orzone WFS filters while the project is being READ,
+  // before any layer talks to the server. Otherwise the provider sends the raw
+  // var() / regexp_replace() functions to the server, which rejects them (and
+  // QField logs "Retrying request ..." errors) until the selection is applied.
+  static bool sPreprocessorRegistered = false;
+  if ( !sPreprocessorRegistered )
+  {
+    sPreprocessorRegistered = true;
+    QgsPathResolver::setPathPreprocessor( []( const QString &source ) -> QString {
+      if ( !usesZoneVariables( source ) || !source.contains( QLatin1String( "typename=" ), Qt::CaseInsensitive ) )
+        return source;
+
+      QSettings settings;
+      QStringList codes = settings.value( SETTINGS_KEY ).toStringList();
+      codes.sort();
+      // Offline copy in use: the layer is switched to it right after the project
+      // is read, so don't ask the (unreachable) server for real data meanwhile.
+      if ( settings.value( OFFLINE_ACTIVE_KEY, false ).toBool() )
+        codes.clear();
+      if ( codes.isEmpty() )
+        codes << QStringLiteral( "00.00" ); // nothing selected yet: a filter that matches nothing
+
+      originalSourcesByKey().insert( wfsKey( source ), source );
+      sPreprocessedOnRead = true;
+
+      QgsDataSourceUri uri( source );
+      const QString filter = buildFilter( uri.param( QStringLiteral( "filter" ) ), codes );
+      uri.removeParam( QStringLiteral( "filter" ) );
+      uri.setParam( QStringLiteral( "filter" ), filter );
+      restrictToViewIfUnset( uri );
+      return uri.uri( false );
+    } );
+  }
+}
+
+void VillageSelectorModel::loadData()
+{
+  QFile file( QStringLiteral( ":/napr/villages.json" ) );
+  if ( !file.open( QIODevice::ReadOnly ) )
+    return;
+
+  const QJsonDocument doc = QJsonDocument::fromJson( file.readAll() );
+  const QJsonArray municipalities = doc.array();
+  for ( const QJsonValue &mv : municipalities )
+  {
+    const QJsonObject mo = mv.toObject();
+    Municipality m;
+    m.zone = mo.value( QStringLiteral( "z" ) ).toString();
+    m.name = mo.value( QStringLiteral( "n" ) ).toString();
+    const QJsonArray villages = mo.value( QStringLiteral( "v" ) ).toArray();
+    for ( const QJsonValue &vv : villages )
+    {
+      const QJsonObject vo = vv.toObject();
+      m.villages.append( { vo.value( QStringLiteral( "s" ) ).toString(), vo.value( QStringLiteral( "n" ) ).toString() } );
+    }
+    mVillageCount += static_cast<int>( m.villages.size() );
+    mMunicipalities.append( m );
+  }
+}
+
+void VillageSelectorModel::loadSelection()
+{
+  QSettings settings;
+  const QStringList saved = settings.value( SETTINGS_KEY ).toStringList();
+  for ( const QString &c : saved )
+    mSelected.insert( c );
+}
+
+void VillageSelectorModel::saveSelection() const
+{
+  QSettings settings;
+  settings.setValue( SETTINGS_KEY, sortedSelection() );
+}
+
+QStringList VillageSelectorModel::sortedSelection() const
+{
+  QStringList list( mSelected.begin(), mSelected.end() );
+  list.sort();
+  return list;
+}
+
+QString VillageSelectorModel::code( const QString &zone, const QString &sector )
+{
+  return QStringLiteral( "%1.%2" ).arg( zone, sector );
+}
+
+bool VillageSelectorModel::villageMatches( const Municipality &m, const Village &v ) const
+{
+  if ( mSearchText.isEmpty() )
+    return true;
+  return v.name.contains( mSearchText, Qt::CaseInsensitive )
+         || m.name.contains( mSearchText, Qt::CaseInsensitive )
+         || code( m.zone, v.sector ).startsWith( mSearchText );
+}
+
+bool VillageSelectorModel::municipalityVisible( int m ) const
+{
+  if ( mSearchText.isEmpty() )
+    return true;
+  const Municipality &mu = mMunicipalities.at( m );
+  for ( const Village &v : mu.villages )
+  {
+    if ( villageMatches( mu, v ) )
+      return true;
+  }
+  return false;
+}
+
+QVector<VillageSelectorModel::Row> VillageSelectorModel::buildRows() const
+{
+  QVector<Row> rows;
+  const bool searching = !mSearchText.isEmpty();
+  for ( int m = 0; m < mMunicipalities.size(); ++m )
+  {
+    if ( !municipalityVisible( m ) )
+      continue;
+    rows.append( { MunicipalityRow, m, -1 } );
+    const Municipality &mu = mMunicipalities.at( m );
+    if ( !searching && !mExpanded.contains( mu.zone ) )
+      continue;
+    for ( int v = 0; v < mu.villages.size(); ++v )
+    {
+      if ( villageMatches( mu, mu.villages.at( v ) ) )
+        rows.append( { VillageRow, m, v } );
+    }
+  }
+  return rows;
+}
+
+void VillageSelectorModel::rebuild()
+{
+  beginResetModel();
+  mRows = buildRows();
+  endResetModel();
+}
+
+int VillageSelectorModel::municipalitySelectedCount( int m ) const
+{
+  int count = 0;
+  const Municipality &mu = mMunicipalities.at( m );
+  for ( const Village &v : mu.villages )
+  {
+    if ( mSelected.contains( code( mu.zone, v.sector ) ) )
+      ++count;
+  }
+  return count;
+}
+
+int VillageSelectorModel::rowCount( const QModelIndex &parent ) const
+{
+  return parent.isValid() ? 0 : static_cast<int>( mRows.size() );
+}
+
+QVariant VillageSelectorModel::data( const QModelIndex &index, int role ) const
+{
+  if ( !index.isValid() || index.row() < 0 || index.row() >= mRows.size() )
+    return QVariant();
+
+  const Row &row = mRows.at( index.row() );
+  const Municipality &mu = mMunicipalities.at( row.municipality );
+
+  if ( row.type == MunicipalityRow )
+  {
+    switch ( role )
+    {
+      case RowTypeRole:
+        return MunicipalityRow;
+      case NameRole:
+      case Qt::DisplayRole:
+        return mu.name;
+      case CodeRole:
+      case ZoneIdRole:
+        return mu.zone;
+      case ExpandedRole:
+        return !mSearchText.isEmpty() || mExpanded.contains( mu.zone );
+      case TotalCountRole:
+        return static_cast<int>( mu.villages.size() );
+      case SelectedCountRole:
+        return municipalitySelectedCount( row.municipality );
+      case CheckStateRole:
+      {
+        const int selected = municipalitySelectedCount( row.municipality );
+        return selected == 0 ? 0 : selected == mu.villages.size() ? 2 : 1;
+      }
+    }
+    return QVariant();
+  }
+
+  const Village &v = mu.villages.at( row.village );
+  switch ( role )
+  {
+    case RowTypeRole:
+      return VillageRow;
+    case NameRole:
+    case Qt::DisplayRole:
+      return v.name;
+    case CodeRole:
+      return code( mu.zone, v.sector );
+    case ZoneIdRole:
+      return mu.zone;
+    case CheckStateRole:
+      return mSelected.contains( code( mu.zone, v.sector ) ) ? 2 : 0;
+    case ExpandedRole:
+      return false;
+    case TotalCountRole:
+    case SelectedCountRole:
+      return 0;
+  }
+  return QVariant();
+}
+
+QHash<int, QByteArray> VillageSelectorModel::roleNames() const
+{
+  QHash<int, QByteArray> roles;
+  roles[RowTypeRole] = "rowType";
+  roles[NameRole] = "name";
+  roles[CodeRole] = "code";
+  roles[ZoneIdRole] = "zoneId";
+  roles[CheckStateRole] = "checkState";
+  roles[ExpandedRole] = "expanded";
+  roles[TotalCountRole] = "totalCount";
+  roles[SelectedCountRole] = "selectedCount";
+  return roles;
+}
+
+void VillageSelectorModel::setSearchText( const QString &text )
+{
+  const QString t = text.trimmed();
+  if ( t == mSearchText )
+    return;
+  mSearchText = t;
+  rebuild();
+  emit searchTextChanged();
+}
+
+QString VillageSelectorModel::selectedSummary() const
+{
+  QStringList names;
+  for ( const Municipality &mu : mMunicipalities )
+  {
+    for ( const Village &v : mu.villages )
+    {
+      if ( mSelected.contains( code( mu.zone, v.sector ) ) )
+        names << v.name;
+    }
+  }
+  return names.join( QStringLiteral( ", " ) );
+}
+
+void VillageSelectorModel::toggleExpanded( int row )
+{
+  if ( row < 0 || row >= mRows.size() || mRows.at( row ).type != MunicipalityRow || !mSearchText.isEmpty() )
+    return;
+
+  const Municipality &mu = mMunicipalities.at( mRows.at( row ).municipality );
+  const int n = static_cast<int>( mu.villages.size() );
+  if ( n == 0 )
+    return;
+
+  if ( mExpanded.contains( mu.zone ) )
+  {
+    beginRemoveRows( QModelIndex(), row + 1, row + n );
+    mExpanded.remove( mu.zone );
+    mRows = buildRows();
+    endRemoveRows();
+  }
+  else
+  {
+    beginInsertRows( QModelIndex(), row + 1, row + n );
+    mExpanded.insert( mu.zone );
+    mRows = buildRows();
+    endInsertRows();
+  }
+  const QModelIndex idx = index( row );
+  emit dataChanged( idx, idx, { ExpandedRole } );
+}
+
+void VillageSelectorModel::collapseAll()
+{
+  if ( mExpanded.isEmpty() )
+    return;
+  mExpanded.clear();
+  rebuild();
+}
+
+void VillageSelectorModel::toggleChecked( int row )
+{
+  if ( row < 0 || row >= mRows.size() )
+    return;
+
+  const Row &r = mRows.at( row );
+  const Municipality &mu = mMunicipalities.at( r.municipality );
+  if ( r.type == VillageRow )
+  {
+    const QString c = code( mu.zone, mu.villages.at( r.village ).sector );
+    if ( mSelected.contains( c ) )
+      mSelected.remove( c );
+    else
+      mSelected.insert( c );
+  }
+  else
+  {
+    const bool allSelected = municipalitySelectedCount( r.municipality ) == mu.villages.size();
+    for ( const Village &v : mu.villages )
+    {
+      if ( allSelected )
+        mSelected.remove( code( mu.zone, v.sector ) );
+      else
+        mSelected.insert( code( mu.zone, v.sector ) );
+    }
+  }
+
+  notifyMunicipality( r.municipality );
+  saveSelection();
+  emit selectionChanged();
+}
+
+void VillageSelectorModel::notifyMunicipality( int m )
+{
+  int first = -1;
+  int last = -1;
+  for ( int i = 0; i < mRows.size(); ++i )
+  {
+    if ( mRows.at( i ).municipality == m )
+    {
+      if ( first < 0 )
+        first = i;
+      last = i;
+    }
+  }
+  if ( first >= 0 )
+    emit dataChanged( index( first ), index( last ), { CheckStateRole, SelectedCountRole } );
+}
+
+void VillageSelectorModel::clearSelection()
+{
+  if ( mSelected.isEmpty() )
+    return;
+  mSelected.clear();
+  if ( !mRows.isEmpty() )
+    emit dataChanged( index( 0 ), index( static_cast<int>( mRows.size() ) - 1 ), { CheckStateRole, SelectedCountRole } );
+  saveSelection();
+  emit selectionChanged();
+}
+
+int VillageSelectorModel::targetLayerCount()
+{
+  int count = 0;
+  const QMap<QString, QgsMapLayer *> layers = QgsProject::instance()->mapLayers();
+  for ( QgsMapLayer *layer : layers )
+  {
+    if ( !qobject_cast<QgsVectorLayer *>( layer ) )
+      continue;
+    if ( layer->providerType().compare( QLatin1String( "WFS" ), Qt::CaseInsensitive ) != 0 )
+    {
+      if ( mOriginalSources.contains( layer->id() ) ) // currently switched to the offline copy
+        ++count;
+      continue;
+    }
+    const QString source = layer->source();
+    if ( mOriginalSources.contains( layer->id() ) || usesZoneVariables( source ) || originalSourcesByKey().contains( wfsKey( source ) ) )
+      ++count;
+  }
+  return count;
+}
+
+QString VillageSelectorModel::buildFilter( const QString &originalFilter, const QStringList &codes )
+{
+  // The NAPR project uses three kinds of @myzone / @orzone filters. Each one is
+  // rebuilt as a plain OR list (one term per village) so the server receives a
+  // simple OGC filter, whatever the number of selected villages.
+  enum class Kind
+  {
+    InventoryCodes, // "USAIDCODE" LIKE '<8812%>' / "PNEWCODE" LIKE '8812%'
+    CadastralCode,  // "CADCODE" LIKE '88.12%'
+    ZoneSector,     // "ZONE" = '88' AND "SECTOR" = '12'
+    Generic,        // anything else: substitute the variables with a literal
+  };
+
+  Kind kind = Kind::Generic;
+  if ( originalFilter.contains( QLatin1String( "USAIDCODE" ), Qt::CaseInsensitive ) || originalFilter.contains( QLatin1String( "PNEWCODE" ), Qt::CaseInsensitive ) )
+    kind = Kind::InventoryCodes;
+  else if ( originalFilter.contains( QLatin1String( "CADCODE" ), Qt::CaseInsensitive ) )
+    kind = Kind::CadastralCode;
+  else if ( originalFilter.contains( QLatin1String( "\"ZONE\"" ), Qt::CaseInsensitive ) && originalFilter.contains( QLatin1String( "\"SECTOR\"" ), Qt::CaseInsensitive ) )
+    kind = Kind::ZoneSector;
+
+  QStringList parts;
+  for ( const QString &c : codes )
+  {
+    const QString zone = c.section( QLatin1Char( '.' ), 0, 0 );
+    const QString sector = c.section( QLatin1Char( '.' ), 1, 1 );
+    switch ( kind )
+    {
+      case Kind::InventoryCodes:
+        // USAIDCODE is matched with the angle brackets kept ('<8812%>'), exactly as the
+        // original replace(@myzone, '.', '') produced; PNEWCODE without them.
+        parts << QStringLiteral( "( \"USAIDCODE\" LIKE '<%1%2%>' OR \"PNEWCODE\" LIKE '%1%2%' )" ).arg( zone, sector );
+        break;
+      case Kind::CadastralCode:
+        parts << QStringLiteral( "\"CADCODE\" LIKE '%1.%2%'" ).arg( zone, sector );
+        break;
+      case Kind::ZoneSector:
+        parts << QStringLiteral( "( \"ZONE\" = '%1' AND \"SECTOR\" = '%2' )" ).arg( zone, sector );
+        break;
+      case Kind::Generic:
+      {
+        QString expr = originalFilter;
+        const QString literal = QStringLiteral( "'<%1%>'" ).arg( c );
+        expr.replace( QLatin1String( "@myzone" ), literal, Qt::CaseInsensitive );
+        expr.replace( QLatin1String( "@orzone" ), literal, Qt::CaseInsensitive );
+        parts << QStringLiteral( "( %1 )" ).arg( expr );
+        break;
+      }
+    }
+  }
+  return parts.join( QStringLiteral( " OR " ) );
+}
+
+QString VillageSelectorModel::apply()
+{
+  const QStringList codes = sortedSelection();
+  if ( codes.isEmpty() )
+    return tr( "აირჩიეთ მინიმუმ ერთი სოფელი" );
+
+  // Keep the legacy project variables meaningful for anything else that reads them.
+  QgsProject *project = QgsProject::instance();
+  QgsExpressionContextUtils::setProjectVariable( project, QStringLiteral( "myzone" ), QStringLiteral( "<%1%>" ).arg( codes.at( 0 ) ) );
+  QgsExpressionContextUtils::setProjectVariable( project, QStringLiteral( "orzone" ), QStringLiteral( "<%1%>" ).arg( codes.size() > 1 ? codes.at( 1 ) : codes.at( 0 ) ) );
+  QgsExpressionContextUtils::setProjectVariable( project, QStringLiteral( "villages" ), codes.join( QLatin1Char( ',' ) ) );
+
+  int updated = 0;
+  const QMap<QString, QgsMapLayer *> layers = project->mapLayers();
+  for ( QgsMapLayer *layer : layers )
+  {
+    QgsVectorLayer *vl = qobject_cast<QgsVectorLayer *>( layer );
+    if ( !vl )
+      continue;
+
+    const QString original = originalSourceFor( vl );
+    if ( original.isEmpty() )
+      continue;
+
+    QgsDataSourceUri uri( original );
+    const QString filter = buildFilter( uri.param( QStringLiteral( "filter" ) ), codes );
+    uri.removeParam( QStringLiteral( "filter" ) );
+    uri.setParam( QStringLiteral( "filter" ), filter );
+    restrictToViewIfUnset( uri );
+
+    QgsDataProvider::ProviderOptions options;
+    options.transformContext = project->transformContext();
+    vl->setDataSource( uri.uri( false ), vl->name(), QStringLiteral( "WFS" ), options, false );
+    vl->setReadOnly( false );
+    vl->triggerRepaint();
+    ++updated;
+  }
+
+  saveSelection();
+  if ( offlineActive() )
+    clearOfflineState(); // back on the live server
+
+  if ( updated == 0 )
+    return tr( "პროექტში ვერ მოიძებნა ფენა, რომელიც @myzone / @orzone ფილტრს იყენებს" );
+  return QString();
+}
+
+bool VillageSelectorModel::applySaved()
+{
+  const bool preprocessed = sPreprocessedOnRead;
+  sPreprocessedOnRead = false;
+
+  if ( offlineActive() && switchToOffline() )
+    return true;
+
+  if ( mSelected.isEmpty() || targetLayerCount() == 0 )
+    return false;
+
+  if ( preprocessed )
+  {
+    // The filters were already rewritten while reading the project; only keep
+    // the legacy variables in sync, no need to reload the layers again.
+    const QStringList codes = sortedSelection();
+    QgsProject *project = QgsProject::instance();
+    QgsExpressionContextUtils::setProjectVariable( project, QStringLiteral( "myzone" ), QStringLiteral( "<%1%>" ).arg( codes.at( 0 ) ) );
+    QgsExpressionContextUtils::setProjectVariable( project, QStringLiteral( "orzone" ), QStringLiteral( "<%1%>" ).arg( codes.size() > 1 ? codes.at( 1 ) : codes.at( 0 ) ) );
+    QgsExpressionContextUtils::setProjectVariable( project, QStringLiteral( "villages" ), codes.join( QLatin1Char( ',' ) ) );
+    return true;
+  }
+
+  return apply().isEmpty();
+}
+
+// ---------------------------------------------------------------------------
+//  Offline copy
+// ---------------------------------------------------------------------------
+
+QString VillageSelectorModel::originalSourceFor( QgsVectorLayer *layer )
+{
+  QString original = mOriginalSources.value( layer->id() );
+  if ( !original.isEmpty() )
+    return original;
+
+  if ( layer->providerType().compare( QLatin1String( "WFS" ), Qt::CaseInsensitive ) != 0 )
+    return QString();
+
+  const QString source = layer->source();
+  if ( usesZoneVariables( source ) )
+    original = source;
+  else
+    original = originalSourcesByKey().value( wfsKey( source ) );
+  if ( !original.isEmpty() )
+    mOriginalSources.insert( layer->id(), original );
+  return original;
+}
+
+bool VillageSelectorModel::offlineActive() const
+{
+  return QSettings().value( OFFLINE_ACTIVE_KEY, false ).toBool();
+}
+
+QString VillageSelectorModel::offlineInfo() const
+{
+  QSettings settings;
+  if ( !settings.value( OFFLINE_ACTIVE_KEY, false ).toBool() )
+    return QString();
+  const QDateTime date = settings.value( OFFLINE_DATE_KEY ).toDateTime();
+  const int villages = static_cast<int>( settings.value( OFFLINE_VILLAGES_KEY ).toStringList().size() );
+  return tr( "შენახულია %1 · %2 სოფელი" ).arg( date.toString( QStringLiteral( "dd.MM.yyyy HH:mm" ) ) ).arg( villages );
+}
