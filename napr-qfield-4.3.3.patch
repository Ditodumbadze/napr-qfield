+
+                    Repeater {
+                      model: defaultCard.options
+                      delegate: Rectangle {
+                        readonly property bool selected: modelData.value === "" ? !defaultCard.currentValue : defaultCard.currentValue === modelData.value
+                        width: Math.min(chipLabel.implicitWidth + 24, defaultColumn.width)
+                        height: chipLabel.implicitHeight + 14
+                        radius: 10
+                        color: selected ? QfTheme.mainColor : QfTheme.mainBackgroundColor
+                        border.width: 1
+                        border.color: selected ? QfTheme.mainColor : QfTheme.controlBorderColor
+
+                        Label {
