+            Layout.fillHeight: true
+          }
+        }
+      }
+
+      // =================================================================
+      //  SETTINGS VIEW (rule editor)
+      // =================================================================
+      ColumnLayout {
+        Layout.fillWidth: true
+        Layout.fillHeight: true
+        visible: root.showSettings
+        spacing: 0
+
+        ListView {
+          id: rulesList
+          Layout.fillWidth: true
+          Layout.fillHeight: true
+          clip: true
+          model: topologyModel.rules
+          ScrollBar.vertical: QfScrollBar {}
+
+          header: Label {
+            width: rulesList.width
+            leftPadding: 16
+            topPadding: 12
+            bottomPadding: 6
+            text: qsTr("აქტიური წესები")
+            font: QfTheme.strongTipFont
+            color: QfTheme.secondaryTextColor
+          }
+
+          delegate: Rectangle {
+            width: rulesList.width
+            height: 60
+            color: "transparent"
+
+            RowLayout {
+              anchors.fill: parent
+              anchors.leftMargin: 4
+              anchors.rightMargin: 6
+              spacing: 4
+
+              QfSwitch {
+                checked: model.ruleEnabled
+                Layout.preferredWidth: 60
+                onToggled: topologyModel.rules.setRuleEnabled(index, checked)
+              }
+
+              ColumnLayout {
+                Layout.fillWidth: true
+                spacing: 2
+
+                Label {
+                  text: model.ruleTypeName
+                  font: QfTheme.defaultFont
+                  color: model.ruleEnabled ? QfTheme.mainTextColor : QfTheme.mainTextDisabledColor
+                  Layout.fillWidth: true
+                  elide: Text.ElideRight
+                }
+                Label {
+                  text: model.needsLayer2 ? (model.layer1 + "  →  " + model.layer2) : model.layer1
+                  font: QfTheme.tinyFont
+                  color: QfTheme.secondaryTextColor
+                  Layout.fillWidth: true
+                  elide: Text.ElideRight
+                }
+              }
+
+              QfToolButton {
+                width: 40
+                height: 40
+                round: true
+                bgcolor: "transparent"
+                iconSource: QfTheme.getThemeVectorIcon("ic_delete_forever_white_24dp")
+                iconColor: QfTheme.errorColor
+                onClicked: topologyModel.rules.removeRule(index)
+              }
+            }
+
+            Rectangle {
+              width: parent.width - 16
+              height: 1
+              color: QfTheme.controlBorderColor
+              anchors.bottom: parent.bottom
+              anchors.horizontalCenter: parent.horizontalCenter
+            }
+          }
+
+          Label {
+            anchors.centerIn: parent
+            visible: topologyModel.rules.count === 0
+            text: qsTr("წესები არ არის.\nდაამატეთ ქვემოთ.")
+            horizontalAlignment: Text.AlignHCenter
+            font: QfTheme.tipFont
+            color: QfTheme.secondaryTextColor
+          }
+        }
+
+        Rectangle {
+          Layout.fillWidth: true
+          height: 1
+          color: QfTheme.controlBorderColor
+        }
+
+        // Add-rule editor
+        ColumnLayout {
+          Layout.fillWidth: true
+          Layout.margins: 12
+          spacing: 6
+
+          Label {
+            text: qsTr("ახალი წესი")
+            font: QfTheme.strongTipFont
+            color: QfTheme.secondaryTextColor
+          }
+
+          QfComboBox {
+            id: ruleTypeCombo
+            Layout.fillWidth: true
+            font: QfTheme.defaultFont
+            model: topologyModel.rules.ruleTypeNames()
+            currentIndex: 5 // "must not overlap"
+          }
+
+          QfComboBox {
+            id: layer1Combo
+            Layout.fillWidth: true
+            font: QfTheme.defaultFont
+            model: root.layerNames
+            displayText: currentIndex < 0 ? qsTr("ფენა #1") : currentText
+          }
+
+          QfComboBox {
+            id: layer2Combo
+            Layout.fillWidth: true
+            font: QfTheme.defaultFont
+            model: root.layerNames
+            displayText: currentIndex < 0 ? qsTr("ფენა #2") : currentText
+            enabled: topologyModel.rules.ruleTypeNeedsLayer2(ruleTypeCombo.currentIndex)
+            opacity: enabled ? 1.0 : 0.4
+          }
+
+          RowLayout {
+            Layout.fillWidth: true
+            spacing: 4
+
+            QfButton {
+              Layout.fillWidth: true
+              text: qsTr("დამატება")
+              icon.source: QfTheme.getThemeVectorIcon("ic_add_white_24dp")
+              bgcolor: QfTheme.mainColor
+              color: "white"
+              onClicked: {
+                if (layer1Combo.currentIndex < 0)
+                  return;
+                var needs2 = topologyModel.rules.ruleTypeNeedsLayer2(ruleTypeCombo.currentIndex);
+                if (needs2 && layer2Combo.currentIndex < 0)
+                  return;
+                topologyModel.rules.addRule(ruleTypeCombo.currentIndex, layer1Combo.currentText, needs2 ? layer2Combo.currentText : "");
+              }
+            }
+
+            QfButton {
+              text: qsTr("ნაგულისხმევი")
+              bgcolor: "transparent"
+              color: QfTheme.mainColor
+              onClicked: topologyModel.rules.resetToDefaults()
+            }
+          }
+        }
+      }
+    }
+  }
+}
diff --git a/src/gui/qml/VillageSelectorDialog.qml b/src/gui/qml/VillageSelectorDialog.qml
