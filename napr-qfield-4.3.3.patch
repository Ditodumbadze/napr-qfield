+void VillageSelectorModel::loadData()
+{
+  QFile file( QStringLiteral( ":/napr/villages.json" ) );
+  if ( !file.open( QIODevice::ReadOnly ) )
+    return;
+
+  const QJsonDocument doc = QJsonDocument::fromJson( file.readAll() );
+  const QJsonArray municipalities = doc.array();
+  for ( const QJsonValue &mv : municipalities )
+  {
+    const QJsonObject mo = mv.toObject();
+    Municipality m;
+    m.zone = mo.value( QStringLiteral( "z" ) ).toString();
+    m.name = mo.value( QStringLiteral( "n" ) ).toString();
+    const QJsonArray villages = mo.value( QStringLiteral( "v" ) ).toArray();
+    for ( const QJsonValue &vv : villages )
+    {
+      const QJsonObject vo = vv.toObject();
+      m.villages.append( { vo.value( QStringLiteral( "s" ) ).toString(), vo.value( QStringLiteral( "n" ) ).toString() } );
+    }
+    mVillageCount += static_cast<int>( m.villages.size() );
+    mMunicipalities.append( m );
+  }
+}
