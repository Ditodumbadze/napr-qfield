+
+      // ---- Actions ----
+      QfButton {
+        Layout.fillWidth: true
+        Layout.leftMargin: 12
+        Layout.rightMargin: 12
+        Layout.topMargin: 10
+        text: villageModel.selectedCount > 0 ? qsTr("ჩატვირთვა (%1)").arg(villageModel.selectedCount) : qsTr("ჩატვირთვა")
+        icon.source: QfTheme.getThemeVectorIcon("ic_download_white_24dp")
+        bgcolor: QfTheme.mainColor
+        color: "white"
+        enabled: villageModel.selectedCount > 0 && !villageModel.busy
+        onClicked: {
+          var err = villageModel.apply();
+          if (err === "") {
+            root.toast(qsTr("ჩაიტვირთა %1 სოფელი").arg(villageModel.selectedCount));
+            root.isOpen = false;
+          } else {
+            root.toast(err);
+          }
+        }
+      }
+
+      RowLayout {
+        Layout.fillWidth: true
+        Layout.leftMargin: 12
+        Layout.rightMargin: 12
+        Layout.bottomMargin: 12
+        spacing: 8
+
+        // Save the loaded villages for use without internet
+        QfButton {
+          Layout.fillWidth: true
+          visible: !villageModel.offlineActive
+          text: qsTr("ოფლაინ შენახვა")
+          icon.source: QfTheme.getThemeVectorIcon("ic_cloud_download_24dp")
+          bgcolor: "transparent"
+          color: QfTheme.mainColor
+          enabled: villageModel.selectedCount > 0 && !villageModel.busy
+          onClicked: {
