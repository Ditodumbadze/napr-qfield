+    defaultsModel.reload();
+    if (!defaultsModel.surveyorAuthorized)
+      root.toast(qsTr("ამზომველის პ/ნ-ს არ აქვს წვდომა პროგრამაზე — სერვერის ფენები არ ჩაიტვირთება"));
+  }
+
+  function tint(c, a) {
+    return Qt.rgba(c.r, c.g, c.b, a);
+  }
+
+  function toColor(value) {
+    return Qt.lighter(value, 1.0);
+  }
+
+  function sameColor(a, b) {
