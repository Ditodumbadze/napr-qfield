+              horizontalAlignment: Text.AlignHCenter
+              wrapMode: Text.WordWrap
+              text: qsTr("პროექტის ფორმებში ცვლადიანი ნაგულისხმევი მნიშვნელობები ვერ მოიძებნა. შეამოწმეთ ინტერნეტი და თავიდან გახსენით.")
+              font: QfTheme.tipFont
+              color: QfTheme.secondaryTextColor
+            }
+          }
+        }
+      }
+    }
