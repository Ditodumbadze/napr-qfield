+    QString currentLayerName() const;
+    int currentGeometryType() const;
+
+    QVariantList symbols() const;
+    double layerOpacity() const;
+    bool labelsAvailable() const;
+    bool labelsEnabled() const;
+    double labelSize() const;
+    QColor labelColor() const;
+    bool labelHalo() const;
+    bool customized() const;
+
+    Q_INVOKABLE void setStrokeColor( int symbolIndex, const QColor &color );
+    Q_INVOKABLE void setFillColor( int symbolIndex, const QColor &color );
+    Q_INVOKABLE void setFillOpacity( int symbolIndex, double opacity );
+    Q_INVOKABLE void setStrokeWidth( int symbolIndex, double width );
+    Q_INVOKABLE void setStrokeStyle( int symbolIndex, int penStyle );
+    Q_INVOKABLE void setMarkerSize( int symbolIndex, double size );
+    Q_INVOKABLE void setVerticesVisible( int symbolIndex, bool visible );
+    Q_INVOKABLE void setSymbolVisible( int symbolIndex, bool visible );
+
+    Q_INVOKABLE void setLayerOpacity( double opacity );
+    Q_INVOKABLE void setLabelsEnabled( bool enabled );
+    Q_INVOKABLE void setLabelSize( double size );
+    Q_INVOKABLE void setLabelColor( const QColor &color );
+    Q_INVOKABLE void setLabelHalo( bool enabled );
+
+    //! Restores the style stored in the project for the current layer.
+    Q_INVOKABLE void resetLayer();
+
+    //! Rebuilds the layer list and re-applies the styles remembered on this device.
+    Q_INVOKABLE int applySaved();
+    Q_INVOKABLE void reload();
+
+  signals:
+    void currentLayerChanged();
+    void styleChanged();
+
+  private:
+    struct Original
+    {
+        std::unique_ptr<QgsFeatureRenderer> renderer;
+        std::unique_ptr<QgsAbstractVectorLayerLabeling> labeling;
+        bool labelsEnabled = false;
+        double opacity = 1.0;
+    };
+
+    QgsVectorLayer *currentLayer() const;
+    void rememberOriginal( QgsVectorLayer *layer );
+    int symbolCount( QgsVectorLayer *layer ) const;
+    std::unique_ptr<QgsSymbol> cloneSymbol( QgsVectorLayer *layer, int index, QString *label = nullptr, bool *visible = nullptr, bool *canToggle = nullptr ) const;
+    void replaceSymbol( QgsVectorLayer *layer, int index, QgsSymbol *symbol );
+    template<typename F> void editSymbol( int index, F edit );
+    void layerEdited( QgsVectorLayer *layer );
+    void save( QgsVectorLayer *layer ) const;
+    static QString settingsKey( const QgsVectorLayer *layer );
+    bool isCustomized( const QgsVectorLayer *layer ) const;
+
+    QList<QPointer<QgsVectorLayer>> mLayers;
+    QString mCurrentLayerId;
+    QHash<QString, std::shared_ptr<Original>> mOriginals; //!< layer id → project style
+};
+
+#endif // LAYERSTYLEMODEL_H
