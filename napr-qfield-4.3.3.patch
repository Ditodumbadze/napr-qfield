+          enabled: shapeModel.numSides < 100
+          opacity: enabled ? 1 : 0.4
+          onClicked: shapeModel.numSides = shapeModel.numSides + 1
+        }
+      }
+
+      Rectangle {
+        Layout.fillWidth: true
+        height: 1
+        color: QfTheme.controlBorderColor
+      }
+
+      // Progress + hint
+      RowLayout {
+        Layout.fillWidth: true
+        spacing: 10
+
+        Row {
+          spacing: 5
+          Repeater {
+            model: shapeModel.requiredPoints
+            Rectangle {
+              width: 10
+              height: 10
+              radius: 5
+              color: index < shapeModel.pointCount ? root.accentColor : "transparent"
+              border.color: index < shapeModel.pointCount ? root.accentColor : QfTheme.controlBorderColor
+              border.width: 1.5
+            }
+          }
+        }
+
+        Label {
+          Layout.fillWidth: true
+          text: shapeModel.canCommit ? qsTr("ფიგურა მზადაა — შეინახეთ") : root.penMode ? qsTr("შეეხეთ რუკას წერტილის დასასმელად") : qsTr("დაამთხვიეთ ჯვარედინი და დაამატეთ წერტილი")
+          font: QfTheme.tipFont
+          color: QfTheme.secondaryTextColor
+          elide: Text.ElideRight
+        }
+      }
+
+      // Centre mode: capture the point under the crosshair
+      QfButton {
+        Layout.fillWidth: true
+        visible: !root.penMode && !shapeModel.canCommit
+        text: qsTr("წერტილის დამატება")
+        icon.source: QfTheme.getThemeVectorIcon("ic_add_white_24dp")
+        bgcolor: "transparent"
+        color: root.accentColor
+        // Capture at the crosshair (screen centre) so snapping applies here too.
+        onClicked: shapeModel.capturePointAtScreen(root.width / 2, root.height / 2)
