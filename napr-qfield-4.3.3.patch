+                anchors.rightMargin: 10
+                spacing: 8
+
+                Rectangle {
+                  width: 10; height: 10; radius: 5
+                  color: "#E53935"
+                  Layout.alignment: Qt.AlignVCenter
+                }
+
+                Label {
+                  text: section
+                  font.pixelSize: 13
+                  font.bold: true
+                  color: "#424242"
+                  Layout.fillWidth: true
+                  elide: Text.ElideRight
+                }
