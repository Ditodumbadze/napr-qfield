+                MouseArea {
+                  anchors.fill: parent
+                  onClicked: {
+                    root.penMode = modelData.pen;
+                    shapeModel.clearProvisional();
+                  }
+                }
+              }
+            }
+          }
+        }
+
+        Item {
+          Layout.fillWidth: true
+        }
+
+        // Snapping toggle (uses the project's snapping configuration)
+        Rectangle {
+          Layout.preferredHeight: 40
+          Layout.preferredWidth: snapRow.implicitWidth + 24
+          radius: 20
+          color: shapeModel.snapEnabled ? root.tint(root.accentColor, 0.14) : QfTheme.groupBoxBackgroundColor
+          border.color: shapeModel.snapEnabled ? root.accentColor : "transparent"
+          border.width: 1
+
+          Row {
+            id: snapRow
+            anchors.centerIn: parent
+            spacing: 6
+
+            IconImage {
+              anchors.verticalCenter: parent.verticalCenter
+              source: QfTheme.getThemeVectorIcon("ic_snapping_white_24dp")
+              sourceSize: Qt.size(18, 18)
+              color: shapeModel.snapEnabled ? root.accentColor : QfTheme.secondaryTextColor
+            }
+
+            Label {
+              anchors.verticalCenter: parent.verticalCenter
+              text: qsTr("მიკვრა")
+              font: QfTheme.tipFont
+              color: shapeModel.snapEnabled ? root.accentColor : QfTheme.secondaryTextColor
+            }
+          }
+
+          MouseArea {
+            anchors.fill: parent
+            onClicked: shapeModel.snapEnabled = !shapeModel.snapEnabled
+          }
+        }
+      }
+
+      // Number of sides (regular polygon only)
+      RowLayout {
+        Layout.fillWidth: true
+        visible: shapeModel.mode === ShapeDigitizingModel.RegularPolygon
+        spacing: 4
+
+        Label {
+          text: qsTr("გვერდების რაოდენობა")
+          font: QfTheme.tipFont
+          color: QfTheme.mainTextColor
+          Layout.fillWidth: true
+        }
+
+        QfToolButton {
+          width: 36
+          height: 36
+          round: true
+          bgcolor: QfTheme.groupBoxBackgroundColor
+          iconSource: QfTheme.getThemeVectorIcon("ic_remove_white_24dp")
+          iconColor: QfTheme.mainTextColor
+          enabled: shapeModel.numSides > 3
