+
+QString VillageSelectorModel::saveOffline()
+{
+  if ( mBusy )
+    return tr( "შენახვა უკვე მიმდინარეობს" );
+  if ( offlineActive() )
+    return tr( "ჯერ დაბრუნდით ლაივ რეჟიმში" );
+  const QStringList codes = sortedSelection();
+  if ( codes.isEmpty() )
+    return tr( "ჯერ აირჩიეთ და ჩატვირთეთ სოფლები" );
+
+  struct Job
+  {
+      QString layerId;
+      QString name;
+      QString original;
+      QString source;
+      QString table;
+  };
+  QVector<Job> jobs;
+
+  QgsProject *project = QgsProject::instance();
+  const QMap<QString, QgsMapLayer *> layers = project->mapLayers();
+  for ( QgsMapLayer *layer : layers )
+  {
+    QgsVectorLayer *vl = qobject_cast<QgsVectorLayer *>( layer );
+    if ( !vl )
+      continue;
+    const QString original = originalSourceFor( vl );
+    if ( original.isEmpty() )
+      continue;
+
+    QgsDataSourceUri uri( original );
+    const QString filter = buildFilter( uri.param( QStringLiteral( "filter" ) ), codes );
+    uri.removeParam( QStringLiteral( "filter" ) );
+    uri.setParam( QStringLiteral( "filter" ), filter );
+
+    QString table = uri.param( QStringLiteral( "typename" ) ).section( QLatin1Char( ':' ), -1 ).toLower();
+    table.replace( QRegularExpression( QStringLiteral( "[^a-z0-9_]" ) ), QStringLiteral( "_" ) );
+    table = QStringLiteral( "l%1_%2" ).arg( jobs.size() ).arg( table );
+
+    jobs.append( { vl->id(), vl->name(), original, uri.uri( false ), table } );
+  }
+
+  if ( jobs.isEmpty() )
+    return tr( "პროექტში ვერ მოიძებნა სოფლების მიხედვით ფილტრირებული ფენა" );
+
+  const QString dir = QStandardPaths::writableLocation( QStandardPaths::AppDataLocation ) + QStringLiteral( "/georgia_offline" );
+  QDir().mkpath( dir );
+  const QString path = QStringLiteral( "%1/offline_%2.gpkg" ).arg( dir, QDateTime::currentDateTime().toString( QStringLiteral( "yyyyMMdd_HHmmss" ) ) );
+
+  delete mFeedback;
+  mFeedback = new QgsFeedback();
+  QgsFeedback *feedback = mFeedback;
+  const QgsCoordinateTransformContext transformContext = project->transformContext();
+
+  setBusy( true );
+  setProgressText( tr( "მზადება..." ) );
+
+  auto *watcher = new QFutureWatcher<QStringList>( this );
+  connect( watcher, &QFutureWatcher<QStringList>::finished, this, [this, watcher, jobs, path, codes, feedback] {
+    const QStringList results = watcher->result(); // one entry per job: empty = OK, otherwise the error
+    watcher->deleteLater();
+
+    const bool canceled = feedback->isCanceled();
+    QStringList failed;
+    int succeeded = 0;
+    for ( int i = 0; i < results.size(); ++i )
+    {
+      if ( results.at( i ).isEmpty() )
+        ++succeeded;
+      else
+        failed << results.at( i );
+    }
+
+    if ( canceled || succeeded == 0 )
+    {
+      QFile::remove( path );
+      setBusy( false );
+      setProgressText( QString() );
+      emit offlineFinished( false, canceled ? tr( "შენახვა გაუქმდა" ) : tr( "ვერ შეინახა: %1" ).arg( failed.join( QStringLiteral( "; " ) ) ) );
+      return;
+    }
+
+    // Switch the downloaded layers to the local copy (read-only).
+    QgsProject *project = QgsProject::instance();
+    QgsDataProvider::ProviderOptions options;
+    options.transformContext = project->transformContext();
+    QVariantMap tables;
+    for ( int i = 0; i < jobs.size() && i < results.size(); ++i )
+    {
+      if ( !results.at( i ).isEmpty() )
+        continue;
+      const Job &job = jobs.at( i );
+      tables.insert( wfsKey( job.original ), job.table );
+      if ( QgsVectorLayer *vl = qobject_cast<QgsVectorLayer *>( project->mapLayer( job.layerId ) ) )
+      {
+        mOriginalSources.insert( vl->id(), job.original );
+        vl->setDataSource( QStringLiteral( "%1|layername=%2" ).arg( path, job.table ), vl->name(), QStringLiteral( "ogr" ), options, false );
+        vl->setReadOnly( true );
+        vl->triggerRepaint();
+      }
+    }
+
+    QSettings settings;
+    const QString previous = settings.value( OFFLINE_FILE_KEY ).toString();
+    settings.setValue( OFFLINE_FILE_KEY, path );
+    settings.setValue( OFFLINE_LAYERS_KEY, tables );
+    settings.setValue( OFFLINE_DATE_KEY, QDateTime::currentDateTime() );
+    settings.setValue( OFFLINE_VILLAGES_KEY, codes );
+    settings.setValue( OFFLINE_ACTIVE_KEY, true );
+    if ( !previous.isEmpty() && previous != path )
+      QFile::remove( previous );
+
+    setBusy( false );
+    setProgressText( QString() );
+    emit offlineChanged();
+    emit offlineFinished( true, failed.isEmpty() ? tr( "ოფლაინ შენახულია: %1 ფენა" ).arg( succeeded ) : tr( "შენახულია %1 ფენა, ვერ შეინახა: %2" ).arg( succeeded ).arg( failed.join( QStringLiteral( "; " ) ) ) );
+  } );
+
+  // The download runs on a worker thread with its own layer objects, so the
+  // map stays usable while the villages are being saved.
+  watcher->setFuture( QtConcurrent::run( [this, jobs, path, feedback, transformContext]() -> QStringList {
+    QStringList results;
+    bool fileCreated = false;
+    for ( int i = 0; i < jobs.size(); ++i )
+    {
+      if ( feedback->isCanceled() )
+      {
+        results << tr( "გაუქმდა" );
+        continue;
+      }
+      const Job &job = jobs.at( i );
+      const QString progress = tr( "ინახება: %1 (%2/%3)" ).arg( job.name ).arg( i + 1 ).arg( jobs.size() );
+      QMetaObject::invokeMethod( this, [this, progress] { setProgressText( progress ); }, Qt::QueuedConnection );
+
+      QgsVectorLayer::LayerOptions layerOptions( transformContext );
+      layerOptions.loadDefaultStyle = false;
+      QgsVectorLayer layer( job.source, job.name, QStringLiteral( "WFS" ), layerOptions );
+      if ( !layer.isValid() )
+      {
+        results << tr( "%1: სერვერთან კავშირი ვერ დამყარდა" ).arg( job.name );
+        continue;
+      }
+
+      QgsVectorFileWriter::SaveVectorOptions saveOptions;
+      saveOptions.driverName = QStringLiteral( "GPKG" );
+      saveOptions.layerName = job.table;
+      saveOptions.fileEncoding = QStringLiteral( "UTF-8" );
+      saveOptions.actionOnExistingFile = fileCreated ? QgsVectorFileWriter::CreateOrOverwriteLayer : QgsVectorFileWriter::CreateOrOverwriteFile;
+      saveOptions.feedback = feedback;
+
+      QString error;
+      const QgsVectorFileWriter::WriterError result = QgsVectorFileWriter::writeAsVectorFormatV3( &layer, path, transformContext, saveOptions, &error );
+      if ( result != QgsVectorFileWriter::NoError )
+      {
+        results << QStringLiteral( "%1: %2" ).arg( job.name, error );
+        continue;
+      }
+      fileCreated = true;
+      results << QString();
+    }
+    return results;
+  } ) );
+
+  return QString();
+}
+
+void VillageSelectorModel::cancelOffline()
+{
+  if ( mFeedback )
+    mFeedback->cancel();
+}
+
+QString VillageSelectorModel::goLive()
+{
+  if ( mBusy )
+    return tr( "დაელოდეთ შენახვის დასრულებას" );
+  // apply() rebuilds every village layer from its original WFS source with the
+  // current selection and clears the offline flag.
+  return apply();
+}
+
+bool VillageSelectorModel::switchToOffline()
+{
+  QSettings settings;
+  const QString path = settings.value( OFFLINE_FILE_KEY ).toString();
+  const QVariantMap tables = settings.value( OFFLINE_LAYERS_KEY ).toMap();
+  if ( path.isEmpty() || !QFileInfo::exists( path ) || tables.isEmpty() )
+  {
+    clearOfflineState();
+    return false;
+  }
+
+  QgsProject *project = QgsProject::instance();
+  QgsDataProvider::ProviderOptions options;
+  options.transformContext = project->transformContext();
+
+  int switched = 0;
+  const QMap<QString, QgsMapLayer *> layers = project->mapLayers();
+  for ( QgsMapLayer *layer : layers )
+  {
+    QgsVectorLayer *vl = qobject_cast<QgsVectorLayer *>( layer );
+    if ( !vl )
+      continue;
+    const QString original = originalSourceFor( vl );
+    if ( original.isEmpty() )
+      continue;
+    const QString table = tables.value( wfsKey( original ) ).toString();
+    if ( table.isEmpty() )
+      continue;
+    vl->setDataSource( QStringLiteral( "%1|layername=%2" ).arg( path, table ), vl->name(), QStringLiteral( "ogr" ), options, false );
+    vl->setReadOnly( true );
+    vl->triggerRepaint();
+    ++switched;
+  }
+
+  if ( switched > 0 )
+  {
+    const QStringList codes = settings.value( OFFLINE_VILLAGES_KEY ).toStringList();
+    if ( !codes.isEmpty() )
+    {
+      QgsExpressionContextUtils::setProjectVariable( project, QStringLiteral( "myzone" ), QStringLiteral( "<%1%>" ).arg( codes.at( 0 ) ) );
+      QgsExpressionContextUtils::setProjectVariable( project, QStringLiteral( "orzone" ), QStringLiteral( "<%1%>" ).arg( codes.size() > 1 ? codes.at( 1 ) : codes.at( 0 ) ) );
+      QgsExpressionContextUtils::setProjectVariable( project, QStringLiteral( "villages" ), codes.join( QLatin1Char( ',' ) ) );
+    }
+  }
+  return switched > 0;
+}
