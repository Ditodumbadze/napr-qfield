+            Layout.rightMargin: 16
+            text: qsTr("ახალ ობიექტს ეს მნიშვნელობები ავტომატურად ჩაეწერება.")
+            font: QfTheme.tipFont
+            color: QfTheme.secondaryTextColor
+            wrapMode: Text.WordWrap
