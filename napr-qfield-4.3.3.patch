+                          width: Math.min(implicitWidth, defaultColumn.width - 24)
+                          text: modelData.label
+                          font: QfTheme.tipFont
+                          color: parent.selected ? "white" : QfTheme.mainTextColor
+                          wrapMode: Text.WordWrap
+                          horizontalAlignment: Text.AlignHCenter
+                        }
