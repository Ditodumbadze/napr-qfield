+static const QString SETTINGS_KEY = QStringLiteral( "georgiaqfield/villages/selected" );
+static const QString OFFLINE_ACTIVE_KEY = QStringLiteral( "georgiaqfield/offline/active" );
+static const QString OFFLINE_FILE_KEY = QStringLiteral( "georgiaqfield/offline/file" );
+static const QString OFFLINE_LAYERS_KEY = QStringLiteral( "georgiaqfield/offline/layers" );
+static const QString OFFLINE_DATE_KEY = QStringLiteral( "georgiaqfield/offline/date" );
+static const QString OFFLINE_VILLAGES_KEY = QStringLiteral( "georgiaqfield/offline/villages" );
+
+namespace
+{
+  bool usesZoneVariables( const QString &source )
+  {
+    return source.contains( QLatin1String( "@myzone" ), Qt::CaseInsensitive ) || source.contains( QLatin1String( "@orzone" ), Qt::CaseInsensitive );
+  }
+
+  //! Identifies a WFS layer independently of its filter.
+  QString wfsKey( const QString &source )
+  {
+    const QgsDataSourceUri uri( source );
+    return uri.param( QStringLiteral( "url" ) ) + QLatin1Char( '|' ) + uri.param( QStringLiteral( "typename" ) );
+  }
+
+  //! wfsKey → original source (with the @myzone / @orzone filter), filled while projects are read.
+  QHash<QString, QString> &originalSourcesByKey()
+  {
+    static QHash<QString, QString> sOriginals;
+    return sOriginals;
+  }
+
+  bool sPreprocessedOnRead = false;
+
+  /**
+   * The NAPR field-work layers must always talk to the server as WFS 1.0.0:
+   * with "auto" / 2.0.0 QGIS 4 sends the edits in a form the server rejects.
+   * Matched by layer name (after loading) and by WFS type name (while reading).
+   */
+  const QStringList &fixedVersionLayerNames()
+  {
+    static const QStringList sNames = {
+      QStringLiteral( "წერტილი" ), QStringLiteral( "საზღვარი" ), QStringLiteral( "შენობა" ),
+      QStringLiteral( "ნაკვეთი" ), QStringLiteral( "ვალდებულება" ), QStringLiteral( "ტოპონიმიკა" ),
+    };
+    return sNames;
+  }
+
+  bool isFixedVersionTypeName( const QString &typeName )
+  {
+    static const QStringList sTypeNames = {
+      QStringLiteral( "GFLD_POINTS" ), QStringLiteral( "GFLD_TOPOLINES" ), QStringLiteral( "GFLD_BUILDINGS" ),
+      QStringLiteral( "GFLD_PARCELS" ), QStringLiteral( "GFLD_EASEMENTS" ), QStringLiteral( "test_poi" ),
+    };
+    const QString name = typeName.section( QLatin1Char( ':' ), -1 );
+    return sTypeNames.contains( name, Qt::CaseInsensitive );
+  }
+
+  const QString FIXED_WFS_VERSION = QStringLiteral( "1.0.0" );
+
+  //! Sets version='1.0.0' on the URI, keeping every other parameter. Returns true if it changed.
+  bool forceWfsVersion( QgsDataSourceUri &uri )
+  {
+    if ( uri.param( QStringLiteral( "version" ) ) == FIXED_WFS_VERSION )
+      return false;
+    uri.removeParam( QStringLiteral( "version" ) );
+    uri.setParam( QStringLiteral( "version" ), FIXED_WFS_VERSION );
+    return true;
+  }
+
+  bool needsFixedVersion( const QgsDataSourceUri &uri, const QString &layerName = QString() )
+  {
+    return fixedVersionLayerNames().contains( layerName ) || isFixedVersionTypeName( uri.param( QStringLiteral( "typename" ) ) );
+  }
+
+  //! Sets the village filter on a WFS data source.
+  void setVillageFilter( QgsDataSourceUri &uri, const QString &filter )
+  {
+    uri.removeParam( QStringLiteral( "filter" ) );
+    uri.setParam( QStringLiteral( "filter" ), filter );
+  }
+} // namespace
