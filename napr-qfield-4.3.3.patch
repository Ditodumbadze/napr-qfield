+import QtQuick
+import QtQuick.Controls
+import QtQuick.Controls.impl
+import QtQuick.Layouts
+import org.qfield.core
+import org.qfield.gui
+
+/**
+ * Georgia QField: municipality → village picker.
+ *
+ * Municipalities are listed alphabetically; tapping one expands its villages.
+ * Any number of villages can be ticked (or a whole municipality at once) and
+ * "Load" rewrites the NAPR WFS layer filters so all of them are downloaded.
+ */
+Item {
+  id: root
+
+  property bool isOpen: false
+
+  signal toast(string message)
+
+  readonly property real panelWidth: Math.min(width - 64, Math.max(width * 0.3, 320))
+
+  visible: isOpen
+
+  function tint(c, a) {
+    return Qt.rgba(c.r, c.g, c.b, a);
+  }
+
+  //! Re-applies the remembered selection; call after a project has been opened.
+  //! True while the village layers are served from the offline copy.
+  readonly property bool offlineActive: villageModel.offlineActive
+
+  function applySaved() {
+    if (villageModel.applySaved()) {
+      if (villageModel.offlineActive)
+        root.toast(qsTr("ოფლაინ რეჟიმი · %1").arg(villageModel.offlineInfo));
+      else
+        root.toast(qsTr("ჩაიტვირთა არჩეული სოფლები (%1)").arg(villageModel.selectedCount));
+    }
+  }
+
+  VillageSelectorModel {
+    id: villageModel
+    onOfflineFinished: (success, message) => root.toast(message)
+  }
+
+  onIsOpenChanged: {
+    if (!isOpen) {
+      searchField.text = "";
+      searchField.focus = false;
+    }
+  }
+
+  component CheckMark: Rectangle {
+    property int checkState: 0 // 0 none, 1 partial, 2 checked
+    width: 22
+    height: 22
+    radius: 6
+    color: checkState > 0 ? QfTheme.mainColor : "transparent"
+    border.width: 2
+    border.color: checkState > 0 ? QfTheme.mainColor : QfTheme.secondaryTextColor
+
+    IconImage {
+      anchors.centerIn: parent
+      visible: parent.checkState === 2
+      source: QfTheme.getThemeVectorIcon("ic_check_white_24dp")
+      sourceSize: Qt.size(18, 18)
+      color: "white"
+    }
+    Rectangle {
+      anchors.centerIn: parent
+      visible: parent.checkState === 1
+      width: 10
+      height: 2.5
+      radius: 1
+      color: "white"
+    }
+  }
+
+  // Dim the map slightly and close when tapping outside the panel
+  Rectangle {
+    anchors.fill: parent
+    color: "#33000000"
+    MouseArea {
+      anchors.fill: parent
+      onClicked: root.isOpen = false
+    }
+  }
+
+  Rectangle {
+    id: panel
+    width: root.panelWidth
+    height: parent.height
+    anchors.right: parent.right
+    color: QfTheme.mainBackgroundColor
+
+    MouseArea {
+      anchors.fill: parent
+      onClicked: {}
+    }
+
+    ColumnLayout {
+      anchors.fill: parent
+      anchors.topMargin: mainWindow.sceneTopMargin
+      anchors.bottomMargin: mainWindow.sceneBottomMargin
+      spacing: 0
+
+      // ---- Header ----
+      RowLayout {
+        Layout.fillWidth: true
+        Layout.preferredHeight: 56
+        Layout.leftMargin: 16
+        Layout.rightMargin: 6
+        spacing: 8
+
+        IconImage {
+          source: QfTheme.getThemeVectorIcon("ic_napr_villages_white_24dp")
+          sourceSize: Qt.size(24, 24)
+          color: QfTheme.mainColor
+        }
+
+        Label {
+          text: qsTr("სოფლები")
+          font: QfTheme.strongTitleFont
+          color: QfTheme.mainTextColor
+          elide: Text.ElideRight
+          Layout.fillWidth: true
+        }
+
+        QfToolButton {
+          width: 40
+          height: 40
+          round: true
+          bgcolor: "transparent"
+          iconSource: QfTheme.getThemeVectorIcon("ic_close_white_24dp")
+          iconColor: QfTheme.mainTextColor
+          onClicked: root.isOpen = false
+        }
+      }
+
+      // ---- Search ----
+      Rectangle {
+        Layout.fillWidth: true
+        Layout.leftMargin: 12
+        Layout.rightMargin: 12
+        Layout.preferredHeight: 44
+        radius: 22
+        color: QfTheme.groupBoxBackgroundColor
+
+        RowLayout {
+          anchors.fill: parent
+          anchors.leftMargin: 14
+          anchors.rightMargin: 4
+          spacing: 6
+
+          IconImage {
+            source: QfTheme.getThemeVectorIcon("ic_baseline_search_white")
+            sourceSize: Qt.size(20, 20)
+            color: QfTheme.secondaryTextColor
+          }
+
+          TextField {
+            id: searchField
+            Layout.fillWidth: true
+            placeholderText: qsTr("მუნიციპალიტეტი ან სოფელი")
+            font: QfTheme.defaultFont
+            color: QfTheme.mainTextColor
+            placeholderTextColor: QfTheme.secondaryTextColor
+            background: Item {}
+            topPadding: 0
+            bottomPadding: 0
+            leftPadding: 0
+            verticalAlignment: TextInput.AlignVCenter
+            inputMethodHints: Qt.ImhNoPredictiveText
+            onTextChanged: searchTimer.restart()
+          }
+
+          QfToolButton {
+            visible: searchField.text !== ""
+            width: 36
+            height: 36
+            round: true
+            bgcolor: "transparent"
+            iconSource: QfTheme.getThemeVectorIcon("ic_clear_white_24dp")
+            iconColor: QfTheme.secondaryTextColor
+            onClicked: searchField.text = ""
+          }
+        }
+
+        Timer {
+          id: searchTimer
+          interval: 250
+          onTriggered: villageModel.searchText = searchField.text
+        }
+      }
+
+      // ---- Selection summary ----
+      RowLayout {
+        Layout.fillWidth: true
+        Layout.leftMargin: 16
+        Layout.rightMargin: 8
+        Layout.topMargin: 6
+        Layout.preferredHeight: 36
+        spacing: 8
+
+        Label {
+          Layout.fillWidth: true
+          text: villageModel.selectedCount > 0 ? qsTr("არჩეულია: %1").arg(villageModel.selectedCount) : qsTr("%1 მუნიციპალიტეტი · %2 სოფელი").arg(villageList.municipalityCount).arg(villageModel.villageCount)
+          font: villageModel.selectedCount > 0 ? QfTheme.strongTipFont : QfTheme.tipFont
+          color: villageModel.selectedCount > 0 ? QfTheme.mainColor : QfTheme.secondaryTextColor
+          elide: Text.ElideRight
+        }
+
+        QfButton {
+          visible: villageModel.selectedCount > 0
+          text: qsTr("გასუფთავება")
+          bgcolor: "transparent"
+          borderColor: "transparent"
+          color: QfTheme.secondaryTextColor
+          onClicked: villageModel.clearSelection()
+        }
+      }
+
+      Rectangle {
+        Layout.fillWidth: true
+        height: 1
+        color: QfTheme.controlBorderColor
+      }
+
+      // ---- Municipality / village list ----
+      ListView {
+        id: villageList
+        Layout.fillWidth: true
+        Layout.fillHeight: true
+        clip: true
+        model: villageModel
+        reuseItems: true
+        ScrollBar.vertical: QfScrollBar {}
+
+        readonly property int municipalityCount: 75
+
+        delegate: Rectangle {
+          id: rowItem
+          width: villageList.width
+          height: model.rowType === VillageSelectorModel.MunicipalityRow ? 54 : 46
+          color: rowArea.pressed ? root.tint(QfTheme.mainColor, 0.10) : model.rowType === VillageSelectorModel.MunicipalityRow && model.expanded ? QfTheme.groupBoxBackgroundColor : "transparent"
+
+          readonly property bool isHeader: model.rowType === VillageSelectorModel.MunicipalityRow
+
+          MouseArea {
+            id: rowArea
+            anchors.fill: parent
+            onClicked: {
+              if (rowItem.isHeader)
+                villageModel.toggleExpanded(index);
+              else
+                villageModel.toggleChecked(index);
+            }
+          }
+
+          RowLayout {
+            anchors.fill: parent
+            anchors.leftMargin: rowItem.isHeader ? 10 : 48
+            anchors.rightMargin: 12
+            spacing: 10
+
+            // Municipality: chevron
+            IconImage {
+              visible: rowItem.isHeader
+              source: QfTheme.getThemeVectorIcon("ic_chevron_right_white_24dp")
+              sourceSize: Qt.size(22, 22)
+              color: QfTheme.secondaryTextColor
+              rotation: model.expanded ? 90 : 0
+              Behavior on rotation {
+                NumberAnimation {
+                  duration: 120
+                }
+              }
+            }
+
+            // Village: checkbox on the left
+            CheckMark {
+              visible: !rowItem.isHeader
+              checkState: model.checkState
+            }
+
+            Label {
+              Layout.fillWidth: true
+              text: model.name
+              font: rowItem.isHeader ? QfTheme.strongFont : QfTheme.defaultFont
+              color: QfTheme.mainTextColor
+              elide: Text.ElideRight
+            }
+
+            // Municipality: selected / total badge
+            Rectangle {
+              visible: rowItem.isHeader
+              Layout.preferredHeight: 22
+              Layout.preferredWidth: badgeLabel.implicitWidth + 14
+              radius: 11
+              color: model.selectedCount > 0 ? root.tint(QfTheme.mainColor, 0.16) : QfTheme.groupBoxSurfaceColor
+              Label {
+                id: badgeLabel
+                anchors.centerIn: parent
+                text: model.selectedCount > 0 ? model.selectedCount + " / " + model.totalCount : model.totalCount
+                font: QfTheme.tinyFont
+                color: model.selectedCount > 0 ? QfTheme.mainColor : QfTheme.secondaryTextColor
+              }
+            }
+
+            // Village: code
+            Label {
+              visible: !rowItem.isHeader
+              text: model.code
+              font: QfTheme.tinyFont
+              color: QfTheme.secondaryTextColor
+            }
+
+            // Municipality: select-all checkbox
+            Item {
+              visible: rowItem.isHeader
+              Layout.preferredWidth: 40
+              Layout.preferredHeight: 40
+              CheckMark {
+                anchors.centerIn: parent
+                checkState: model.checkState
+              }
+              MouseArea {
+                anchors.fill: parent
+                onClicked: villageModel.toggleChecked(index)
+              }
+            }
+          }
+
+          Rectangle {
+            width: parent.width - (rowItem.isHeader ? 0 : 48)
+            height: 1
+            anchors.bottom: parent.bottom
+            anchors.right: parent.right
+            color: QfTheme.controlBorderColor
+          }
+        }
+
+        Label {
+          anchors.centerIn: parent
+          visible: villageList.count === 0
+          text: qsTr("ვერაფერი მოიძებნა")
+          font: QfTheme.tipFont
+          color: QfTheme.secondaryTextColor
+        }
+      }
+
+      Rectangle {
+        Layout.fillWidth: true
+        height: 1
+        color: QfTheme.controlBorderColor
+      }
+
+      // ---- Offline status ----
+      Rectangle {
+        Layout.fillWidth: true
+        Layout.leftMargin: 12
+        Layout.rightMargin: 12
+        Layout.topMargin: 10
+        Layout.preferredHeight: offlineRow.implicitHeight + 16
+        visible: villageModel.offlineActive || villageModel.busy
+        radius: 10
+        color: villageModel.busy ? root.tint(QfTheme.mainColor, 0.10) : root.tint(QfTheme.warningColor, 0.14)
+
+        RowLayout {
+          id: offlineRow
+          anchors.fill: parent
+          anchors.margins: 8
+          spacing: 8
+
+          BusyIndicator {
+            visible: villageModel.busy
+            running: visible
+            Layout.preferredWidth: 28
+            Layout.preferredHeight: 28
+          }
+
+          IconImage {
+            visible: !villageModel.busy
+            source: QfTheme.getThemeVectorIcon("ic_cloud_off_24dp")
+            sourceSize: Qt.size(22, 22)
+            color: QfTheme.warningColor
+          }
+
+          ColumnLayout {
+            Layout.fillWidth: true
+            spacing: 0
+            Label {
+              Layout.fillWidth: true
+              text: villageModel.busy ? qsTr("ოფლაინ შენახვა...") : qsTr("ოფლაინ რეჟიმი")
+              font: QfTheme.strongTipFont
+              color: QfTheme.mainTextColor
+              elide: Text.ElideRight
+            }
+            Label {
+              Layout.fillWidth: true
+              text: villageModel.busy ? villageModel.progressText : villageModel.offlineInfo
+              font: QfTheme.tinyFont
+              color: QfTheme.secondaryTextColor
+              elide: Text.ElideRight
+            }
+          }
+
+          QfButton {
+            visible: villageModel.busy
+            text: qsTr("გაუქმება")
+            bgcolor: "transparent"
+            borderColor: "transparent"
+            color: QfTheme.errorColor
+            onClicked: villageModel.cancelOffline()
+          }
+        }
+      }
+
+      // ---- Actions ----
+      QfButton {
+        Layout.fillWidth: true
+        Layout.leftMargin: 12
+        Layout.rightMargin: 12
+        Layout.topMargin: 10
+        text: villageModel.selectedCount > 0 ? qsTr("ჩატვირთვა (%1)").arg(villageModel.selectedCount) : qsTr("ჩატვირთვა")
+        icon.source: QfTheme.getThemeVectorIcon("ic_download_white_24dp")
+        bgcolor: QfTheme.mainColor
+        color: "white"
+        enabled: villageModel.selectedCount > 0 && !villageModel.busy
+        onClicked: {
+          var err = villageModel.apply();
+          if (err === "") {
+            root.toast(qsTr("ჩაიტვირთა %1 სოფელი").arg(villageModel.selectedCount));
+            root.isOpen = false;
+          } else {
+            root.toast(err);
+          }
+        }
+      }
+
+      RowLayout {
+        Layout.fillWidth: true
+        Layout.leftMargin: 12
+        Layout.rightMargin: 12
+        Layout.bottomMargin: 12
+        spacing: 8
+
+        // Save the loaded villages for use without internet
+        QfButton {
+          Layout.fillWidth: true
+          visible: !villageModel.offlineActive
+          text: qsTr("ოფლაინ შენახვა")
+          icon.source: QfTheme.getThemeVectorIcon("ic_cloud_download_24dp")
+          bgcolor: "transparent"
+          color: QfTheme.mainColor
+          enabled: villageModel.selectedCount > 0 && !villageModel.busy
+          onClicked: {
+            var err = villageModel.saveOffline();
+            if (err !== "")
+              root.toast(err);
+          }
+        }
+
+        // Back to the live server
+        QfButton {
+          Layout.fillWidth: true
+          visible: villageModel.offlineActive
+          text: qsTr("ლაივში დაბრუნება")
+          icon.source: QfTheme.getThemeVectorIcon("ic_cloud_synchronize_24dp")
+          bgcolor: "transparent"
+          color: QfTheme.mainColor
+          enabled: !villageModel.busy
+          onClicked: {
+            var err = villageModel.goLive();
+            root.toast(err === "" ? qsTr("ლაივ რეჟიმი — მონაცემები სერვერიდან") : err);
+          }
+        }
+      }
+    }
+  }
+}
