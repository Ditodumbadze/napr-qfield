+import QtQuick
+import QtQuick.Controls
+import QtQuick.Controls.impl
+import QtQuick.Layouts
+import org.qfield.core
+import org.qfield.gui
+
+/**
+ * Topology checker side panel.
+ *
+ * Runs the configured rules against the features in the current map extent,
+ * lists the errors grouped by rule, zooms to an error when tapped and blinks a
+ * marker on it. A settings view lets the user edit the rule list.
+ */
+Item {
+  id: root
+
+  property var mapSettingsRef: null
+  property bool isOpen: false
+  property bool showSettings: false
+
+  // Panel takes 30% of the screen width, but never less than what is needed to
+  // stay readable, and always leaves the left toolbar visible.
+  readonly property real panelWidth: Math.min(width - 64, Math.max(width * 0.3, 300))
+
+  visible: isOpen
+
+  property var layerNames: []
+
+  function refreshLayers() {
+    layerNames = topologyModel.vectorLayerNames();
+  }
+
+  function tint(c, a) {
+    return Qt.rgba(c.r, c.g, c.b, a);
+  }
+
+  onShowSettingsChanged: {
+    if (showSettings)
+      refreshLayers();
+  }
+
+  TopologyCheckerModel {
+    id: topologyModel
+    mapSettings: root.mapSettingsRef
+  }
+
+  // ---- Blinking marker drawn exactly on the error after zooming ----
+  Item {
+    id: errorMarker
+    visible: false
+    z: 5
+    property real px: 0
+    property real py: 0
+
+    Rectangle {
+      id: markerRing
+      width: 16
+      height: 16
+      radius: width / 2
+      x: errorMarker.px - width / 2
+      y: errorMarker.py - height / 2
+      color: "transparent"
+      border.color: QfTheme.errorColor
+      border.width: 3
+      opacity: 0
+    }
+
+    Rectangle {
+      id: markerDot
+      width: 18
+      height: 18
+      radius: 9
+      x: errorMarker.px - width / 2
+      y: errorMarker.py - height / 2
+      color: QfTheme.errorColor
+      border.color: "white"
+      border.width: 2
+      opacity: 0
+    }
+
+    SequentialAnimation {
+      id: markerAnim
+      loops: 3
+      ParallelAnimation {
+        NumberAnimation {
+          target: markerDot
+          property: "opacity"
+          from: 0.25
+          to: 1.0
+          duration: 250
+        }
+        NumberAnimation {
+          target: markerRing
+          property: "width"
+          from: 16
+          to: 64
+          duration: 650
+        }
+        NumberAnimation {
+          target: markerRing
+          property: "opacity"
+          from: 0.9
+          to: 0.0
+          duration: 650
+        }
+      }
+      NumberAnimation {
+        target: markerDot
+        property: "opacity"
+        to: 0.3
+        duration: 200
+      }
+      onStopped: {
+        markerRing.width = 16;
+        errorMarker.visible = false;
+      }
+    }
+  }
+
+  Connections {
+    target: topologyModel
+    function onHighlightPointRequested(px, py) {
+      errorMarker.px = px;
+      errorMarker.py = py;
+      markerRing.width = 16;
+      errorMarker.visible = true;
+      markerAnim.restart();
+    }
+  }
+
+  // ---- Side panel ----
+  Rectangle {
+    id: panel
+    width: root.panelWidth
+    height: parent.height
+    anchors.right: parent.right
+    color: QfTheme.mainBackgroundColor
+    z: 10
+
+    // Soft shadow on the left edge
+    Rectangle {
+      width: 8
+      height: parent.height
+      anchors.right: parent.left
+      gradient: Gradient {
+        orientation: Gradient.Horizontal
