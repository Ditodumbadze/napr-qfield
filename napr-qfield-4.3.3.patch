+          position: 0.0
+          color: "transparent"
+        }
+        GradientStop {
+          position: 1.0
+          color: "#33000000"
+        }
+      }
+    }
+
+    // Absorb touches so the map underneath does not react.
+    MouseArea {
+      anchors.fill: parent
+      onClicked: {}
+    }
+
+    ColumnLayout {
+      anchors.fill: parent
+      anchors.topMargin: mainWindow.sceneTopMargin
+      anchors.bottomMargin: mainWindow.sceneBottomMargin
+      spacing: 0
+
+      // ---- Header ----
+      RowLayout {
+        Layout.fillWidth: true
+        Layout.preferredHeight: 56
+        Layout.leftMargin: 8
+        Layout.rightMargin: 6
+        spacing: 4
+
