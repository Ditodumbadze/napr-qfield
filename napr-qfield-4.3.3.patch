+        onClicked: shapeModel.capturePointAtScreen(root.width / 2, root.height / 2)
+      }
+
+      // Actions
+      RowLayout {
+        Layout.fillWidth: true
+        spacing: 8
+
+        QfToolButton {
+          width: 44
+          height: 44
+          round: true
+          bgcolor: QfTheme.groupBoxBackgroundColor
+          iconSource: QfTheme.getThemeVectorIcon("ic_undo_black_24dp")
+          iconColor: QfTheme.mainTextColor
+          enabled: shapeModel.pointCount > 0
+          opacity: enabled ? 1 : 0.4
+          onClicked: shapeModel.undoPoint()
+        }
+
+        QfToolButton {
+          width: 44
+          height: 44
+          round: true
+          bgcolor: QfTheme.groupBoxBackgroundColor
+          iconSource: QfTheme.getThemeVectorIcon("ic_delete_forever_white_24dp")
+          iconColor: QfTheme.errorColor
+          enabled: shapeModel.pointCount > 0
+          opacity: enabled ? 1 : 0.4
+          onClicked: shapeModel.clear()
+        }
+
+        Item {
+          Layout.fillWidth: true
+        }
+
+        QfButton {
+          text: qsTr("შენახვა")
+          icon.source: QfTheme.getThemeVectorIcon("ic_check_white_24dp")
+          bgcolor: root.accentColor
+          color: "white"
+          enabled: shapeModel.canCommit
+          onClicked: {
+            var err = shapeModel.commit();
+            root.toast(err === "" ? qsTr("ფიგურა დაემატა") : err);
+          }
+        }
+      }
+    }
+  }
+}
diff --git a/src/gui/qml/TopologyCheckerDialog.qml b/src/gui/qml/TopologyCheckerDialog.qml
new file mode 100644
index 0000000..d5ed827
--- /dev/null
+++ b/src/gui/qml/TopologyCheckerDialog.qml
@@ -0,0 +1,611 @@
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Controls.impl
+import QtQuick.Layouts
+import org.qfield.core
+import org.qfield.gui
+
+/**
+ * Topology checker side panel.
+ *
+ * Runs the configured rules against the features in the current map extent,
+ * lists the errors grouped by rule, zooms to an error when tapped and blinks a
+ * marker on it. A settings view lets the user edit the rule list.
+ */
+Item {
+  id: root
+
+  property var mapSettingsRef: null
+  property bool isOpen: false
+  property bool showSettings: false
+
+  // Panel takes 30% of the screen width, but never less than what is needed to
+  // stay readable, and always leaves the left toolbar visible.
+  readonly property real panelWidth: Math.min(width - 64, Math.max(width * 0.3, 300))
+
+  visible: isOpen
+
+  property var layerNames: []
+
+  function refreshLayers() {
+    layerNames = topologyModel.vectorLayerNames();
+  }
+
+  function tint(c, a) {
+    return Qt.rgba(c.r, c.g, c.b, a);
+  }
+
+  onShowSettingsChanged: {
+    if (showSettings)
+      refreshLayers();
+  }
+
+  TopologyCheckerModel {
+    id: topologyModel
+    mapSettings: root.mapSettingsRef
+  }
+
+  // ---- Blinking marker drawn exactly on the error after zooming ----
+  Item {
+    id: errorMarker
+    visible: false
+    z: 5
+    property real px: 0
+    property real py: 0
+
+    Rectangle {
+      id: markerRing
+      width: 16
+      height: 16
+      radius: width / 2
+      x: errorMarker.px - width / 2
+      y: errorMarker.py - height / 2
+      color: "transparent"
+      border.color: QfTheme.errorColor
+      border.width: 3
+      opacity: 0
+    }
+
+    Rectangle {
+      id: markerDot
+      width: 18
+      height: 18
+      radius: 9
+      x: errorMarker.px - width / 2
+      y: errorMarker.py - height / 2
+      color: QfTheme.errorColor
+      border.color: "white"
+      border.width: 2
+      opacity: 0
+    }
+
+    SequentialAnimation {
+      id: markerAnim
+      loops: 3
+      ParallelAnimation {
+        NumberAnimation {
+          target: markerDot
+          property: "opacity"
+          from: 0.25
+          to: 1.0
+          duration: 250
+        }
+        NumberAnimation {
+          target: markerRing
+          property: "width"
+          from: 16
+          to: 64
+          duration: 650
+        }
+        NumberAnimation {
+          target: markerRing
+          property: "opacity"
+          from: 0.9
+          to: 0.0
+          duration: 650
+        }
+      }
+      NumberAnimation {
+        target: markerDot
+        property: "opacity"
+        to: 0.3
+        duration: 200
+      }
+      onStopped: {
+        markerRing.width = 16;
+        errorMarker.visible = false;
+      }
+    }
+  }
+
+  Connections {
+    target: topologyModel
+    function onHighlightPointRequested(px, py) {
+      errorMarker.px = px;
+      errorMarker.py = py;
+      markerRing.width = 16;
+      errorMarker.visible = true;
+      markerAnim.restart();
+    }
+  }
+
+  // ---- Side panel ----
+  Rectangle {
+    id: panel
+    width: root.panelWidth
+    height: parent.height
+    anchors.right: parent.right
+    color: QfTheme.mainBackgroundColor
+    z: 10
+
+    // Soft shadow on the left edge
+    Rectangle {
+      width: 8
+      height: parent.height
+      anchors.right: parent.left
+      gradient: Gradient {
+        orientation: Gradient.Horizontal
+        GradientStop {
+          position: 0.0
+          color: "transparent"
+        }
+        GradientStop {
+          position: 1.0
+          color: "#33000000"
+        }
+      }
+    }
+
+    // Absorb touches so the map underneath does not react.
+    MouseArea {
+      anchors.fill: parent
+      onClicked: {}
+    }
+
+    ColumnLayout {
+      anchors.fill: parent
+      anchors.topMargin: mainWindow.sceneTopMargin
+      anchors.bottomMargin: mainWindow.sceneBottomMargin
+      spacing: 0
+
+      // ---- Header ----
+      RowLayout {
+        Layout.fillWidth: true
+        Layout.preferredHeight: 56
+        Layout.leftMargin: 8
+        Layout.rightMargin: 6
+        spacing: 4
+
+        QfToolButton {
+          visible: root.showSettings
+          width: 40
+          height: 40
+          round: true
+          bgcolor: "transparent"
+          iconSource: QfTheme.getThemeVectorIcon("ic_arrow_left_white_24dp")
+          iconColor: QfTheme.mainTextColor
+          onClicked: root.showSettings = false
+        }
+
+        IconImage {
+          visible: !root.showSettings
+          Layout.leftMargin: 8
+          Layout.rightMargin: 4
+          source: QfTheme.getThemeVectorIcon("ic_napr_topology_check_white_24dp")
+          sourceSize: Qt.size(24, 24)
+          color: QfTheme.mainColor
+        }
+
+        Label {
+          text: root.showSettings ? qsTr("წესები") : qsTr("ტოპოლოგია")
+          font: QfTheme.strongTitleFont
+          color: QfTheme.mainTextColor
+          elide: Text.ElideRight
+          Layout.fillWidth: true
+        }
+
+        QfToolButton {
+          visible: !root.showSettings
+          width: 40
+          height: 40
+          round: true
+          bgcolor: "transparent"
+          iconSource: QfTheme.getThemeVectorIcon("ic_settings_white_24dp")
+          iconColor: QfTheme.mainTextColor
+          onClicked: root.showSettings = true
+        }
+
+        QfToolButton {
+          width: 40
+          height: 40
+          round: true
+          bgcolor: "transparent"
+          iconSource: QfTheme.getThemeVectorIcon("ic_close_white_24dp")
+          iconColor: QfTheme.mainTextColor
+          onClicked: root.isOpen = false
+        }
+      }
+
+      Rectangle {
+        Layout.fillWidth: true
+        height: 1
+        color: QfTheme.controlBorderColor
+      }
+
+      // =================================================================
+      //  RESULTS VIEW
+      // =================================================================
+      ColumnLayout {
+        Layout.fillWidth: true
+        Layout.fillHeight: true
+        visible: !root.showSettings
+        spacing: 0
+
+        QfButton {
+          Layout.fillWidth: true
+          Layout.leftMargin: 12
+          Layout.rightMargin: 12
+          Layout.topMargin: 12
+          text: qsTr("შემოწმება")
+          icon.source: QfTheme.getThemeVectorIcon("ic_napr_topology_check_white_24dp")
+          bgcolor: QfTheme.mainColor
+          color: "white"
+          onClicked: topologyModel.runChecksForCurrentExtent()
+        }
+
+        Label {
+          Layout.fillWidth: true
+          Layout.leftMargin: 16
+          Layout.rightMargin: 16
+          Layout.topMargin: 4
+          text: qsTr("მოწმდება რუკის მიმდინარე ხედი")
+          font: QfTheme.tinyFont
+          color: QfTheme.secondaryTextColor
+          horizontalAlignment: Text.AlignHCenter
+          wrapMode: Text.WordWrap
+        }
+
+        // Status banner
+        Rectangle {
+          Layout.fillWidth: true
+          Layout.leftMargin: 12
+          Layout.rightMargin: 12
+          Layout.topMargin: 10
+          Layout.preferredHeight: statusLabel.implicitHeight + 16
+          visible: topologyModel.statusText !== ""
+          radius: 10
+          color: root.tint(topologyModel.hasErrors ? QfTheme.errorColor : QfTheme.goodColor, 0.12)
+
+          Label {
+            id: statusLabel
+            anchors.fill: parent
+            anchors.margins: 8
+            text: topologyModel.statusText
+            font: QfTheme.tipFont
+            color: topologyModel.hasErrors ? QfTheme.errorColor : QfTheme.goodColor
+            wrapMode: Text.WordWrap
+            verticalAlignment: Text.AlignVCenter
+          }
+        }
+
+        // Error list grouped by rule
+        ListView {
+          id: errorList
+          Layout.fillWidth: true
+          Layout.fillHeight: true
+          Layout.topMargin: 10
+          model: topologyModel
+          clip: true
+          visible: topologyModel.count > 0
+          ScrollBar.vertical: QfScrollBar {}
+
+          section.property: "sectionText"
+          section.delegate: Rectangle {
+            width: errorList.width
+            height: 38
+            color: QfTheme.groupBoxBackgroundColor
+
+            RowLayout {
+              anchors.fill: parent
+              anchors.leftMargin: 14
+              anchors.rightMargin: 10
+              spacing: 8
+
+              Rectangle {
+                width: 8
+                height: 8
+                radius: 4
+                color: QfTheme.errorColor
+              }
+
+              Label {
+                text: section
+                font: QfTheme.strongTipFont
+                color: QfTheme.mainTextColor
+                elide: Text.ElideRight
+                Layout.fillWidth: true
+              }
+            }
+          }
+
+          delegate: Rectangle {
+            width: errorList.width
+            height: 48
+            color: delegateArea.pressed ? root.tint(QfTheme.mainColor, 0.12) : "transparent"
+
+            RowLayout {
+              anchors.fill: parent
+              anchors.leftMargin: 30
+              anchors.rightMargin: 10
+              spacing: 8
+
+              Label {
+                text: qsTr("შეცდომა #%1").arg(model.displayIndex)
+                font: QfTheme.defaultFont
+                color: QfTheme.mainTextColor
+                Layout.fillWidth: true
+              }
+
+              IconImage {
+                source: QfTheme.getThemeVectorIcon("ic_chevron_right_white_24dp")
+                sourceSize: Qt.size(20, 20)
+                color: model.hasGeometry ? QfTheme.mainColor : QfTheme.mainTextDisabledColor
+              }
+            }
+
+            Rectangle {
+              width: parent.width - 30
+              height: 1
+              color: QfTheme.controlBorderColor
+              anchors.bottom: parent.bottom
+              anchors.right: parent.right
+            }
+
+            MouseArea {
+              id: delegateArea
+              anchors.fill: parent
+              onClicked: {
+                if (model.hasGeometry)
+                  topologyModel.zoomToError(index);
+              }
+            }
+          }
+        }
+
+        // Empty state before the first check
+        ColumnLayout {
+          Layout.fillWidth: true
+          Layout.fillHeight: true
+          visible: !topologyModel.checked
+          spacing: 10
+
+          Item {
+            Layout.fillHeight: true
+          }
+          IconImage {
+            Layout.alignment: Qt.AlignHCenter
+            source: QfTheme.getThemeVectorIcon("ic_napr_topology_check_white_24dp")
+            sourceSize: Qt.size(56, 56)
+            color: QfTheme.mainTextDisabledColor
+          }
+          Label {
+            Layout.fillWidth: true
+            Layout.leftMargin: 16
+            Layout.rightMargin: 16
+            text: qsTr("დააჭირეთ „შემოწმება“-ს ხარვეზების მოსაძებნად")
+            font: QfTheme.tipFont
+            color: QfTheme.secondaryTextColor
+            horizontalAlignment: Text.AlignHCenter
+            wrapMode: Text.WordWrap
+          }
+          Item {
+            Layout.fillHeight: true
+          }
+        }
+
+        // No errors found
+        ColumnLayout {
+          Layout.fillWidth: true
+          Layout.fillHeight: true
+          visible: topologyModel.checked && topologyModel.count === 0
+          spacing: 10
+
+          Item {
+            Layout.fillHeight: true
+          }
+          Rectangle {
+            Layout.alignment: Qt.AlignHCenter
+            width: 64
+            height: 64
+            radius: 32
+            color: root.tint(QfTheme.goodColor, 0.14)
+            IconImage {
+              anchors.centerIn: parent
+              source: QfTheme.getThemeVectorIcon("ic_check_white_24dp")
+              sourceSize: Qt.size(36, 36)
+              color: QfTheme.goodColor
+            }
+          }
+          Label {
+            Layout.fillWidth: true
+            text: qsTr("ხარვეზი არ აღმოჩენილა")
+            font: QfTheme.strongFont
+            color: QfTheme.goodColor
+            horizontalAlignment: Text.AlignHCenter
+          }
+          Item {
+            Layout.fillHeight: true
+          }
+        }
+      }
+
+      // =================================================================
+      //  SETTINGS VIEW (rule editor)
+      // =================================================================
+      ColumnLayout {
+        Layout.fillWidth: true
+        Layout.fillHeight: true
+        visible: root.showSettings
+        spacing: 0
+
+        ListView {
+          id: rulesList
+          Layout.fillWidth: true
+          Layout.fillHeight: true
+          clip: true
+          model: topologyModel.rules
+          ScrollBar.vertical: QfScrollBar {}
+
+          header: Label {
+            width: rulesList.width
+            leftPadding: 16
+            topPadding: 12
+            bottomPadding: 6
+            text: qsTr("აქტიური წესები")
+            font: QfTheme.strongTipFont
+            color: QfTheme.secondaryTextColor
+          }
+
+          delegate: Rectangle {
+            width: rulesList.width
+            height: 60
+            color: "transparent"
+
+            RowLayout {
+              anchors.fill: parent
+              anchors.leftMargin: 4
+              anchors.rightMargin: 6
+              spacing: 4
+
+              QfSwitch {
+                checked: model.ruleEnabled
+                Layout.preferredWidth: 60
+                onToggled: topologyModel.rules.setRuleEnabled(index, checked)
+              }
+
+              ColumnLayout {
+                Layout.fillWidth: true
+                spacing: 2
+
+                Label {
+                  text: model.ruleTypeName
+                  font: QfTheme.defaultFont
+                  color: model.ruleEnabled ? QfTheme.mainTextColor : QfTheme.mainTextDisabledColor
+                  Layout.fillWidth: true
+                  elide: Text.ElideRight
+                }
+                Label {
+                  text: model.needsLayer2 ? (model.layer1 + "  →  " + model.layer2) : model.layer1
+                  font: QfTheme.tinyFont
+                  color: QfTheme.secondaryTextColor
+                  Layout.fillWidth: true
+                  elide: Text.ElideRight
+                }
+              }
+
+              QfToolButton {
+                width: 40
+                height: 40
+                round: true
+                bgcolor: "transparent"
+                iconSource: QfTheme.getThemeVectorIcon("ic_delete_forever_white_24dp")
+                iconColor: QfTheme.errorColor
+                onClicked: topologyModel.rules.removeRule(index)
+              }
+            }
+
+            Rectangle {
+              width: parent.width - 16
+              height: 1
+              color: QfTheme.controlBorderColor
+              anchors.bottom: parent.bottom
+              anchors.horizontalCenter: parent.horizontalCenter
+            }
+          }
+
+          Label {
+            anchors.centerIn: parent
+            visible: topologyModel.rules.count === 0
+            text: qsTr("წესები არ არის.\nდაამატეთ ქვემოთ.")
+            horizontalAlignment: Text.AlignHCenter
+            font: QfTheme.tipFont
+            color: QfTheme.secondaryTextColor
+          }
+        }
+
+        Rectangle {
+          Layout.fillWidth: true
+          height: 1
+          color: QfTheme.controlBorderColor
+        }
+
+        // Add-rule editor
+        ColumnLayout {
+          Layout.fillWidth: true
+          Layout.margins: 12
+          spacing: 6
+
+          Label {
+            text: qsTr("ახალი წესი")
+            font: QfTheme.strongTipFont
+            color: QfTheme.secondaryTextColor
+          }
+
+          QfComboBox {
+            id: ruleTypeCombo
+            Layout.fillWidth: true
+            font: QfTheme.defaultFont
+            model: topologyModel.rules.ruleTypeNames()
+            currentIndex: 5 // "must not overlap"
+          }
+
+          QfComboBox {
+            id: layer1Combo
+            Layout.fillWidth: true
+            font: QfTheme.defaultFont
+            model: root.layerNames
+            displayText: currentIndex < 0 ? qsTr("ფენა #1") : currentText
+          }
+
+          QfComboBox {
+            id: layer2Combo
+            Layout.fillWidth: true
+            font: QfTheme.defaultFont
+            model: root.layerNames
+            displayText: currentIndex < 0 ? qsTr("ფენა #2") : currentText
+            enabled: topologyModel.rules.ruleTypeNeedsLayer2(ruleTypeCombo.currentIndex)
+            opacity: enabled ? 1.0 : 0.4
+          }
+
+          RowLayout {
+            Layout.fillWidth: true
+            spacing: 4
+
+            QfButton {
+              Layout.fillWidth: true
+              text: qsTr("დამატება")
+              icon.source: QfTheme.getThemeVectorIcon("ic_add_white_24dp")
+              bgcolor: QfTheme.mainColor
+              color: "white"
+              onClicked: {
+                if (layer1Combo.currentIndex < 0)
+                  return;
+                var needs2 = topologyModel.rules.ruleTypeNeedsLayer2(ruleTypeCombo.currentIndex);
+                if (needs2 && layer2Combo.currentIndex < 0)
+                  return;
+                topologyModel.rules.addRule(ruleTypeCombo.currentIndex, layer1Combo.currentText, needs2 ? layer2Combo.currentText : "");
+              }
+            }
+
+            QfButton {
+              text: qsTr("ნაგულისხმევი")
+              bgcolor: "transparent"
+              color: QfTheme.mainColor
+              onClicked: topologyModel.rules.resetToDefaults()
+            }
+          }
+        }
+      }
+    }
+  }
+}
