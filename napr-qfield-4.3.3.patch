+void VillageSelectorModel::setSearchText( const QString &text )
+{
+  const QString t = text.trimmed();
+  if ( t == mSearchText )
+    return;
+  mSearchText = t;
+  rebuild();
+  emit searchTextChanged();
+}
+
+QString VillageSelectorModel::selectedSummary() const
+{
+  QStringList names;
+  for ( const Municipality &mu : mMunicipalities )
+  {
+    for ( const Village &v : mu.villages )
+    {
+      if ( mSelected.contains( code( mu.zone, v.sector ) ) )
+        names << v.name;
+    }
+  }
+  return names.join( QStringLiteral( ", " ) );
+}
+
+void VillageSelectorModel::toggleExpanded( int row )
+{
+  if ( row < 0 || row >= mRows.size() || mRows.at( row ).type != MunicipalityRow || !mSearchText.isEmpty() )
+    return;
+
+  const Municipality &mu = mMunicipalities.at( mRows.at( row ).municipality );
+  const int n = static_cast<int>( mu.villages.size() );
+  if ( n == 0 )
+    return;
+
+  if ( mExpanded.contains( mu.zone ) )
+  {
+    beginRemoveRows( QModelIndex(), row + 1, row + n );
+    mExpanded.remove( mu.zone );
+    mRows = buildRows();
+    endRemoveRows();
+  }
+  else
+  {
+    beginInsertRows( QModelIndex(), row + 1, row + n );
+    mExpanded.insert( mu.zone );
+    mRows = buildRows();
+    endInsertRows();
+  }
+  const QModelIndex idx = index( row );
+  emit dataChanged( idx, idx, { ExpandedRole } );
+}
+
+void VillageSelectorModel::collapseAll()
+{
+  if ( mExpanded.isEmpty() )
+    return;
+  mExpanded.clear();
+  rebuild();
+}
+
+void VillageSelectorModel::toggleChecked( int row )
+{
+  if ( row < 0 || row >= mRows.size() )
+    return;
+
+  const Row &r = mRows.at( row );
+  const Municipality &mu = mMunicipalities.at( r.municipality );
+  if ( r.type == VillageRow )
+  {
+    const QString c = code( mu.zone, mu.villages.at( r.village ).sector );
+    if ( mSelected.contains( c ) )
+      mSelected.remove( c );
+    else
+      mSelected.insert( c );
+  }
+  else
+  {
+    const bool allSelected = municipalitySelectedCount( r.municipality ) == mu.villages.size();
+    for ( const Village &v : mu.villages )
+    {
+      if ( allSelected )
+        mSelected.remove( code( mu.zone, v.sector ) );
+      else
+        mSelected.insert( code( mu.zone, v.sector ) );
+    }
+  }
+
+  notifyMunicipality( r.municipality );
+  saveSelection();
+  emit selectionChanged();
+}
+
+void VillageSelectorModel::notifyMunicipality( int m )
+{
+  int first = -1;
+  int last = -1;
+  for ( int i = 0; i < mRows.size(); ++i )
+  {
+    if ( mRows.at( i ).municipality == m )
+    {
+      if ( first < 0 )
+        first = i;
+      last = i;
+    }
+  }
+  if ( first >= 0 )
+    emit dataChanged( index( first ), index( last ), { CheckStateRole, SelectedCountRole } );
+}
+
+void VillageSelectorModel::clearSelection()
+{
+  if ( mSelected.isEmpty() )
+    return;
+  mSelected.clear();
+  if ( !mRows.isEmpty() )
+    emit dataChanged( index( 0 ), index( static_cast<int>( mRows.size() ) - 1 ), { CheckStateRole, SelectedCountRole } );
+  saveSelection();
+  emit selectionChanged();
+}
+
+int VillageSelectorModel::targetLayerCount()
+{
+  int count = 0;
+  const QMap<QString, QgsMapLayer *> layers = QgsProject::instance()->mapLayers();
+  for ( QgsMapLayer *layer : layers )
+  {
+    if ( !qobject_cast<QgsVectorLayer *>( layer ) )
+      continue;
+    if ( layer->providerType().compare( QLatin1String( "WFS" ), Qt::CaseInsensitive ) != 0 )
+    {
+      if ( mOriginalSources.contains( layer->id() ) ) // currently switched to the offline copy
+        ++count;
+      continue;
+    }
+    const QString source = layer->source();
+    if ( mOriginalSources.contains( layer->id() ) || usesZoneVariables( source ) || originalSourcesByKey().contains( wfsKey( source ) ) )
+      ++count;
+  }
+  return count;
+}
