+      if ( QFileInfo::exists( target ) )
+      {
+        if ( !isProjectFile )
+          continue;
+        QFile sourceFile( source );
+        QFile targetFile( target );
+        if ( sourceFile.open( QIODevice::ReadOnly ) && targetFile.open( QIODevice::ReadOnly ) && sourceFile.readAll() == targetFile.readAll() )
+          continue;
+        targetFile.close();
+        QFile::remove( target );
+      }
+      QFile::copy( source, target );
+      QFile::setPermissions( target, QFile::ReadOwner | QFile::WriteOwner | QFile::ReadUser | QFile::WriteUser );
+    }
+
+    if ( firstDeployment )
+    {
+      const QStringList projects = QDir( georgiaTarget ).entryList( { QStringLiteral( "*.qgz" ), QStringLiteral( "*.qgs" ) }, QDir::Files, QDir::Name );
+      QSettings settings;
+      if ( !projects.isEmpty() && settings.value( QStringLiteral( "QField/lastProjectFilePath" ) ).toString().isEmpty() && settings.value( QStringLiteral( "QField/defaultProject" ) ).toString().isEmpty() )
+      {
+        settings.setValue( QStringLiteral( "QField/lastProjectFilePath" ), QStringLiteral( "%1/%2" ).arg( georgiaTarget, projects.first() ) );
+      }
+    }
+  }
 }
 
 void QfPlatformUtilities::initSystem()
