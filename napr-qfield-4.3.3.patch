+QString VillageSelectorModel::buildFilter( const QString &originalFilter, const QStringList &codes )
+{
+  // The NAPR project uses three kinds of @myzone / @orzone filters. Each one is
+  // rebuilt as a plain OR list (one term per village) so the server receives a
+  // simple OGC filter, whatever the number of selected villages.
+  enum class Kind
+  {
+    InventoryCodes, // "USAIDCODE" LIKE '<8812%>' / "PNEWCODE" LIKE '8812%'
+    CadastralCode,  // "CADCODE" LIKE '88.12%'
+    ZoneSector,     // "ZONE" = '88' AND "SECTOR" = '12'
+    Generic,        // anything else: substitute the variables with a literal
+  };
+
+  Kind kind = Kind::Generic;
+  if ( originalFilter.contains( QLatin1String( "USAIDCODE" ), Qt::CaseInsensitive ) || originalFilter.contains( QLatin1String( "PNEWCODE" ), Qt::CaseInsensitive ) )
+    kind = Kind::InventoryCodes;
+  else if ( originalFilter.contains( QLatin1String( "CADCODE" ), Qt::CaseInsensitive ) )
+    kind = Kind::CadastralCode;
+  else if ( originalFilter.contains( QLatin1String( "\"ZONE\"" ), Qt::CaseInsensitive ) && originalFilter.contains( QLatin1String( "\"SECTOR\"" ), Qt::CaseInsensitive ) )
+    kind = Kind::ZoneSector;
+
+  QStringList parts;
+  for ( const QString &c : codes )
+  {
+    const QString zone = c.section( QLatin1Char( '.' ), 0, 0 );
+    const QString sector = c.section( QLatin1Char( '.' ), 1, 1 );
+    switch ( kind )
+    {
+      case Kind::InventoryCodes:
+        // USAIDCODE is matched with the angle brackets kept ('<8812%>'), exactly as the
+        // original replace(@myzone, '.', '') produced; PNEWCODE without them.
+        parts << QStringLiteral( "( \"USAIDCODE\" LIKE '<%1%2%>' OR \"PNEWCODE\" LIKE '%1%2%' )" ).arg( zone, sector );
+        break;
+      case Kind::CadastralCode:
+        parts << QStringLiteral( "\"CADCODE\" LIKE '%1.%2%'" ).arg( zone, sector );
+        break;
+      case Kind::ZoneSector:
+        parts << QStringLiteral( "( \"ZONE\" = '%1' AND \"SECTOR\" = '%2' )" ).arg( zone, sector );
+        break;
+      case Kind::Generic:
+      {
+        QString expr = originalFilter;
+        const QString literal = QStringLiteral( "'<%1%>'" ).arg( c );
+        expr.replace( QLatin1String( "@myzone" ), literal, Qt::CaseInsensitive );
+        expr.replace( QLatin1String( "@orzone" ), literal, Qt::CaseInsensitive );
+        parts << QStringLiteral( "( %1 )" ).arg( expr );
+        break;
+      }
+    }
+  }
+  return parts.join( QStringLiteral( " OR " ) );
+}
+
+QString VillageSelectorModel::apply()
+{
+  const QStringList codes = sortedSelection();
+  if ( codes.isEmpty() )
+    return tr( "აირჩიეთ მინიმუმ ერთი სოფელი" );
+
+  // Keep the legacy project variables meaningful for anything else that reads them.
+  QgsProject *project = QgsProject::instance();
+  QgsExpressionContextUtils::setProjectVariable( project, QStringLiteral( "myzone" ), QStringLiteral( "<%1%>" ).arg( codes.at( 0 ) ) );
+  QgsExpressionContextUtils::setProjectVariable( project, QStringLiteral( "orzone" ), QStringLiteral( "<%1%>" ).arg( codes.size() > 1 ? codes.at( 1 ) : codes.at( 0 ) ) );
+  QgsExpressionContextUtils::setProjectVariable( project, QStringLiteral( "villages" ), codes.join( QLatin1Char( ',' ) ) );
+
+  int updated = 0;
+  const QMap<QString, QgsMapLayer *> layers = project->mapLayers();
+  for ( QgsMapLayer *layer : layers )
+  {
+    QgsVectorLayer *vl = qobject_cast<QgsVectorLayer *>( layer );
+    if ( !vl )
+      continue;
+
+    const QString original = originalSourceFor( vl );
+    if ( original.isEmpty() )
+      continue;
+
+    QgsDataSourceUri uri( original );
+    const QString filter = buildFilter( uri.param( QStringLiteral( "filter" ) ), codes );
+    setVillageFilter( uri, filter );
+    if ( needsFixedVersion( uri, vl->name() ) )
+      forceWfsVersion( uri );
+    SurveyorAccess::applyToUri( uri );
+
+    QgsDataProvider::ProviderOptions options;
+    options.transformContext = project->transformContext();
+    vl->setDataSource( uri.uri( false ), vl->name(), QStringLiteral( "WFS" ), options, false );
+    vl->setReadOnly( false );
+    vl->triggerRepaint();
+    ++updated;
+  }
+
+  saveSelection();
+  if ( offlineActive() )
+    clearOfflineState(); // back on the live server
+
+  if ( updated == 0 )
+    return tr( "პროექტში ვერ მოიძებნა ფენა, რომელიც @myzone / @orzone ფილტრს იყენებს" );
+  return QString();
+}
+
+int VillageSelectorModel::enforceLayerVersions()
+{
+  int changed = 0;
+  QgsProject *project = QgsProject::instance();
+  const QMap<QString, QgsMapLayer *> layers = project->mapLayers();
+  for ( QgsMapLayer *layer : layers )
+  {
+    QgsVectorLayer *vl = qobject_cast<QgsVectorLayer *>( layer );
+    if ( !vl || vl->providerType().compare( QLatin1String( "WFS" ), Qt::CaseInsensitive ) != 0 )
+      continue;
+
+    QgsDataSourceUri uri( vl->source() );
+    if ( !needsFixedVersion( uri, vl->name() ) || !forceWfsVersion( uri ) )
+      continue;
+    SurveyorAccess::applyToUri( uri );
+
+    // Keep the remembered original (village filter) source in line as well
+    const QString original = mOriginalSources.value( vl->id() );
+    if ( !original.isEmpty() )
+    {
+      QgsDataSourceUri originalUri( original );
+      forceWfsVersion( originalUri );
+      mOriginalSources.insert( vl->id(), originalUri.uri( false ) );
+    }
+
+    QgsDataProvider::ProviderOptions options;
+    options.transformContext = project->transformContext();
+    const bool readOnly = vl->readOnly();
+    vl->setDataSource( uri.uri( false ), vl->name(), QStringLiteral( "WFS" ), options, false );
+    vl->setReadOnly( readOnly );
+    vl->triggerRepaint();
+    ++changed;
+  }
+  return changed;
+}
+
+bool VillageSelectorModel::applySaved()
+{
+  const bool preprocessed = sPreprocessedOnRead;
+  sPreprocessedOnRead = false;
+
+  // Field-work layers matched by name (other projects / other type names)
+  enforceLayerVersions();
+  // NAPR WMS layers are not touched while reading: give / take their credentials now
+  SurveyorAccess::instance()->refreshLayers();
+
+  if ( offlineActive() && switchToOffline() )
+    return true;
+
+  if ( mSelected.isEmpty() || targetLayerCount() == 0 )
+    return false;
+
+  if ( preprocessed )
+  {
+    // The filters were already rewritten while reading the project; only keep
+    // the legacy variables in sync, no need to reload the layers again.
+    const QStringList codes = sortedSelection();
+    QgsProject *project = QgsProject::instance();
+    QgsExpressionContextUtils::setProjectVariable( project, QStringLiteral( "myzone" ), QStringLiteral( "<%1%>" ).arg( codes.at( 0 ) ) );
+    QgsExpressionContextUtils::setProjectVariable( project, QStringLiteral( "orzone" ), QStringLiteral( "<%1%>" ).arg( codes.size() > 1 ? codes.at( 1 ) : codes.at( 0 ) ) );
+    QgsExpressionContextUtils::setProjectVariable( project, QStringLiteral( "villages" ), codes.join( QLatin1Char( ',' ) ) );
+    return true;
+  }
+
+  return apply().isEmpty();
+}
+
+// ---------------------------------------------------------------------------
+//  Offline copy
+// ---------------------------------------------------------------------------
+
+QString VillageSelectorModel::originalSourceFor( QgsVectorLayer *layer )
+{
+  QString original = mOriginalSources.value( layer->id() );
+  if ( !original.isEmpty() )
+    return original;
+
+  if ( layer->providerType().compare( QLatin1String( "WFS" ), Qt::CaseInsensitive ) != 0 )
+    return QString();
+
+  const QString source = layer->source();
+  if ( usesZoneVariables( source ) )
+    original = source;
+  else
+    original = originalSourcesByKey().value( wfsKey( source ) );
+  if ( !original.isEmpty() )
+    mOriginalSources.insert( layer->id(), original );
+  return original;
+}
+
+bool VillageSelectorModel::offlineActive() const
+{
+  return QSettings().value( OFFLINE_ACTIVE_KEY, false ).toBool();
+}
+
+QString VillageSelectorModel::offlineInfo() const
+{
+  QSettings settings;
+  if ( !settings.value( OFFLINE_ACTIVE_KEY, false ).toBool() )
+    return QString();
+  const QDateTime date = settings.value( OFFLINE_DATE_KEY ).toDateTime();
+  const int villages = static_cast<int>( settings.value( OFFLINE_VILLAGES_KEY ).toStringList().size() );
+  return tr( "შენახულია %1 · %2 სოფელი" ).arg( date.toString( QStringLiteral( "dd.MM.yyyy HH:mm" ) ) ).arg( villages );
+}
+
+void VillageSelectorModel::setBusy( bool busy )
+{
+  if ( mBusy == busy )
+    return;
+  mBusy = busy;
+  emit busyChanged();
+}
+
+void VillageSelectorModel::setProgressText( const QString &text )
+{
+  if ( mProgressText == text )
+    return;
+  mProgressText = text;
+  emit progressChanged();
+}
+
+void VillageSelectorModel::clearOfflineState()
+{
+  QSettings settings;
+  settings.setValue( OFFLINE_ACTIVE_KEY, false );
+  emit offlineChanged();
+}
+
+QString VillageSelectorModel::saveOffline()
+{
+  if ( mBusy )
+    return tr( "შენახვა უკვე მიმდინარეობს" );
+  if ( offlineActive() )
+    return tr( "ჯერ დაბრუნდით ლაივ რეჟიმში" );
+  if ( !SurveyorAccess::isAuthorized() )
+    return tr( "ამზომველის პ/ნ-ს არ აქვს წვდომა პროგრამაზე" );
+  const QStringList codes = sortedSelection();
+  if ( codes.isEmpty() )
+    return tr( "ჯერ აირჩიეთ და ჩატვირთეთ სოფლები" );
+
+  struct Job
+  {
+      QString layerId;
+      QString name;
+      QString original;
+      QString source;
+      QString table;
+  };
+  QVector<Job> jobs;
+
+  QgsProject *project = QgsProject::instance();
+  const QMap<QString, QgsMapLayer *> layers = project->mapLayers();
+  for ( QgsMapLayer *layer : layers )
+  {
+    QgsVectorLayer *vl = qobject_cast<QgsVectorLayer *>( layer );
+    if ( !vl )
+      continue;
+    const QString original = originalSourceFor( vl );
+    if ( original.isEmpty() )
+      continue;
+
+    QgsDataSourceUri uri( original );
+    const QString filter = buildFilter( uri.param( QStringLiteral( "filter" ) ), codes );
+    setVillageFilter( uri, filter );
+
+    QString table = uri.param( QStringLiteral( "typename" ) ).section( QLatin1Char( ':' ), -1 ).toLower();
+    table.replace( QRegularExpression( QStringLiteral( "[^a-z0-9_]" ) ), QStringLiteral( "_" ) );
+    table = QStringLiteral( "l%1_%2" ).arg( jobs.size() ).arg( table );
+
+    jobs.append( { vl->id(), vl->name(), original, uri.uri( false ), table } );
+  }
+
+  if ( jobs.isEmpty() )
+    return tr( "პროექტში ვერ მოიძებნა სოფლების მიხედვით ფილტრირებული ფენა" );
+
+  const QString dir = QStandardPaths::writableLocation( QStandardPaths::AppDataLocation ) + QStringLiteral( "/georgia_offline" );
+  QDir().mkpath( dir );
+  const QString path = QStringLiteral( "%1/offline_%2.gpkg" ).arg( dir, QDateTime::currentDateTime().toString( QStringLiteral( "yyyyMMdd_HHmmss" ) ) );
+
+  delete mFeedback;
+  mFeedback = new QgsFeedback();
+  QgsFeedback *feedback = mFeedback;
+  const QgsCoordinateTransformContext transformContext = project->transformContext();
+
+  setBusy( true );
+  setProgressText( tr( "მზადება..." ) );
+
+  auto *watcher = new QFutureWatcher<QStringList>( this );
+  connect( watcher, &QFutureWatcher<QStringList>::finished, this, [this, watcher, jobs, path, codes, feedback] {
+    const QStringList results = watcher->result(); // one entry per job: empty = OK, otherwise the error
+    watcher->deleteLater();
+
+    const bool canceled = feedback->isCanceled();
+    QStringList failed;
+    int succeeded = 0;
+    for ( int i = 0; i < results.size(); ++i )
+    {
+      if ( results.at( i ).isEmpty() )
+        ++succeeded;
+      else
+        failed << results.at( i );
+    }
+
+    if ( canceled || succeeded == 0 )
+    {
+      QFile::remove( path );
+      setBusy( false );
+      setProgressText( QString() );
+      emit offlineFinished( false, canceled ? tr( "შენახვა გაუქმდა" ) : tr( "ვერ შეინახა: %1" ).arg( failed.join( QStringLiteral( "; " ) ) ) );
+      return;
+    }
+
+    // Switch the downloaded layers to the local copy (read-only).
+    QgsProject *project = QgsProject::instance();
+    QgsDataProvider::ProviderOptions options;
+    options.transformContext = project->transformContext();
+    QVariantMap tables;
+    for ( int i = 0; i < jobs.size() && i < results.size(); ++i )
+    {
+      if ( !results.at( i ).isEmpty() )
+        continue;
+      const Job &job = jobs.at( i );
+      tables.insert( wfsKey( job.original ), job.table );
+      if ( QgsVectorLayer *vl = qobject_cast<QgsVectorLayer *>( project->mapLayer( job.layerId ) ) )
+      {
+        mOriginalSources.insert( vl->id(), job.original );
+        vl->setDataSource( QStringLiteral( "%1|layername=%2" ).arg( path, job.table ), vl->name(), QStringLiteral( "ogr" ), options, false );
+        vl->setReadOnly( true );
+        vl->triggerRepaint();
+      }
+    }
+
+    QSettings settings;
+    const QString previous = settings.value( OFFLINE_FILE_KEY ).toString();
+    settings.setValue( OFFLINE_FILE_KEY, path );
+    settings.setValue( OFFLINE_LAYERS_KEY, tables );
+    settings.setValue( OFFLINE_DATE_KEY, QDateTime::currentDateTime() );
+    settings.setValue( OFFLINE_VILLAGES_KEY, codes );
+    settings.setValue( OFFLINE_ACTIVE_KEY, true );
+    if ( !previous.isEmpty() && previous != path )
+      QFile::remove( previous );
+
+    setBusy( false );
+    setProgressText( QString() );
+    emit offlineChanged();
+    emit offlineFinished( true, failed.isEmpty() ? tr( "ოფლაინ შენახულია: %1 ფენა" ).arg( succeeded ) : tr( "შენახულია %1 ფენა, ვერ შეინახა: %2" ).arg( succeeded ).arg( failed.join( QStringLiteral( "; " ) ) ) );
+  } );
+
+  // The download runs on a worker thread with its own layer objects, so the
+  // map stays usable while the villages are being saved.
+  watcher->setFuture( QtConcurrent::run( [this, jobs, path, feedback, transformContext]() -> QStringList {
+    QStringList results;
+    bool fileCreated = false;
+    for ( int i = 0; i < jobs.size(); ++i )
+    {
+      if ( feedback->isCanceled() )
+      {
+        results << tr( "გაუქმდა" );
+        continue;
+      }
+      const Job &job = jobs.at( i );
+      const QString progress = tr( "ინახება: %1 (%2/%3)" ).arg( job.name ).arg( i + 1 ).arg( jobs.size() );
+      QMetaObject::invokeMethod( this, [this, progress] { setProgressText( progress ); }, Qt::QueuedConnection );
+
+      QgsVectorLayer::LayerOptions layerOptions( transformContext );
+      layerOptions.loadDefaultStyle = false;
+      QgsVectorLayer layer( job.source, job.name, QStringLiteral( "WFS" ), layerOptions );
+      if ( !layer.isValid() )
+      {
+        results << tr( "%1: სერვერთან კავშირი ვერ დამყარდა" ).arg( job.name );
+        continue;
+      }
+
+      QgsVectorFileWriter::SaveVectorOptions saveOptions;
+      saveOptions.driverName = QStringLiteral( "GPKG" );
+      saveOptions.layerName = job.table;
+      saveOptions.fileEncoding = QStringLiteral( "UTF-8" );
+      saveOptions.actionOnExistingFile = fileCreated ? QgsVectorFileWriter::CreateOrOverwriteLayer : QgsVectorFileWriter::CreateOrOverwriteFile;
+      saveOptions.feedback = feedback;
+
+      QString error;
+      const QgsVectorFileWriter::WriterError result = QgsVectorFileWriter::writeAsVectorFormatV3( &layer, path, transformContext, saveOptions, &error );
+      if ( result != QgsVectorFileWriter::NoError )
+      {
+        results << QStringLiteral( "%1: %2" ).arg( job.name, error );
+        continue;
+      }
+      fileCreated = true;
+      results << QString();
+    }
+    return results;
+  } ) );
+
+  return QString();
+}
+
+void VillageSelectorModel::cancelOffline()
+{
+  if ( mFeedback )
+    mFeedback->cancel();
+}
+
+QString VillageSelectorModel::goLive()
+{
+  if ( mBusy )
+    return tr( "დაელოდეთ შენახვის დასრულებას" );
+  // apply() rebuilds every village layer from its original WFS source with the
+  // current selection and clears the offline flag.
+  return apply();
+}
+
+bool VillageSelectorModel::switchToOffline()
+{
+  QSettings settings;
+  const QString path = settings.value( OFFLINE_FILE_KEY ).toString();
+  const QVariantMap tables = settings.value( OFFLINE_LAYERS_KEY ).toMap();
+  if ( path.isEmpty() || !QFileInfo::exists( path ) || tables.isEmpty() )
+  {
+    clearOfflineState();
+    return false;
+  }
+
+  QgsProject *project = QgsProject::instance();
+  QgsDataProvider::ProviderOptions options;
+  options.transformContext = project->transformContext();
+
+  int switched = 0;
+  const QMap<QString, QgsMapLayer *> layers = project->mapLayers();
+  for ( QgsMapLayer *layer : layers )
+  {
+    QgsVectorLayer *vl = qobject_cast<QgsVectorLayer *>( layer );
+    if ( !vl )
+      continue;
+    const QString original = originalSourceFor( vl );
+    if ( original.isEmpty() )
+      continue;
+    const QString table = tables.value( wfsKey( original ) ).toString();
+    if ( table.isEmpty() )
+      continue;
+    vl->setDataSource( QStringLiteral( "%1|layername=%2" ).arg( path, table ), vl->name(), QStringLiteral( "ogr" ), options, false );
+    vl->setReadOnly( true );
+    vl->triggerRepaint();
+    ++switched;
+  }
+
+  if ( switched > 0 )
+  {
+    const QStringList codes = settings.value( OFFLINE_VILLAGES_KEY ).toStringList();
+    if ( !codes.isEmpty() )
+    {
+      QgsExpressionContextUtils::setProjectVariable( project, QStringLiteral( "myzone" ), QStringLiteral( "<%1%>" ).arg( codes.at( 0 ) ) );
+      QgsExpressionContextUtils::setProjectVariable( project, QStringLiteral( "orzone" ), QStringLiteral( "<%1%>" ).arg( codes.size() > 1 ? codes.at( 1 ) : codes.at( 0 ) ) );
+      QgsExpressionContextUtils::setProjectVariable( project, QStringLiteral( "villages" ), codes.join( QLatin1Char( ',' ) ) );
+    }
+  }
+  return switched > 0;
+}
