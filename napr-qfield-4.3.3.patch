+#ifndef DEFAULTVALUESMODEL_H
+#define DEFAULTVALUESMODEL_H
+
+#include <QAbstractListModel>
+#include <QVariantList>
+
+/**
+ * Georgia QField: the "field work defaults" of the project.
+ *
+ * The project's forms take many default values from variables (e.g. the TAG
+ * field defaults to @Tag, SOFLIS_STATUSI to @SoflisStatusi). This model finds
+ * every such variable used in a default value expression of the project's
+ * vector layers and lists it with the field's alias as a title. When the field
+ * uses a value map, its choices are offered as options.
+ *
+ * Values are stored as QField global variables (the same storage as QField's
+ * own variables editor), so they persist and apply to every new feature.
+ */
+class DefaultValuesModel : public QAbstractListModel
+{
+    Q_OBJECT
+
+    Q_PROPERTY( int setCount READ setCount NOTIFY valuesChanged )
+    Q_PROPERTY( bool surveyorAuthorized READ surveyorAuthorized NOTIFY valuesChanged )
+    Q_PROPERTY( QString surveyorName READ surveyorName NOTIFY valuesChanged )
+
+  public:
+    enum Roles
+    {
+      VariableRole = Qt::UserRole + 1,
+      TitleRole,
+      LayerNameRole,
+      FieldNameRole,
+      ValueRole,         //!< current value as text ("" = not set)
+      ValueLabelRole,    //!< value map description of the current value
+      OptionsRole,       //!< list of { value, label } (empty for free text)
+      HasValueRole,
+      StatusTextRole, //!< for the surveyor number: surveyor name or "no access"
+      StatusOkRole,
+    };
+    Q_ENUM( Roles )
+
+    explicit DefaultValuesModel( QObject *parent = nullptr );
+
+    int rowCount( const QModelIndex &parent = QModelIndex() ) const override;
+    QVariant data( const QModelIndex &index, int role = Qt::DisplayRole ) const override;
+    QHash<int, QByteArray> roleNames() const override;
+
+    int setCount() const;
+    bool surveyorAuthorized() const;
+    QString surveyorName() const;
+
+    //! Sets the value of the variable at \a row; an empty / NULL value removes it.
+    Q_INVOKABLE void setValue( int row, const QVariant &value );
+    Q_INVOKABLE void clearValue( int row );
+    Q_INVOKABLE void reload();
+
+    //! Returns true if \a value stands for "no value" in a value map.
+    static bool isNullValue( const QVariant &value );
+
+  signals:
+    void valuesChanged();
+
+  private:
+    struct Entry
+    {
+        QString variable;
+        QString title;
+        QString layerName;
+        QString fieldName;
+        QVariantList options;
+    };
+
+    QList<Entry> mEntries;
+};
+
+#endif // DEFAULTVALUESMODEL_H
