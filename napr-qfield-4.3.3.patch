+QString VillageSelectorModel::code( const QString &zone, const QString &sector )
+{
+  return QStringLiteral( "%1.%2" ).arg( zone, sector );
+}
+
+bool VillageSelectorModel::villageMatches( const Municipality &m, const Village &v ) const
+{
+  if ( mSearchText.isEmpty() )
+    return true;
+  return v.name.contains( mSearchText, Qt::CaseInsensitive )
+         || m.name.contains( mSearchText, Qt::CaseInsensitive )
+         || code( m.zone, v.sector ).startsWith( mSearchText );
+}
+
+bool VillageSelectorModel::municipalityVisible( int m ) const
+{
+  if ( mSearchText.isEmpty() )
+    return true;
+  const Municipality &mu = mMunicipalities.at( m );
+  for ( const Village &v : mu.villages )
+  {
+    if ( villageMatches( mu, v ) )
+      return true;
+  }
+  return false;
+}
+
+QVector<VillageSelectorModel::Row> VillageSelectorModel::buildRows() const
+{
+  QVector<Row> rows;
+  const bool searching = !mSearchText.isEmpty();
+  for ( int m = 0; m < mMunicipalities.size(); ++m )
+  {
+    if ( !municipalityVisible( m ) )
+      continue;
+    rows.append( { MunicipalityRow, m, -1 } );
+    const Municipality &mu = mMunicipalities.at( m );
+    if ( !searching && !mExpanded.contains( mu.zone ) )
+      continue;
+    for ( int v = 0; v < mu.villages.size(); ++v )
+    {
+      if ( villageMatches( mu, mu.villages.at( v ) ) )
+        rows.append( { VillageRow, m, v } );
+    }
+  }
+  return rows;
+}
+
+void VillageSelectorModel::rebuild()
+{
+  beginResetModel();
+  mRows = buildRows();
+  endResetModel();
+}
+
+int VillageSelectorModel::municipalitySelectedCount( int m ) const
+{
+  int count = 0;
+  const Municipality &mu = mMunicipalities.at( m );
+  for ( const Village &v : mu.villages )
+  {
+    if ( mSelected.contains( code( mu.zone, v.sector ) ) )
+      ++count;
+  }
+  return count;
+}
+
+int VillageSelectorModel::rowCount( const QModelIndex &parent ) const
+{
+  return parent.isValid() ? 0 : static_cast<int>( mRows.size() );
+}
+
+QVariant VillageSelectorModel::data( const QModelIndex &index, int role ) const
+{
+  if ( !index.isValid() || index.row() < 0 || index.row() >= mRows.size() )
+    return QVariant();
+
+  const Row &row = mRows.at( index.row() );
+  const Municipality &mu = mMunicipalities.at( row.municipality );
+
+  if ( row.type == MunicipalityRow )
+  {
+    switch ( role )
+    {
+      case RowTypeRole:
+        return MunicipalityRow;
+      case NameRole:
+      case Qt::DisplayRole:
+        return mu.name;
+      case CodeRole:
+      case ZoneIdRole:
+        return mu.zone;
+      case ExpandedRole:
+        return !mSearchText.isEmpty() || mExpanded.contains( mu.zone );
+      case TotalCountRole:
+        return static_cast<int>( mu.villages.size() );
+      case SelectedCountRole:
+        return municipalitySelectedCount( row.municipality );
+      case CheckStateRole:
+      {
+        const int selected = municipalitySelectedCount( row.municipality );
+        return selected == 0 ? 0 : selected == mu.villages.size() ? 2 : 1;
+      }
+    }
+    return QVariant();
+  }
+
+  const Village &v = mu.villages.at( row.village );
+  switch ( role )
+  {
+    case RowTypeRole:
+      return VillageRow;
+    case NameRole:
+    case Qt::DisplayRole:
+      return v.name;
+    case CodeRole:
+      return code( mu.zone, v.sector );
+    case ZoneIdRole:
+      return mu.zone;
+    case CheckStateRole:
+      return mSelected.contains( code( mu.zone, v.sector ) ) ? 2 : 0;
+    case ExpandedRole:
+      return false;
+    case TotalCountRole:
+    case SelectedCountRole:
+      return 0;
+  }
+  return QVariant();
+}
+
+QHash<int, QByteArray> VillageSelectorModel::roleNames() const
+{
+  QHash<int, QByteArray> roles;
+  roles[RowTypeRole] = "rowType";
+  roles[NameRole] = "name";
+  roles[CodeRole] = "code";
+  roles[ZoneIdRole] = "zoneId";
+  roles[CheckStateRole] = "checkState";
+  roles[ExpandedRole] = "expanded";
+  roles[TotalCountRole] = "totalCount";
+  roles[SelectedCountRole] = "selectedCount";
+  return roles;
+}
