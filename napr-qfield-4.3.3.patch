+
+        Label {
+          text: shapeModel.numSides
+          font: QfTheme.strongFont
+          color: QfTheme.mainTextColor
+          horizontalAlignment: Text.AlignHCenter
+          Layout.preferredWidth: 36
+        }
+
+        QfToolButton {
+          width: 36
+          height: 36
+          round: true
+          bgcolor: QfTheme.groupBoxBackgroundColor
+          iconSource: QfTheme.getThemeVectorIcon("ic_add_white_24dp")
+          iconColor: QfTheme.mainTextColor
+          enabled: shapeModel.numSides < 100
+          opacity: enabled ? 1 : 0.4
+          onClicked: shapeModel.numSides = shapeModel.numSides + 1
+        }
+      }
+
+      Rectangle {
+        Layout.fillWidth: true
+        height: 1
+        color: QfTheme.controlBorderColor
+      }
+
+      // Progress + hint
+      RowLayout {
+        Layout.fillWidth: true
+        spacing: 10
+
+        Row {
+          spacing: 5
+          Repeater {
+            model: shapeModel.requiredPoints
+            Rectangle {
+              width: 10
+              height: 10
+              radius: 5
+              color: index < shapeModel.pointCount ? root.accentColor : "transparent"
+              border.color: index < shapeModel.pointCount ? root.accentColor : QfTheme.controlBorderColor
+              border.width: 1.5
+            }
+          }
