+#ifndef TOPOLOGYCHECKERMODEL_H
+#define TOPOLOGYCHECKERMODEL_H
+
+#include <QAbstractListModel>
+#include <QHash>
+#include <QVector>
+#include <qgscoordinatereferencesystem.h>
+#include <qgsfeature.h>
+#include <qgsgeometry.h>
+#include <qgsrectangle.h>
