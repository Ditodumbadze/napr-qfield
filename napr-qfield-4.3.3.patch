diff --git a/src/core/defaultvaluesmodel.cpp b/src/core/defaultvaluesmodel.cpp
new file mode 100644
index 0000000..7070a4d
--- /dev/null
+++ b/src/core/defaultvaluesmodel.cpp
@@ -0,0 +1,351 @@
+#include "defaultvaluesmodel.h"
+#include "layerstylemodel.h"
+#include "surveyoraccess.h"
+
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QRegularExpression>
+#include <QSet>
+#include <QSettings>
+#include <algorithm>
+#include <qgsapplication.h>
+#include <qgseditorwidgetsetup.h>
+#include <qgsexpression.h>
+#include <qgsexpressioncontextutils.h>
+#include <qgsproject.h>
+#include <qgsvariantutils.h>
+#include <qgsvectorlayer.h>
+
+namespace
+{
+  const QString CACHE_KEY = QStringLiteral( "georgiaqfield/defaultVariables" );
+  const QString VALUE_MAP_NULL = QStringLiteral( "{2839923C-8B7D-419E-B84B-CA2FE9B80EC7}" );
+
+  //! Variables that are filled by QGIS / QField / the village picker, never by the user.
+  bool isBuiltinVariable( const QString &name, const QSet<QString> &builtinGlobals )
+  {
+    static const QStringList prefixes = {
+      QStringLiteral( "project_" ), QStringLiteral( "layer" ), QStringLiteral( "position_" ), QStringLiteral( "cloud_" ),
+      QStringLiteral( "qgis_" ), QStringLiteral( "user_" ), QStringLiteral( "map_" ), QStringLiteral( "geometry" ),
+      QStringLiteral( "feature" ), QStringLiteral( "current_" ), QStringLiteral( "form_" ), QStringLiteral( "parent" ),
+      QStringLiteral( "snapping_" ), QStringLiteral( "gnss_" ), QStringLiteral( "qfield_" ), QStringLiteral( "digitizing_" ),
+      QStringLiteral( "canvas_" ), QStringLiteral( "atlas_" ), QStringLiteral( "layout_" ), QStringLiteral( "frame_" ),
+      QStringLiteral( "myzone" ), QStringLiteral( "orzone" ), QStringLiteral( "zoom_level" ), QStringLiteral( "row_number" ),
+      QStringLiteral( "value" ), QStringLiteral( "id" ), QStringLiteral( "mode" ), QStringLiteral( "element" ),
+      QStringLiteral( "cluster_" ), QStringLiteral( "symbol_" ), QStringLiteral( "grid_" ), QStringLiteral( "scale_" ),
+    };
+    if ( builtinGlobals.contains( name ) )
+      return true;
+    for ( const QString &prefix : prefixes )
+    {
+      if ( name.startsWith( prefix, Qt::CaseInsensitive ) )
+        return true;
+    }
+    return false;
+  }
+
+  QVariantList valueMapOptions( const QVariantMap &config )
+  {
+    QVariantList options;
+    auto add = [&options]( const QString &label, const QVariant &value ) {
+      QVariantMap option;
+      option.insert( QStringLiteral( "label" ), label );
+      option.insert( QStringLiteral( "value" ), DefaultValuesModel::isNullValue( value ) ? QString() : value.toString() );
+      options << option;
+    };
+
+    const QVariant map = config.value( QStringLiteral( "map" ) );
+    if ( map.userType() == QMetaType::QVariantList )
+    {
+      const QVariantList list = map.toList();
+      for ( const QVariant &item : list )
+      {
+        const QVariantMap pair = item.toMap();
+        for ( auto it = pair.constBegin(); it != pair.constEnd(); ++it )
+          add( it.key(), it.value() );
+      }
+    }
+    else if ( map.userType() == QMetaType::QVariantMap )
+    {
+      const QVariantMap pairs = map.toMap();
+      for ( auto it = pairs.constBegin(); it != pairs.constEnd(); ++it )
+        add( it.key(), it.value() );
+    }
+    return options;
+  }
+} // namespace
+
+DefaultValuesModel::DefaultValuesModel( QObject *parent )
+  : QAbstractListModel( parent )
+{
+  connect( QgsProject::instance(), &QgsProject::readProject, this, &DefaultValuesModel::reload );
+  connect( SurveyorAccess::instance(), &SurveyorAccess::accessChanged, this, [this] {
+    if ( !mEntries.isEmpty() )
+      emit dataChanged( index( 0, 0 ), index( static_cast<int>( mEntries.size() ) - 1, 0 ) );
+    emit valuesChanged();
+  } );
+  reload();
+}
+
+bool DefaultValuesModel::isNullValue( const QVariant &value )
+{
+  if ( QgsVariantUtils::isNull( value ) )
+    return true;
+  const QString text = value.toString().trimmed();
+  return text.isEmpty() || text.compare( QStringLiteral( "NULL" ), Qt::CaseInsensitive ) == 0 || text == VALUE_MAP_NULL;
+}
+
+void DefaultValuesModel::reload()
+{
+  QSet<QString> builtinGlobals;
+  {
+    std::unique_ptr<QgsExpressionContextScope> globalScope( QgsExpressionContextUtils::globalScope() );
+    const QStringList names = globalScope->variableNames();
+    const QVariantMap custom = QgsApplication::customVariables();
+    for ( const QString &name : names )
+    {
+      if ( !custom.contains( name ) )
+        builtinGlobals.insert( name );
+    }
+  }
+
+  // Main cadastral layers first, then the others alphabetically
+  const QStringList mains = LayerStyleModel::mainLayerNames();
+  QList<QgsVectorLayer *> layers;
+  const QMap<QString, QgsMapLayer *> projectLayers = QgsProject::instance()->mapLayers();
+  for ( QgsMapLayer *layer : projectLayers )
+  {
+    if ( auto *vl = qobject_cast<QgsVectorLayer *>( layer ) )
+      layers << vl;
+  }
+  std::sort( layers.begin(), layers.end(), [&mains]( QgsVectorLayer *a, QgsVectorLayer *b ) {
+    int ia = mains.indexOf( a->name() );
+    int ib = mains.indexOf( b->name() );
+    ia = ia < 0 ? 1000 : ia;
+    ib = ib < 0 ? 1000 : ib;
+    if ( ia != ib )
+      return ia < ib;
+    return QString::localeAwareCompare( a->name(), b->name() ) < 0;
+  } );
+
+  static const QRegularExpression localVariable( QStringLiteral( "with_variable\\s*\\(\\s*'([^']+)'" ) );
+
+  QList<Entry> entries;
+  QSet<QString> seen;
+  for ( QgsVectorLayer *layer : std::as_const( layers ) )
+  {
+    const QgsFields fields = layer->fields();
+    for ( int i = 0; i < fields.count(); i++ )
+    {
+      const QString expressionText = layer->defaultValueDefinition( i ).expression();
+      if ( !expressionText.contains( QLatin1Char( '@' ) ) )
+        continue;
+
+      QSet<QString> localNames;
+      QRegularExpressionMatchIterator matches = localVariable.globalMatch( expressionText );
+      while ( matches.hasNext() )
+        localNames.insert( matches.next().captured( 1 ) );
+
+      QgsExpression expression( expressionText );
+      const QSet<QString> referenced = expression.referencedVariables();
+      QStringList variables( referenced.begin(), referenced.end() );
+      // Keep the order in which the variables are written
+      std::sort( variables.begin(), variables.end(), [&expressionText]( const QString &a, const QString &b ) {
+        return expressionText.indexOf( QLatin1Char( '@' ) + a ) < expressionText.indexOf( QLatin1Char( '@' ) + b );
+      } );
+
+      for ( const QString &variable : std::as_const( variables ) )
+      {
+        if ( variable.isEmpty() || seen.contains( variable ) || localNames.contains( variable ) || isBuiltinVariable( variable, builtinGlobals ) )
+          continue;
+        seen.insert( variable );
+
+        const QgsField field = fields.at( i );
+        Entry entry;
+        entry.variable = variable;
+        entry.title = field.alias().isEmpty() ? field.name() : field.alias();
+        entry.layerName = layer->name();
+        entry.fieldName = field.name();
+        const QgsEditorWidgetSetup setup = layer->editorWidgetSetup( i );
+        if ( setup.type() == QLatin1String( "ValueMap" ) )
+          entry.options = valueMapOptions( setup.config() );
+        entries << entry;
+      }
+    }
+  }
+
+  // The WFS layers are invalid (no fields) without internet: fall back to the
+  // list found the last time the layers were available.
+  QSettings settings;
+  if ( !entries.isEmpty() )
+  {
+    QJsonArray cache;
+    for ( const Entry &entry : std::as_const( entries ) )
+    {
+      QJsonObject object;
+      object.insert( QStringLiteral( "variable" ), entry.variable );
+      object.insert( QStringLiteral( "title" ), entry.title );
+      object.insert( QStringLiteral( "layer" ), entry.layerName );
+      object.insert( QStringLiteral( "field" ), entry.fieldName );
+      object.insert( QStringLiteral( "options" ), QJsonArray::fromVariantList( entry.options ) );
+      cache.append( object );
+    }
+    settings.setValue( CACHE_KEY, QString::fromUtf8( QJsonDocument( cache ).toJson( QJsonDocument::Compact ) ) );
+  }
+  else
+  {
+    const QJsonArray cache = QJsonDocument::fromJson( settings.value( CACHE_KEY ).toString().toUtf8() ).array();
+    for ( const QJsonValue &value : cache )
+    {
+      const QJsonObject object = value.toObject();
+      Entry entry;
+      entry.variable = object.value( QStringLiteral( "variable" ) ).toString();
+      entry.title = object.value( QStringLiteral( "title" ) ).toString();
+      entry.layerName = object.value( QStringLiteral( "layer" ) ).toString();
+      entry.fieldName = object.value( QStringLiteral( "field" ) ).toString();
+      entry.options = object.value( QStringLiteral( "options" ) ).toArray().toVariantList();
+      if ( !entry.variable.isEmpty() )
+        entries << entry;
+    }
+  }
+
+  // Panel layout: the antenna serial is not edited here, and the surveyor's
+  // personal number goes last under a clearer title.
+  static const QStringList hiddenVariables = { QStringLiteral( "antena" ) };
+  entries.erase( std::remove_if( entries.begin(), entries.end(), []( const Entry &entry ) {
+                   return hiddenVariables.contains( entry.variable, Qt::CaseInsensitive );
+                 } ),
+                 entries.end() );
+  for ( int i = 0; i < entries.size(); i++ )
+  {
+    if ( entries.at( i ).variable.compare( QStringLiteral( "amzomveli" ), Qt::CaseInsensitive ) == 0 )
+    {
+      Entry surveyor = entries.takeAt( i );
+      surveyor.title = QStringLiteral( "ამზომველის_პ/ნ" );
+      entries.append( surveyor );
+      break;
+    }
+  }
+
+  beginResetModel();
+  mEntries = entries;
+  endResetModel();
+  emit valuesChanged();
+}
+
+int DefaultValuesModel::rowCount( const QModelIndex &parent ) const
+{
+  return parent.isValid() ? 0 : static_cast<int>( mEntries.size() );
+}
+
+QVariant DefaultValuesModel::data( const QModelIndex &index, int role ) const
+{
+  if ( !index.isValid() || index.row() >= mEntries.size() )
+    return QVariant();
+  const Entry &entry = mEntries.at( index.row() );
+  const QVariant rawValue = QgsApplication::customVariables().value( entry.variable );
+  const bool hasValue = !isNullValue( rawValue );
+  const QString value = hasValue ? rawValue.toString() : QString();
+
+  switch ( role )
+  {
+    case VariableRole:
+      return entry.variable;
+    case Qt::DisplayRole:
+    case TitleRole:
+      return entry.title;
+    case LayerNameRole:
+      return entry.layerName;
+    case FieldNameRole:
+      return entry.fieldName;
+    case ValueRole:
+      return value;
+    case ValueLabelRole:
+    {
+      if ( !hasValue )
+        return QString();
+      for ( const QVariant &option : entry.options )
+      {
+        const QVariantMap map = option.toMap();
+        if ( map.value( QStringLiteral( "value" ) ).toString() == value )
+          return map.value( QStringLiteral( "label" ) ).toString();
+      }
+      return value;
+    }
+    case OptionsRole:
+      return entry.options;
+    case HasValueRole:
+      return hasValue;
+    case StatusTextRole:
+    {
+      if ( entry.variable.compare( QStringLiteral( "amzomveli" ), Qt::CaseInsensitive ) != 0 )
+        return QString();
+      const QString name = SurveyorAccess::surveyorName( value );
+      return name.isEmpty() ? tr( "არ აქვს წვდომა პროგრამაზე" ) : name;
+    }
+    case StatusOkRole:
+      return entry.variable.compare( QStringLiteral( "amzomveli" ), Qt::CaseInsensitive ) == 0 && !SurveyorAccess::surveyorName( value ).isEmpty();
+    default:
+      return QVariant();
+  }
+}
+
+QHash<int, QByteArray> DefaultValuesModel::roleNames() const
+{
+  return {
+    { VariableRole, "variable" },
+    { TitleRole, "title" },
+    { LayerNameRole, "layerName" },
+    { FieldNameRole, "fieldName" },
+    { ValueRole, "value" },
+    { ValueLabelRole, "valueLabel" },
+    { OptionsRole, "options" },
+    { HasValueRole, "hasValue" },
+    { StatusTextRole, "statusText" },
+    { StatusOkRole, "statusOk" },
+  };
+}
+
+int DefaultValuesModel::setCount() const
+{
+  const QVariantMap custom = QgsApplication::customVariables();
+  int count = 0;
+  for ( const Entry &entry : mEntries )
+  {
+    if ( !isNullValue( custom.value( entry.variable ) ) )
+      count++;
+  }
+  return count;
+}
+
+void DefaultValuesModel::setValue( int row, const QVariant &value )
+{
+  if ( row < 0 || row >= mEntries.size() )
+    return;
+  const QString variable = mEntries.at( row ).variable;
+  QVariantMap custom = QgsApplication::customVariables();
+  if ( isNullValue( value ) )
+    custom.remove( variable );
+  else
+    custom.insert( variable, value.toString().trimmed() );
+  QgsApplication::setCustomVariables( custom );
+
+  emit dataChanged( index( row, 0 ), index( row, 0 ), { ValueRole, ValueLabelRole, HasValueRole, StatusTextRole, StatusOkRole } );
+  emit valuesChanged();
+}
+
+bool DefaultValuesModel::surveyorAuthorized() const
+{
+  return SurveyorAccess::isAuthorized();
+}
+
+QString DefaultValuesModel::surveyorName() const
+{
+  return SurveyorAccess::surveyorName( SurveyorAccess::currentPersonalNumber() );
+}
+
+void DefaultValuesModel::clearValue( int row )
+{
+  setValue( row, QVariant() );
+}
