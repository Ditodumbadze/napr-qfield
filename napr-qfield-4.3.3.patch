+          bgcolor: "transparent"
+          iconSource: QfTheme.getThemeVectorIcon("ic_settings_white_24dp")
+          iconColor: QfTheme.mainTextColor
+          onClicked: root.showSettings = true
+        }
+
+        QfToolButton {
+          width: 40
+          height: 40
+          round: true
