+          }
+        }
+      }
+
+      // Number of sides (regular polygon only)
+      RowLayout {
+        Layout.fillWidth: true
+        visible: shapeModel.mode === ShapeDigitizingModel.RegularPolygon
+        spacing: 4
+
+        Label {
