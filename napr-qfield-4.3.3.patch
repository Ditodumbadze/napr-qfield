+          color: "white"
+          enabled: shapeModel.canCommit
+          onClicked: {
+            var err = shapeModel.commit();
+            root.toast(err === "" ? qsTr("ფიგურა დაემატა") : err);
+          }
+        }
+      }
+    }
+  }
+}
diff --git a/src/gui/qml/TopologyCheckerDialog.qml b/src/gui/qml/TopologyCheckerDialog.qml
