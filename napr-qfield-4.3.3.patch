+#ifndef VILLAGESELECTORMODEL_H
+#define VILLAGESELECTORMODEL_H
+
+#include <QAbstractListModel>
+#include <QHash>
+#include <QSet>
+#include <QString>
+#include <QStringList>
+#include <QVector>
+
+class QgsFeedback;
+class QgsVectorLayer;
+
+/**
+ * Georgia QField: municipality → village picker for the NAPR cadastral WFS layers.
+ *
+ * The village list (ZONE_ID / SECTOR_ID with Georgian names) is embedded in the
+ * app (:/napr/villages.json). The model exposes a flat list of rows for a
+ * ListView: one header row per municipality, followed by its villages when the
+ * municipality is expanded (or when they match the search text).
+ *
+ * apply() rewrites the "filter" of every WFS layer whose original filter used
+ * the @myzone / @orzone project variables so that it loads all selected
+ * villages at once. Three NAPR filter styles are recognised (ZONE/SECTOR,
+ * CADCODE and USAIDCODE/PNEWCODE); any other filter falls back to replacing
+ * the variables with a literal per village.
+ * It also keeps @myzone / @orzone set (as '<ZZ.SS%>') for anything else in the
+ * project that still reads them. The selection is remembered across sessions.
+ */
+class VillageSelectorModel : public QAbstractListModel
+{
+    Q_OBJECT
+
+    Q_PROPERTY( QString searchText READ searchText WRITE setSearchText NOTIFY searchTextChanged )
+    Q_PROPERTY( int selectedCount READ selectedCount NOTIFY selectionChanged )
+    Q_PROPERTY( QString selectedSummary READ selectedSummary NOTIFY selectionChanged )
+    Q_PROPERTY( int villageCount READ villageCount CONSTANT )
+    Q_PROPERTY( bool offlineActive READ offlineActive NOTIFY offlineChanged )
+    Q_PROPERTY( QString offlineInfo READ offlineInfo NOTIFY offlineChanged )
+    Q_PROPERTY( bool busy READ busy NOTIFY busyChanged )
+    Q_PROPERTY( QString progressText READ progressText NOTIFY progressChanged )
+
+  public:
+    enum RowType
+    {
+      MunicipalityRow = 0,
+      VillageRow = 1,
+    };
+    Q_ENUM( RowType )
+
+    enum Roles
+    {
+      RowTypeRole = Qt::UserRole + 1,
+      NameRole,
+      CodeRole,
+      ZoneIdRole,
+      CheckStateRole, //!< 0 = none, 1 = partial (municipality only), 2 = checked
+      ExpandedRole,
+      TotalCountRole,
+      SelectedCountRole,
+    };
+    Q_ENUM( Roles )
+
+    explicit VillageSelectorModel( QObject *parent = nullptr );
+
+    int rowCount( const QModelIndex &parent = QModelIndex() ) const override;
+    QVariant data( const QModelIndex &index, int role = Qt::DisplayRole ) const override;
+    QHash<int, QByteArray> roleNames() const override;
+
+    QString searchText() const { return mSearchText; }
+    void setSearchText( const QString &text );
+
+    int selectedCount() const { return static_cast<int>( mSelected.size() ); }
+    QString selectedSummary() const;
+    int villageCount() const { return mVillageCount; }
+
+    //! Expands / collapses a municipality row.
+    Q_INVOKABLE void toggleExpanded( int row );
+    //! Toggles a village, or all villages of a municipality when \a row is a header.
+    Q_INVOKABLE void toggleChecked( int row );
+    Q_INVOKABLE void clearSelection();
+    Q_INVOKABLE void collapseAll();
+
+    //! Number of project layers that apply() would update.
+    Q_INVOKABLE int targetLayerCount();
+
+    //! Loads the selected villages. Returns an empty string on success, otherwise an error.
+    Q_INVOKABLE QString apply();
+    //! Re-applies the remembered selection (called after a project is opened).
+    Q_INVOKABLE bool applySaved();
+
+    bool offlineActive() const;
+    QString offlineInfo() const;
+    bool busy() const { return mBusy; }
+    QString progressText() const { return mProgressText; }
+
+    /**
+     * Downloads every village-filtered WFS layer (for the current selection) into a
+     * local GeoPackage in the background, then switches those layers to it
+     * (read-only) so they keep working without internet. Returns an empty string
+     * when the download started, otherwise an error. offlineFinished() reports the end.
+     */
+    Q_INVOKABLE QString saveOffline();
+    Q_INVOKABLE void cancelOffline();
+    //! Switches the offline layers back to the live WFS server.
+    Q_INVOKABLE QString goLive();
+
+  signals:
+    void searchTextChanged();
+    void selectionChanged();
+    void offlineChanged();
+    void busyChanged();
+    void progressChanged();
+    void offlineFinished( bool success, const QString &message );
+
+  private:
+    struct Village
+    {
+        QString sector;
+        QString name;
+    };
+    struct Municipality
+    {
+        QString zone;
+        QString name;
+        QVector<Village> villages;
+    };
+    struct Row
+    {
+        RowType type = MunicipalityRow;
+        int municipality = -1;
+        int village = -1;
+    };
+
+    void loadData();
+    void loadSelection();
+    void saveSelection() const;
+    QVector<Row> buildRows() const;
+    void rebuild();
+    bool villageMatches( const Municipality &m, const Village &v ) const;
+    bool municipalityVisible( int m ) const;
+    int municipalitySelectedCount( int m ) const;
+    static QString code( const QString &zone, const QString &sector );
+    void notifyMunicipality( int m );
+    QStringList sortedSelection() const;
+    static QString buildFilter( const QString &originalFilter, const QStringList &codes );
+
+    QVector<Municipality> mMunicipalities;
+    QVector<Row> mRows;
+    QSet<QString> mSelected; // "ZZ.SS"
+    QSet<QString> mExpanded; // zone ids
+    QString mSearchText;
+    int mVillageCount = 0;
+
+    //! layer id → original WFS source (with the @myzone / @orzone filter)
+    QHash<QString, QString> mOriginalSources;
+
+    QString originalSourceFor( QgsVectorLayer *layer );
+    bool switchToOffline();
+    void clearOfflineState();
+    void setBusy( bool busy );
+    void setProgressText( const QString &text );
+
+    bool mBusy = false;
+    QString mProgressText;
+    QgsFeedback *mFeedback = nullptr;
+};
+
+#endif // VILLAGESELECTORMODEL_H
