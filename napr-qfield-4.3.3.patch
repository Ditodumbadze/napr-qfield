+  }
+
+  readonly property var swatchColors: ["#fdfd00", "#ffc107", "#ff9800", "#f44336", "#e91e63", "#9c27b0", "#3f51b5", "#2196f3", "#00bcd4", "#009688", "#4caf50", "#8bc34a", "#795548", "#9e9e9e", "#ffffff", "#000000"]
+
+  LayerStyleModel {
