+import QtQuick
+import QtQuick.Controls
+import QtQuick.Controls.impl
+import QtQuick.Layouts
+import org.qfield.core
+import org.qfield.gui
+
+/**
+ * Shape digitizing overlay (rectangle / circle / regular polygon).
+ *
+ * Two input modes:
+ *  - Pen: tap the map directly to place each point; the preview follows the pen.
+ *  - Centre: pan the map to line up the fixed crosshair and press "Add point".
+ *
+ * The finished shape is added as a new feature to the current polygon layer.
+ */
+Item {
+  id: root
+
+  property var mapSettingsRef: null
+  property var currentLayer: null
+  property bool isOpen: false
+  property bool penMode: true
+
+  signal toast(string message)
+
+  visible: isOpen
+
+  readonly property color accentColor: QfTheme.mainColor
+  readonly property color previewColor: "#FF6D00"
+
+  function tint(c, a) {
+    return Qt.rgba(c.r, c.g, c.b, a);
+  }
+
+  ShapeDigitizingModel {
+    id: shapeModel
+    mapSettings: root.mapSettingsRef
+    targetLayer: root.currentLayer
+  }
+
+  onIsOpenChanged: {
+    if (isOpen) {
+      shapeModel.clear();
+      previewCanvas.requestPaint();
+    }
+  }
+
+  // ---- Live preview of the shape under construction ----
+  Canvas {
+    id: previewCanvas
+    anchors.fill: parent
+    visible: root.isOpen
+    z: 4
+
+    onPaint: {
+      var ctx = getContext("2d");
+      ctx.reset();
+
+      var outline = shapeModel.previewOutlineScreen();
+      if (outline.length > 1) {
+        ctx.beginPath();
+        ctx.moveTo(outline[0].x, outline[0].y);
+        for (var i = 1; i < outline.length; i++)
+          ctx.lineTo(outline[i].x, outline[i].y);
+        ctx.closePath();
+        ctx.fillStyle = "rgba(255, 109, 0, 0.16)";
+        ctx.fill();
+        ctx.lineWidth = 2.5;
+        ctx.strokeStyle = root.previewColor;
+        ctx.stroke();
+      }
+
+      var pts = shapeModel.capturedPointsScreen();
+      for (var j = 0; j < pts.length; j++) {
+        ctx.beginPath();
+        ctx.arc(pts[j].x, pts[j].y, 6, 0, 2 * Math.PI);
+        ctx.fillStyle = "#ffffff";
+        ctx.fill();
+        ctx.lineWidth = 3;
+        ctx.strokeStyle = root.previewColor;
+        ctx.stroke();
+      }
+    }
+  }
+
+  Connections {
+    target: shapeModel
+    function onPointsChanged() {
+      previewCanvas.requestPaint();
+    }
+    function onModeChanged() {
+      previewCanvas.requestPaint();
+    }
+    function onNumSidesChanged() {
+      previewCanvas.requestPaint();
+    }
+  }
+
+  Connections {
+    target: root.mapSettingsRef
+    ignoreUnknownSignals: true
+    function onExtentChanged() {
+      previewCanvas.requestPaint();
+    }
+    function onVisibleExtentChanged() {
+      previewCanvas.requestPaint();
+    }
+    function onRotationChanged() {
+      previewCanvas.requestPaint();
+    }
+  }
+
+  // ---- Pen / finger tap-to-place surface (pen mode) ----
+  MouseArea {
+    id: penSurface
+    anchors.fill: parent
+    enabled: root.isOpen && root.penMode
+    visible: enabled
+    hoverEnabled: true
+    z: 5
+    onPositionChanged: mouse => shapeModel.setProvisionalScreenPoint(mouse.x, mouse.y)
+    onPressed: mouse => shapeModel.setProvisionalScreenPoint(mouse.x, mouse.y)
+    onClicked: mouse => shapeModel.capturePointAtScreen(mouse.x, mouse.y)
+    onExited: shapeModel.clearProvisional()
+  }
+
+  // Cursor following the pen (turns into the accent colour while snapping)
+  Rectangle {
+    visible: root.isOpen && root.penMode && penSurface.containsMouse
+    property color markColor: shapeModel.provisionalSnapped ? root.accentColor : root.previewColor
+    x: penSurface.mouseX - width / 2
+    y: penSurface.mouseY - height / 2
+    width: shapeModel.provisionalSnapped ? 28 : 22
+    height: width
+    radius: width / 2
+    color: "transparent"
+    border.color: markColor
+    border.width: 2
+    z: 7
+    Rectangle {
+      anchors.centerIn: parent
+      width: 4
+      height: 4
+      radius: 2
+      color: parent.markColor
+    }
+  }
+
+  // ---- Fixed centre crosshair (centre mode) ----
+  Item {
+    anchors.centerIn: parent
+    width: 36
+    height: 36
+    visible: root.isOpen && !root.penMode
+    z: 6
+
+    Rectangle {
+      anchors.centerIn: parent
+      width: 2
+      height: parent.height
+      color: root.previewColor
+    }
+    Rectangle {
+      anchors.centerIn: parent
+      width: parent.width
+      height: 2
+      color: root.previewColor
+    }
+    Rectangle {
+      anchors.centerIn: parent
+      width: 12
+      height: 12
+      radius: 6
+      color: "transparent"
+      border.color: root.previewColor
+      border.width: 2
+    }
+  }
+
+  // ---- Floating control card ----
+  QfDropShadow {
+    anchors.fill: panel
+    visible: panel.visible
+    verticalOffset: 3
+    radius: 14
+    color: "#55000000"
+    source: panel
+    z: 9
+  }
+
+  Rectangle {
+    id: panel
+    anchors.bottom: parent.bottom
+    anchors.horizontalCenter: parent.horizontalCenter
+    anchors.bottomMargin: mainWindow.sceneBottomMargin + 12
+    width: Math.min(parent.width - 24, 460)
+    height: content.implicitHeight + 28
+    radius: 18
+    color: QfTheme.mainBackgroundColor
+    border.color: QfTheme.controlBorderColor
+    border.width: 1
+    z: 10
+
+    // Absorb touches so interacting with the card never pans or digitizes.
+    MouseArea {
+      anchors.fill: parent
+      onClicked: {}
+    }
+
+    ColumnLayout {
+      id: content
+      anchors.left: parent.left
+      anchors.right: parent.right
+      anchors.top: parent.top
+      anchors.margins: 14
+      spacing: 12
+
+      // Header
+      RowLayout {
+        Layout.fillWidth: true
+        spacing: 8
+
+        IconImage {
+          source: QfTheme.getThemeVectorIcon("ic_napr_shapes_white_24dp")
+          sourceSize: Qt.size(22, 22)
+          color: root.accentColor
+        }
+
+        Label {
+          text: qsTr("ფიგურის ხაზვა")
+          font: QfTheme.strongFont
+          color: QfTheme.mainTextColor
+          elide: Text.ElideRight
+          Layout.fillWidth: true
+        }
+
+        QfToolButton {
+          width: 40
+          height: 40
+          round: true
+          bgcolor: "transparent"
+          iconSource: QfTheme.getThemeVectorIcon("ic_close_white_24dp")
+          iconColor: QfTheme.mainTextColor
+          onClicked: root.isOpen = false
+        }
+      }
+
+      // Shape type tiles
+      RowLayout {
+        Layout.fillWidth: true
+        spacing: 8
+
+        Repeater {
+          model: [
+            {
+              "icon": "ic_napr_shape_rect_white_24dp",
+              "label": qsTr("მართკუთხ.")
+            },
+            {
+              "icon": "ic_napr_shape_rect3_white_24dp",
+              "label": qsTr("3 წერტილით")
+            },
+            {
+              "icon": "ic_napr_shape_circle_white_24dp",
+              "label": qsTr("წრე")
+            },
+            {
+              "icon": "ic_napr_shape_polygon_white_24dp",
+              "label": qsTr("პოლიგონი")
+            }
+          ]
+
+          Rectangle {
+            readonly property bool selected: shapeModel.mode === index
+            Layout.fillWidth: true
+            Layout.preferredWidth: 1
+            height: 66
+            radius: 12
+            color: selected ? root.tint(root.accentColor, 0.14) : QfTheme.groupBoxBackgroundColor
+            border.color: selected ? root.accentColor : "transparent"
+            border.width: 1.5
+
+            Column {
+              anchors.centerIn: parent
+              spacing: 4
+
+              IconImage {
+                anchors.horizontalCenter: parent.horizontalCenter
+                source: QfTheme.getThemeVectorIcon(modelData.icon)
+                sourceSize: Qt.size(26, 26)
+                color: selected ? root.accentColor : QfTheme.mainTextColor
+              }
+
+              Label {
+                anchors.horizontalCenter: parent.horizontalCenter
+                text: modelData.label
+                font: QfTheme.tinyFont
+                color: selected ? root.accentColor : QfTheme.secondaryTextColor
+              }
+            }
+
+            MouseArea {
+              anchors.fill: parent
+              onClicked: shapeModel.mode = index
+            }
+          }
+        }
+      }
+
+      // Input mode + snapping
+      RowLayout {
+        Layout.fillWidth: true
+        spacing: 8
+
+        // Segmented control: pen / centre
+        Rectangle {
+          Layout.preferredHeight: 40
+          Layout.preferredWidth: segRow.implicitWidth + 8
+          radius: 20
+          color: QfTheme.groupBoxBackgroundColor
+
+          Row {
+            id: segRow
+            anchors.centerIn: parent
+            spacing: 0
+
+            Repeater {
+              model: [
+                {
+                  "pen": true,
+                  "icon": "ic_create_white_24dp",
+                  "label": qsTr("კალამი")
