+#include "layerstylemodel.h"
+
+#include <QDomDocument>
+#include <QSettings>
+#include <algorithm>
+#include <qgscategorizedsymbolrenderer.h>
+#include <qgsfillsymbol.h>
+#include <qgsfillsymbollayer.h>
+#include <qgsgraduatedsymbolrenderer.h>
+#include <qgslinesymbol.h>
+#include <qgslinesymbollayer.h>
+#include <qgsmaplayerlegend.h>
+#include <qgsmarkersymbol.h>
+#include <qgsmarkersymbollayer.h>
+#include <qgspallabeling.h>
+#include <qgsproject.h>
+#include <qgsreadwritecontext.h>
+#include <qgsrulebasedrenderer.h>
+#include <qgssinglesymbolrenderer.h>
+#include <qgssymbol.h>
+#include <qgstextbuffersettings.h>
+#include <qgstextformat.h>
+#include <qgsvectorlayer.h>
+#include <qgsvectorlayerlabeling.h>
+
+namespace
+{
+  const QString SETTINGS_GROUP = QStringLiteral( "georgiaqfield/layerStyles" );
+
+  //! Colour / width information collected from a symbol's layers.
+  struct SymbolInfo
+  {
+      QColor stroke;
+      QColor fill;
+      double width = -1;
+      int penStyle = -1;
+      double size = -1;
+      bool hasVertices = false;
+      bool verticesOn = false;
+  };
+
+  bool isVertexLayer( const QgsSymbol *symbol, const QgsSymbolLayer *layer )
+  {
+    return symbol->type() == Qgis::SymbolType::Fill && dynamic_cast<const QgsTemplatedLineSymbolLayerBase *>( layer );
+  }
+
+  SymbolInfo readSymbol( QgsSymbol *symbol )
+  {
+    SymbolInfo info;
+    if ( !symbol )
+      return info;
+
+    QColor lineTemplateColor;
+    for ( QgsSymbolLayer *layer : symbol->symbolLayers() )
+    {
+      if ( auto *simpleFill = dynamic_cast<QgsSimpleFillSymbolLayer *>( layer ) )
+      {
+        if ( !info.fill.isValid() )
+          info.fill = simpleFill->brushStyle() == Qt::NoBrush ? QColor( 0, 0, 0, 0 ) : simpleFill->fillColor();
+        if ( !info.stroke.isValid() && simpleFill->strokeStyle() != Qt::NoPen )
+        {
+          info.stroke = simpleFill->strokeColor();
+          info.width = simpleFill->strokeWidth();
+          info.penStyle = static_cast<int>( simpleFill->strokeStyle() );
+        }
+      }
+      else if ( auto *simpleLine = dynamic_cast<QgsSimpleLineSymbolLayer *>( layer ) )
+      {
+        if ( !info.stroke.isValid() )
+        {
+          info.stroke = simpleLine->color();
+          info.width = simpleLine->width();
+          info.penStyle = static_cast<int>( simpleLine->penStyle() );
+        }
+      }
+      else if ( auto *templated = dynamic_cast<QgsTemplatedLineSymbolLayerBase *>( layer ) )
+      {
+        if ( isVertexLayer( symbol, layer ) )
+        {
+          info.hasVertices = true;
+          info.verticesOn = info.verticesOn || layer->enabled();
+        }
+        else if ( !lineTemplateColor.isValid() && templated->subSymbol() )
+        {
+          lineTemplateColor = templated->subSymbol()->color();
+        }
+      }
+      else if ( auto *simpleMarker = dynamic_cast<QgsSimpleMarkerSymbolLayer *>( layer ) )
+      {
+        if ( !info.fill.isValid() )
+          info.fill = simpleMarker->color();
+        if ( !info.stroke.isValid() )
+        {
+          info.stroke = simpleMarker->strokeColor();
+          info.width = simpleMarker->strokeWidth();
+        }
+      }
+      else if ( dynamic_cast<QgsFillSymbolLayer *>( layer ) || dynamic_cast<QgsMarkerSymbolLayer *>( layer ) )
+      {
+        // pattern fills (hatching / dots), SVG markers, filled markers...
+        if ( !info.fill.isValid() )
+          info.fill = layer->subSymbol() ? layer->subSymbol()->color() : layer->color();
+      }
+    }
+
+    if ( !info.stroke.isValid() && lineTemplateColor.isValid() )
+      info.stroke = lineTemplateColor;
+    if ( auto *marker = dynamic_cast<QgsMarkerSymbol *>( symbol ) )
+      info.size = marker->size();
+    return info;
+  }
+
+  void applyStroke( QgsSymbol *symbol, const QColor &color )
+  {
+    bool hasSimpleStroke = false;
+    for ( QgsSymbolLayer *layer : symbol->symbolLayers() )
+    {
+      if ( auto *simpleFill = dynamic_cast<QgsSimpleFillSymbolLayer *>( layer ) )
+      {
+        simpleFill->setStrokeColor( color );
+        if ( simpleFill->strokeStyle() == Qt::NoPen && symbol->symbolLayerCount() == 1 )
+          simpleFill->setStrokeStyle( Qt::SolidLine );
+        hasSimpleStroke = true;
+      }
+      else if ( auto *simpleLine = dynamic_cast<QgsSimpleLineSymbolLayer *>( layer ) )
+      {
+        simpleLine->setColor( color );
+        hasSimpleStroke = true;
+      }
+      else if ( auto *simpleMarker = dynamic_cast<QgsSimpleMarkerSymbolLayer *>( layer ) )
+      {
+        simpleMarker->setStrokeColor( color );
+        hasSimpleStroke = true;
+      }
+    }
+
+    // Line made only of markers / hashes: colour them
+    if ( !hasSimpleStroke && symbol->type() == Qgis::SymbolType::Line )
+    {
+      for ( QgsSymbolLayer *layer : symbol->symbolLayers() )
+      {
+        if ( auto *templated = dynamic_cast<QgsTemplatedLineSymbolLayerBase *>( layer ) )
+        {
+          if ( templated->subSymbol() )
+            templated->subSymbol()->setColor( color );
+        }
+        else
+        {
+          layer->setColor( color );
+        }
+      }
+    }
+  }
+
+  //! Sets the fill colour; alpha < 0 keeps the current alpha of each layer.
+  void applyFill( QgsSymbol *symbol, const QColor &color, double alpha )
+  {
+    auto withAlpha = [color, alpha]( const QColor &current ) {
+      QColor c = color;
+      double a = alpha;
+      if ( a < 0 )
+      {
+        a = current.alphaF();
+        // A fully transparent fill would hide the new colour: make it visible
+        if ( a <= 0.0 )
+          a = 0.35;
+      }
+      c.setAlphaF( a );
+      return c;
+    };
+
+    for ( QgsSymbolLayer *layer : symbol->symbolLayers() )
+    {
+      if ( auto *simpleFill = dynamic_cast<QgsSimpleFillSymbolLayer *>( layer ) )
+      {
+        const QColor current = simpleFill->brushStyle() == Qt::NoBrush ? QColor( 0, 0, 0, 0 ) : simpleFill->fillColor();
+        simpleFill->setFillColor( withAlpha( current ) );
+        if ( simpleFill->brushStyle() == Qt::NoBrush )
+          simpleFill->setBrushStyle( Qt::SolidPattern );
+      }
+      else if ( dynamic_cast<QgsSimpleLineSymbolLayer *>( layer ) || isVertexLayer( symbol, layer ) )
+      {
+        continue;
+      }
+      else if ( dynamic_cast<QgsFillSymbolLayer *>( layer ) || dynamic_cast<QgsMarkerSymbolLayer *>( layer ) )
+      {
+        if ( layer->subSymbol() && symbol->type() == Qgis::SymbolType::Fill )
+          layer->subSymbol()->setColor( withAlpha( layer->subSymbol()->color() ) );
+        else
+          layer->setColor( withAlpha( layer->color() ) );
+      }
+    }
+  }
+} // namespace
+
+LayerStyleModel::LayerStyleModel( QObject *parent )
+  : QAbstractListModel( parent )
+{
+  connect( QgsProject::instance(), &QgsProject::cleared, this, [this] {
+    mOriginals.clear();
+    reload();
+  } );
+  connect( QgsProject::instance(), &QgsProject::layersAdded, this, &LayerStyleModel::reload );
+  connect( QgsProject::instance(), &QgsProject::layersRemoved, this, &LayerStyleModel::reload );
+  reload();
+}
+
+LayerStyleModel::~LayerStyleModel() = default;
+
+QStringList LayerStyleModel::mainLayerNames()
+{
+  return { QStringLiteral( "ნაკვეთი" ), QStringLiteral( "INV_ALL" ), QStringLiteral( "LR_BUILDINGS" ), QStringLiteral( "LR_PARCELS" ) };
+}
+
+void LayerStyleModel::reload()
+{
+  beginResetModel();
+  mLayers.clear();
+  const QStringList mains = mainLayerNames();
+  QList<QgsVectorLayer *> layers;
+  const QMap<QString, QgsMapLayer *> projectLayers = QgsProject::instance()->mapLayers();
+  for ( QgsMapLayer *layer : projectLayers )
+  {
+    auto *vl = qobject_cast<QgsVectorLayer *>( layer );
+    if ( vl && vl->renderer() && vl->geometryType() != Qgis::GeometryType::Null )
+      layers << vl;
+  }
+  std::sort( layers.begin(), layers.end(), [&mains]( QgsVectorLayer *a, QgsVectorLayer *b ) {
+    const int ia = mains.indexOf( a->name() );
+    const int ib = mains.indexOf( b->name() );
+    if ( ia != ib )
+    {
+      if ( ia < 0 )
+        return false;
+      if ( ib < 0 )
+        return true;
+      return ia < ib;
+    }
+    return QString::localeAwareCompare( a->name(), b->name() ) < 0;
+  } );
+  for ( QgsVectorLayer *vl : std::as_const( layers ) )
+    mLayers << vl;
+  endResetModel();
+
+  if ( !mCurrentLayerId.isEmpty() && !currentLayer() )
+  {
+    mCurrentLayerId.clear();
+    emit currentLayerChanged();
+  }
+  emit styleChanged();
+}
+
+int LayerStyleModel::rowCount( const QModelIndex &parent ) const
+{
+  return parent.isValid() ? 0 : static_cast<int>( mLayers.size() );
+}
+
+QVariant LayerStyleModel::data( const QModelIndex &index, int role ) const
+{
+  if ( !index.isValid() || index.row() >= mLayers.size() )
+    return QVariant();
+  QgsVectorLayer *layer = mLayers.at( index.row() );
+  if ( !layer )
+    return QVariant();
+
+  switch ( role )
+  {
+    case LayerIdRole:
+      return layer->id();
+    case Qt::DisplayRole:
+    case NameRole:
+      return layer->name();
+    case IsMainRole:
+      return mainLayerNames().contains( layer->name() );
+    case GeometryTypeRole:
+      return static_cast<int>( layer->geometryType() );
+    case CustomizedRole:
+      return isCustomized( layer );
+    case SymbolCountRole:
+      return symbolCount( layer );
+    default:
+      return QVariant();
+  }
+}
+
+QHash<int, QByteArray> LayerStyleModel::roleNames() const
+{
+  return {
+    { LayerIdRole, "layerId" },
+    { NameRole, "name" },
+    { IsMainRole, "isMain" },
+    { GeometryTypeRole, "geometryType" },
+    { CustomizedRole, "customized" },
+    { SymbolCountRole, "symbolCount" },
+  };
+}
+
+QgsVectorLayer *LayerStyleModel::currentLayer() const
+{
+  if ( mCurrentLayerId.isEmpty() )
+    return nullptr;
+  return qobject_cast<QgsVectorLayer *>( QgsProject::instance()->mapLayer( mCurrentLayerId ) );
+}
+
+QString LayerStyleModel::currentLayerId() const
+{
+  return mCurrentLayerId;
+}
+
+void LayerStyleModel::setCurrentLayerId( const QString &id )
+{
+  if ( mCurrentLayerId == id )
+    return;
+  mCurrentLayerId = id;
+  emit currentLayerChanged();
+  emit styleChanged();
+}
+
+QString LayerStyleModel::currentLayerName() const
+{
+  QgsVectorLayer *layer = currentLayer();
+  return layer ? layer->name() : QString();
+}
+
+int LayerStyleModel::currentGeometryType() const
+{
+  QgsVectorLayer *layer = currentLayer();
+  return layer ? static_cast<int>( layer->geometryType() ) : -1;
+}
+
+int LayerStyleModel::symbolCount( QgsVectorLayer *layer ) const
+{
+  if ( !layer || !layer->renderer() )
+    return 0;
+  QgsFeatureRenderer *renderer = layer->renderer();
+  if ( dynamic_cast<QgsSingleSymbolRenderer *>( renderer ) )
+    return 1;
+  if ( auto *categorized = dynamic_cast<QgsCategorizedSymbolRenderer *>( renderer ) )
+    return static_cast<int>( categorized->categories().size() );
+  if ( auto *graduated = dynamic_cast<QgsGraduatedSymbolRenderer *>( renderer ) )
+    return static_cast<int>( graduated->ranges().size() );
+  if ( auto *ruleBased = dynamic_cast<QgsRuleBasedRenderer *>( renderer ) )
+  {
+    int count = 0;
+    const QgsRuleBasedRenderer::RuleList rules = ruleBased->rootRule()->descendants();
+    for ( QgsRuleBasedRenderer::Rule *rule : rules )
+      if ( rule->symbol() )
+        count++;
+    return count;
+  }
+  return 0;
+}
+
+std::unique_ptr<QgsSymbol> LayerStyleModel::cloneSymbol( QgsVectorLayer *layer, int index, QString *label, bool *visible, bool *canToggle ) const
+{
+  if ( !layer || !layer->renderer() || index < 0 )
+    return nullptr;
+
+  auto set = [&]( const QString &l, bool v, bool t ) {
+    if ( label )
+      *label = l;
+    if ( visible )
+      *visible = v;
+    if ( canToggle )
+      *canToggle = t;
+  };
+
+  QgsFeatureRenderer *renderer = layer->renderer();
+  if ( auto *single = dynamic_cast<QgsSingleSymbolRenderer *>( renderer ) )
+  {
+    if ( index != 0 || !single->symbol() )
+      return nullptr;
+    set( QString(), true, false );
+    return std::unique_ptr<QgsSymbol>( single->symbol()->clone() );
+  }
+  if ( auto *categorized = dynamic_cast<QgsCategorizedSymbolRenderer *>( renderer ) )
+  {
+    const QgsCategoryList categories = categorized->categories();
+    if ( index >= categories.size() || !categories.at( index ).symbol() )
+      return nullptr;
+    const QgsRendererCategory &category = categories.at( index );
+    set( category.label().isEmpty() ? QString() : category.label(), category.renderState(), true );
+    return std::unique_ptr<QgsSymbol>( category.symbol()->clone() );
+  }
+  if ( auto *graduated = dynamic_cast<QgsGraduatedSymbolRenderer *>( renderer ) )
+  {
+    const QgsRangeList ranges = graduated->ranges();
+    if ( index >= ranges.size() || !ranges.at( index ).symbol() )
+      return nullptr;
+    const QgsRendererRange &range = ranges.at( index );
+    set( range.label(), range.renderState(), true );
+    return std::unique_ptr<QgsSymbol>( range.symbol()->clone() );
+  }
+  if ( auto *ruleBased = dynamic_cast<QgsRuleBasedRenderer *>( renderer ) )
+  {
+    int i = 0;
+    const QgsRuleBasedRenderer::RuleList rules = ruleBased->rootRule()->descendants();
+    for ( QgsRuleBasedRenderer::Rule *rule : rules )
+    {
+      if ( !rule->symbol() )
+        continue;
+      if ( i++ == index )
+      {
+        set( rule->label(), rule->active(), true );
+        return std::unique_ptr<QgsSymbol>( rule->symbol()->clone() );
+      }
+    }
+  }
+  return nullptr;
+}
+
+void LayerStyleModel::replaceSymbol( QgsVectorLayer *layer, int index, QgsSymbol *symbol )
+{
+  QgsFeatureRenderer *renderer = layer->renderer();
+  if ( auto *single = dynamic_cast<QgsSingleSymbolRenderer *>( renderer ) )
+  {
+    single->setSymbol( symbol );
+  }
+  else if ( auto *categorized = dynamic_cast<QgsCategorizedSymbolRenderer *>( renderer ) )
+  {
+    categorized->updateCategorySymbol( index, symbol );
+  }
+  else if ( auto *graduated = dynamic_cast<QgsGraduatedSymbolRenderer *>( renderer ) )
+  {
+    graduated->updateRangeSymbol( index, symbol );
+  }
+  else if ( auto *ruleBased = dynamic_cast<QgsRuleBasedRenderer *>( renderer ) )
+  {
+    int i = 0;
+    const QgsRuleBasedRenderer::RuleList rules = ruleBased->rootRule()->descendants();
+    for ( QgsRuleBasedRenderer::Rule *rule : rules )
+    {
+      if ( !rule->symbol() )
+        continue;
+      if ( i++ == index )
+      {
+        rule->setSymbol( symbol );
+        return;
+      }
+    }
+    delete symbol;
+  }
+  else
+  {
+    delete symbol;
+  }
+}
+
+template<typename F>
+void LayerStyleModel::editSymbol( int index, F edit )
+{
+  QgsVectorLayer *layer = currentLayer();
+  if ( !layer )
+    return;
+  std::unique_ptr<QgsSymbol> symbol = cloneSymbol( layer, index );
+  if ( !symbol )
+    return;
+  rememberOriginal( layer );
+  edit( symbol.get() );
+  replaceSymbol( layer, index, symbol.release() );
+  layerEdited( layer );
+}
+
+QVariantList LayerStyleModel::symbols() const
+{
+  QVariantList list;
+  QgsVectorLayer *layer = currentLayer();
+  const int count = symbolCount( layer );
+  for ( int i = 0; i < count; i++ )
+  {
+    QString label;
+    bool visible = true;
+    bool canToggle = false;
+    std::unique_ptr<QgsSymbol> symbol = cloneSymbol( layer, i, &label, &visible, &canToggle );
+    if ( !symbol )
+      continue;
+    const SymbolInfo info = readSymbol( symbol.get() );
+    QVariantMap entry;
+    entry.insert( QStringLiteral( "index" ), i );
+    entry.insert( QStringLiteral( "label" ), label );
+    entry.insert( QStringLiteral( "symbolType" ), static_cast<int>( symbol->type() ) );
+    entry.insert( QStringLiteral( "hasStroke" ), info.stroke.isValid() );
+    entry.insert( QStringLiteral( "strokeColor" ), info.stroke.isValid() ? info.stroke : QColor( Qt::transparent ) );
+    entry.insert( QStringLiteral( "hasFill" ), info.fill.isValid() );
+    entry.insert( QStringLiteral( "fillColor" ), info.fill.isValid() ? info.fill : QColor( Qt::transparent ) );
+    entry.insert( QStringLiteral( "fillOpacity" ), info.fill.isValid() ? info.fill.alphaF() : 0.0 );
+    entry.insert( QStringLiteral( "strokeWidth" ), info.width );
+    entry.insert( QStringLiteral( "penStyle" ), info.penStyle );
+    entry.insert( QStringLiteral( "markerSize" ), info.size );
+    entry.insert( QStringLiteral( "hasVertices" ), info.hasVertices );
+    entry.insert( QStringLiteral( "verticesVisible" ), info.verticesOn );
+    entry.insert( QStringLiteral( "visible" ), visible );
+    entry.insert( QStringLiteral( "canToggle" ), canToggle && count > 1 );
+    list << entry;
+  }
+  return list;
+}
+
+void LayerStyleModel::setStrokeColor( int symbolIndex, const QColor &color )
+{
+  editSymbol( symbolIndex, [&color]( QgsSymbol *symbol ) { applyStroke( symbol, color ); } );
+}
+
+void LayerStyleModel::setFillColor( int symbolIndex, const QColor &color )
+{
+  editSymbol( symbolIndex, [&color]( QgsSymbol *symbol ) { applyFill( symbol, color, -1 ); } );
+}
+
+void LayerStyleModel::setFillOpacity( int symbolIndex, double opacity )
+{
+  editSymbol( symbolIndex, [opacity]( QgsSymbol *symbol ) {
+    const SymbolInfo info = readSymbol( symbol );
+    QColor color = info.fill.isValid() ? info.fill : QColor( 255, 255, 255 );
+    applyFill( symbol, color, std::clamp( opacity, 0.0, 1.0 ) );
+  } );
+}
+
+void LayerStyleModel::setStrokeWidth( int symbolIndex, double width )
+{
+  editSymbol( symbolIndex, [width]( QgsSymbol *symbol ) {
+    for ( QgsSymbolLayer *layer : symbol->symbolLayers() )
+    {
+      if ( auto *simpleFill = dynamic_cast<QgsSimpleFillSymbolLayer *>( layer ) )
+        simpleFill->setStrokeWidth( width );
+      else if ( auto *simpleLine = dynamic_cast<QgsSimpleLineSymbolLayer *>( layer ) )
+        simpleLine->setWidth( width );
+      else if ( auto *simpleMarker = dynamic_cast<QgsSimpleMarkerSymbolLayer *>( layer ) )
+        simpleMarker->setStrokeWidth( width );
+    }
+  } );
+}
+
+void LayerStyleModel::setStrokeStyle( int symbolIndex, int penStyle )
+{
+  const Qt::PenStyle style = static_cast<Qt::PenStyle>( penStyle );
+  editSymbol( symbolIndex, [style]( QgsSymbol *symbol ) {
+    for ( QgsSymbolLayer *layer : symbol->symbolLayers() )
+    {
+      if ( auto *simpleFill = dynamic_cast<QgsSimpleFillSymbolLayer *>( layer ) )
+      {
+        if ( simpleFill->strokeStyle() != Qt::NoPen || symbol->symbolLayerCount() == 1 )
+          simpleFill->setStrokeStyle( style );
+      }
+      else if ( auto *simpleLine = dynamic_cast<QgsSimpleLineSymbolLayer *>( layer ) )
+      {
+        simpleLine->setPenStyle( style );
+      }
+    }
+  } );
+}
+
+void LayerStyleModel::setMarkerSize( int symbolIndex, double size )
+{
+  editSymbol( symbolIndex, [size]( QgsSymbol *symbol ) {
+    if ( auto *marker = dynamic_cast<QgsMarkerSymbol *>( symbol ) )
+      marker->setSize( size );
+  } );
+}
+
+void LayerStyleModel::setVerticesVisible( int symbolIndex, bool visible )
+{
+  editSymbol( symbolIndex, [visible]( QgsSymbol *symbol ) {
+    for ( QgsSymbolLayer *layer : symbol->symbolLayers() )
+      if ( isVertexLayer( symbol, layer ) )
+        layer->setEnabled( visible );
+  } );
+}
+
+void LayerStyleModel::setSymbolVisible( int symbolIndex, bool visible )
+{
+  QgsVectorLayer *layer = currentLayer();
+  if ( !layer || !layer->renderer() )
+    return;
+  rememberOriginal( layer );
+  QgsFeatureRenderer *renderer = layer->renderer();
+  if ( auto *categorized = dynamic_cast<QgsCategorizedSymbolRenderer *>( renderer ) )
+  {
+    categorized->updateCategoryRenderState( symbolIndex, visible );
+  }
+  else if ( auto *graduated = dynamic_cast<QgsGraduatedSymbolRenderer *>( renderer ) )
+  {
+    graduated->updateRangeRenderState( symbolIndex, visible );
+  }
+  else if ( auto *ruleBased = dynamic_cast<QgsRuleBasedRenderer *>( renderer ) )
+  {
+    int i = 0;
+    const QgsRuleBasedRenderer::RuleList rules = ruleBased->rootRule()->descendants();
+    for ( QgsRuleBasedRenderer::Rule *rule : rules )
+    {
+      if ( !rule->symbol() )
+        continue;
+      if ( i++ == symbolIndex )
+      {
+        rule->setActive( visible );
+        break;
+      }
+    }
+  }
+  layerEdited( layer );
+}
+
+double LayerStyleModel::layerOpacity() const
+{
+  QgsVectorLayer *layer = currentLayer();
+  return layer ? layer->opacity() : 1.0;
+}
+
+void LayerStyleModel::setLayerOpacity( double opacity )
+{
+  QgsVectorLayer *layer = currentLayer();
+  if ( !layer )
+    return;
+  rememberOriginal( layer );
+  layer->setOpacity( std::clamp( opacity, 0.0, 1.0 ) );
+  layerEdited( layer );
+}
+
+namespace
+{
+  QgsVectorLayerSimpleLabeling *simpleLabeling( QgsVectorLayer *layer )
+  {
+    return layer ? dynamic_cast<QgsVectorLayerSimpleLabeling *>( layer->labeling() ) : nullptr;
+  }
+
+  template<typename F>
+  void editLabelFormat( QgsVectorLayer *layer, F edit )
+  {
+    QgsVectorLayerSimpleLabeling *labeling = simpleLabeling( layer );
+    if ( !labeling )
+      return;
+    auto *settings = new QgsPalLayerSettings( labeling->settings() );
+    QgsTextFormat format = settings->format();
+    edit( format );
+    settings->setFormat( format );
+    labeling->setSettings( settings );
+  }
+} // namespace
+
+bool LayerStyleModel::labelsAvailable() const
+{
+  return simpleLabeling( currentLayer() );
+}
+
+bool LayerStyleModel::labelsEnabled() const
+{
+  QgsVectorLayer *layer = currentLayer();
+  return layer && layer->labelsEnabled();
+}
+
+double LayerStyleModel::labelSize() const
+{
+  QgsVectorLayerSimpleLabeling *labeling = simpleLabeling( currentLayer() );
+  return labeling ? labeling->settings().format().size() : 0.0;
+}
+
+QColor LayerStyleModel::labelColor() const
+{
+  QgsVectorLayerSimpleLabeling *labeling = simpleLabeling( currentLayer() );
+  return labeling ? labeling->settings().format().color() : QColor();
+}
+
+bool LayerStyleModel::labelHalo() const
+{
+  QgsVectorLayerSimpleLabeling *labeling = simpleLabeling( currentLayer() );
+  return labeling && labeling->settings().format().buffer().enabled();
+}
+
+void LayerStyleModel::setLabelsEnabled( bool enabled )
+{
+  QgsVectorLayer *layer = currentLayer();
+  if ( !layer || !layer->labeling() )
+    return;
+  rememberOriginal( layer );
+  layer->setLabelsEnabled( enabled );
+  layerEdited( layer );
+}
+
+void LayerStyleModel::setLabelSize( double size )
+{
+  QgsVectorLayer *layer = currentLayer();
+  if ( !simpleLabeling( layer ) )
+    return;
+  rememberOriginal( layer );
+  editLabelFormat( layer, [size]( QgsTextFormat &format ) { format.setSize( size ); } );
+  layerEdited( layer );
+}
+
+void LayerStyleModel::setLabelColor( const QColor &color )
+{
+  QgsVectorLayer *layer = currentLayer();
+  if ( !simpleLabeling( layer ) )
+    return;
+  rememberOriginal( layer );
+  editLabelFormat( layer, [&color]( QgsTextFormat &format ) { format.setColor( color ); } );
+  layerEdited( layer );
+}
+
+void LayerStyleModel::setLabelHalo( bool enabled )
+{
+  QgsVectorLayer *layer = currentLayer();
+  if ( !simpleLabeling( layer ) )
+    return;
+  rememberOriginal( layer );
+  editLabelFormat( layer, [enabled]( QgsTextFormat &format ) {
+    QgsTextBufferSettings buffer = format.buffer();
+    buffer.setEnabled( enabled );
+    if ( enabled )
+    {
+      // Readable on orthophotos: a white halo, or a dark one behind light text
+      if ( buffer.size() <= 0 )
+        buffer.setSize( 0.8 );
+      buffer.setColor( format.color().lightnessF() > 0.7 ? QColor( 30, 30, 30 ) : QColor( 255, 255, 255 ) );
+      buffer.setOpacity( 0.85 );
+    }
+    format.setBuffer( buffer );
+  } );
+  layerEdited( layer );
+}
+
+void LayerStyleModel::rememberOriginal( QgsVectorLayer *layer )
+{
+  if ( !layer || mOriginals.contains( layer->id() ) )
+    return;
+  auto original = std::make_shared<Original>();
+  original->renderer.reset( layer->renderer() ? layer->renderer()->clone() : nullptr );
+  original->labeling.reset( layer->labeling() ? layer->labeling()->clone() : nullptr );
+  original->labelsEnabled = layer->labelsEnabled();
+  original->opacity = layer->opacity();
+  mOriginals.insert( layer->id(), original );
+}
+
+void LayerStyleModel::layerEdited( QgsVectorLayer *layer )
+{
+  save( layer );
+  layer->emitStyleChanged();
+  if ( layer->legend() )
+    emit layer->legend()->itemsChanged();
+  layer->triggerRepaint();
+
+  const int row = static_cast<int>( mLayers.indexOf( QPointer<QgsVectorLayer>( layer ) ) );
+  if ( row >= 0 )
+    emit dataChanged( index( row, 0 ), index( row, 0 ), { CustomizedRole } );
+  emit styleChanged();
+}
+
+QString LayerStyleModel::settingsKey( const QgsVectorLayer *layer )
+{
+  // Layer names are Georgian: hex-encode them so every QSettings backend is happy
+  return QStringLiteral( "%1/%2" ).arg( SETTINGS_GROUP, QString::fromLatin1( layer->name().toUtf8().toHex() ) );
+}
+
+bool LayerStyleModel::isCustomized( const QgsVectorLayer *layer ) const
+{
+  QSettings settings;
+  return layer && settings.contains( settingsKey( layer ) + QStringLiteral( "/renderer" ) );
+}
+
+bool LayerStyleModel::customized() const
+{
+  return isCustomized( currentLayer() );
+}
+
+void LayerStyleModel::save( QgsVectorLayer *layer ) const
+{
+  if ( !layer || !layer->renderer() )
+    return;
+
+  QgsReadWriteContext context;
+  context.setPathResolver( QgsProject::instance()->pathResolver() );
+
+  QDomDocument rendererDoc;
+  rendererDoc.appendChild( layer->renderer()->save( rendererDoc, context ) );
+
+  QSettings settings;
+  const QString key = settingsKey( layer );
+  settings.setValue( key + QStringLiteral( "/renderer" ), rendererDoc.toString( -1 ) );
+  if ( layer->labeling() )
+  {
+    QDomDocument labelingDoc;
+    labelingDoc.appendChild( layer->labeling()->save( labelingDoc, context ) );
+    settings.setValue( key + QStringLiteral( "/labeling" ), labelingDoc.toString( -1 ) );
+  }
+  settings.setValue( key + QStringLiteral( "/labelsEnabled" ), layer->labelsEnabled() );
+  settings.setValue( key + QStringLiteral( "/opacity" ), layer->opacity() );
+}
+
+void LayerStyleModel::resetLayer()
+{
+  QgsVectorLayer *layer = currentLayer();
+  if ( !layer )
+    return;
+
+  QSettings settings;
+  settings.remove( settingsKey( layer ) );
+
+  if ( std::shared_ptr<Original> original = mOriginals.take( layer->id() ) )
+  {
+    if ( original->renderer )
+      layer->setRenderer( original->renderer->clone() );
+    layer->setLabeling( original->labeling ? original->labeling->clone() : nullptr );
+    layer->setLabelsEnabled( original->labelsEnabled );
+    layer->setOpacity( original->opacity );
+  }
+
+  layer->emitStyleChanged();
+  if ( layer->legend() )
+    emit layer->legend()->itemsChanged();
+  layer->triggerRepaint();
+
+  const int row = static_cast<int>( mLayers.indexOf( QPointer<QgsVectorLayer>( layer ) ) );
+  if ( row >= 0 )
+    emit dataChanged( index( row, 0 ), index( row, 0 ), { CustomizedRole, SymbolCountRole } );
+  emit styleChanged();
+}
+
+int LayerStyleModel::applySaved()
+{
+  mOriginals.clear();
+  reload();
+
+  QgsReadWriteContext context;
+  context.setPathResolver( QgsProject::instance()->pathResolver() );
+
+  QSettings settings;
+  int applied = 0;
+  for ( const QPointer<QgsVectorLayer> &layer : std::as_const( mLayers ) )
+  {
+    if ( !layer )
+      continue;
+    const QString key = settingsKey( layer );
+    const QString rendererXml = settings.value( key + QStringLiteral( "/renderer" ) ).toString();
+    if ( rendererXml.isEmpty() )
+      continue;
+
+    QDomDocument rendererDoc;
+    if ( !rendererDoc.setContent( rendererXml ) )
+      continue;
+    QDomElement rendererElement = rendererDoc.documentElement();
+    std::unique_ptr<QgsFeatureRenderer> renderer( QgsFeatureRenderer::load( rendererElement, context ) );
+    if ( !renderer )
+      continue;
+
+    rememberOriginal( layer );
+    layer->setRenderer( renderer.release() );
+
+    const QString labelingXml = settings.value( key + QStringLiteral( "/labeling" ) ).toString();
+    if ( !labelingXml.isEmpty() )
+    {
+      QDomDocument labelingDoc;
+      if ( labelingDoc.setContent( labelingXml ) )
+      {
+        if ( QgsAbstractVectorLayerLabeling *labeling = QgsAbstractVectorLayerLabeling::create( labelingDoc.documentElement(), context ) )
+          layer->setLabeling( labeling );
+      }
+    }
+    layer->setLabelsEnabled( settings.value( key + QStringLiteral( "/labelsEnabled" ), layer->labelsEnabled() ).toBool() );
+    layer->setOpacity( settings.value( key + QStringLiteral( "/opacity" ), layer->opacity() ).toDouble() );
+    layer->triggerRepaint();
+    applied++;
+  }
+
+  if ( applied > 0 )
+  {
+    beginResetModel();
+    endResetModel();
+    emit styleChanged();
+  }
+  return applied;
+}
